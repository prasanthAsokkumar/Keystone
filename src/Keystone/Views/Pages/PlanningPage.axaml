<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Keystone.Localization"
             xmlns:vm="using:Keystone.ViewModels"
             xmlns:controls="using:Keystone.Controls"
             x:Class="Keystone.Views.Pages.PlanningPage"
             x:DataType="vm:MainViewModel">
    <Grid RowDefinitions="Auto,*" RowSpacing="16">
        <Border Classes="segments" HorizontalAlignment="Left" Width="560">
            <Grid ColumnDefinitions="*,*,*,*">
                <RadioButton Classes="segment" GroupName="PlanningTabs" Content="{l:T 'Savings goals'}" IsChecked="{Binding IsGoalsTab}" />
                <RadioButton Grid.Column="1" Classes="segment" GroupName="PlanningTabs" Content="{l:T 'What if'}" IsChecked="{Binding IsScenarioTab}" />
                <RadioButton Grid.Column="2" Classes="segment" GroupName="PlanningTabs" Content="{l:T 'Retirement'}" IsChecked="{Binding IsRetirementGapTab}" />
                <RadioButton Grid.Column="3" Classes="segment" GroupName="PlanningTabs" Content="{l:T 'Net worth'}" IsChecked="{Binding IsNetWorthTab}" />
            </Grid>
        </Border>

        <!-- ═══ Savings goals ═══ -->
        <Border Grid.Row="1" Classes="card" IsVisible="{Binding IsGoalsTab}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,12">
                    <TextBlock Classes="secondary" FontSize="13" Text="{Binding EmergencyFundText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Classes="secondary" Content="{l:T 'Add emergency fund'}" Command="{Binding NewEmergencyFundCommand}" />
                    <Button Grid.Column="2" Classes="primary" Command="{Binding NewGoalCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" />
                            <TextBlock Text="{l:T 'Add goal'}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Border DockPanel.Dock="Bottom" Padding="0,8,0,0" IsVisible="{Binding HasError}">
                    <TextBlock Classes="error" Text="{Binding ErrorMessage}" />
                </Border>
                <Panel>
                    <TextBlock Classes="secondary" IsVisible="{Binding !HasGoalRows}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                               Text="{l:T 'No savings goals yet. Save for a holiday, a car or an emergency fund, and see what to put aside each month.'}" />
                    <ScrollViewer IsVisible="{Binding HasGoalRows}">
                        <ItemsControl ItemsSource="{Binding GoalRows}" Margin="0,0,12,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GoalRow">
                                    <Border Background="{DynamicResource SurfaceSunken}" CornerRadius="10" Padding="16,14">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                                    <TextBlock Classes="muted" FontSize="12" Text="{Binding SourceText}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Classes="icon" ToolTip.Tip="{l:T 'Edit'}"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).EditGoalCommand}"
                                                            CommandParameter="{Binding Goal}">
                                                        <PathIcon Data="{StaticResource IconEdit}" />
                                                    </Button>
                                                    <Button Classes="icon danger" ToolTip.Tip="{l:T 'Delete'}"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteGoalCommand}"
                                                            CommandParameter="{Binding Goal}">
                                                        <PathIcon Data="{StaticResource IconDelete}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Classes="thin" Minimum="0" Maximum="100" Value="{Binding Percent}" />
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Classes="secondary" FontSize="13" Text="{Binding PlanText}" Classes.positive="{Binding IsReached}" />
                                                <Button Grid.Column="1" Classes="link" FontSize="12" Padding="0" IsVisible="{Binding CanPlanTransfer}"
                                                        Content="{l:T 'Add a monthly transfer'}"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PlanGoalTransferCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>
            </DockPanel>
        </Border>

        <!-- ═══ What if ═══ -->
        <Grid Grid.Row="1" ColumnDefinitions="380,*" ColumnSpacing="16" IsVisible="{Binding IsScenarioTab}">
            <Border Classes="card">
                <ScrollViewer>
                    <StackPanel Spacing="14" Margin="0,0,8,0">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="sectionTitle" Text="{l:T 'Try a change'}" />
                            <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                                       Text="{l:T 'Nothing here changes your real entries. The changes are kept until you clear them.'}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="fieldLabel" Text="{l:T 'What changes'}" />
                            <ComboBox ItemsSource="{Binding ScenarioKindNames}" SelectedIndex="{Binding ScenarioKindIndex}" />
                        </StackPanel>
                        <StackPanel Spacing="4" IsVisible="{Binding ScenarioNeedsEntry}">
                            <TextBlock Classes="fieldLabel" Text="{l:T 'Entry'}" />
                            <ComboBox ItemsSource="{Binding ScenarioEntries}" SelectedItem="{Binding ScenarioEntry}"
                                      PlaceholderText="{l:T 'Choose a repeating entry'}" />
                        </StackPanel>
                        <StackPanel Spacing="4" IsVisible="{Binding ScenarioNeedsPercent}">
                            <TextBlock Classes="fieldLabel" Text="{l:T 'New share (%)'}" />
                            <NumericUpDown Value="{Binding ScenarioPercent}" Minimum="0" Maximum="1000" Increment="10" FormatString="0" />
                        </StackPanel>
                        <StackPanel Spacing="10" IsVisible="{Binding ScenarioNeedsAmount}">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'What'}" />
                                <TextBox Text="{Binding ScenarioDescription}" PlaceholderText="{l:T 'e.g. Daycare, new car'}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <NumericUpDown Value="{Binding ScenarioAmount}" Minimum="0" FormatString="N2" PlaceholderText="0.00" ShowButtonSpinner="False" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding ScenarioIsIncome}" Content="{l:T 'Income'}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="fieldLabel" Text="{l:T 'From'}" />
                            <CalendarDatePicker SelectedDate="{Binding ScenarioFrom}" />
                        </StackPanel>
                        <Button Classes="primary" HorizontalAlignment="Stretch" Content="{l:T 'Add change'}" Command="{Binding AddScenarioChangeCommand}" />
                        <TextBlock Classes="error" Text="{Binding ScenarioError}" IsVisible="{Binding HasScenarioError}" />

                        <StackPanel Spacing="6" IsVisible="{Binding HasScenarioChanges}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Changes'}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="link" FontSize="12" Padding="0" Content="{l:T 'Clear all'}"
                                        Command="{Binding ClearScenarioCommand}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ScenarioChangeRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScenarioChangeRow">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                            <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{l:T 'Remove'}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveScenarioChangeCommand}"
                                                    CommandParameter="{Binding}">
                                                <PathIcon Data="{StaticResource IconClose}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="16">
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,140,140" ColumnSpacing="12">
                            <TextBlock Classes="columnHeader" Text="" />
                            <TextBlock Grid.Column="1" Classes="columnHeader" Text="{l:T 'Now'}" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Classes="columnHeader" Text="{l:T 'With the changes'}" TextAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ScenarioComparison}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScenarioCompareRow">
                                    <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="0,8">
                                        <Grid ColumnDefinitions="*,140,140" ColumnSpacing="12">
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Now}" TextAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{Binding WithChanges}" TextAlignment="Right" FontWeight="Bold"
                                                       IsVisible="{Binding IsDifferent}" />
                                            <TextBlock Grid.Column="2" Text="{Binding WithChanges}" TextAlignment="Right"
                                                       IsVisible="{Binding !IsDifferent}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Classes="card" Padding="20,18">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="0,0,0,8">
                            <TextBlock Classes="sectionTitle" Text="{l:T 'Cash over time'}" />
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#F59E0B" />
                                <TextBlock Classes="muted" FontSize="12" Text="{l:T 'Now'}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#8B5CF6" />
                                <TextBlock Classes="muted" FontSize="12" Text="{l:T 'With the changes'}" />
                            </StackPanel>
                        </StackPanel>
                        <controls:RunwayChart History="{Binding Summary.History}" Projection="{Binding Summary.Projection}"
                                              Comparison="{Binding ScenarioSummary.Projection}" Foreground="{DynamicResource TextMuted}" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ Retirement gap ═══ -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding IsRetirementGapTab}">
            <StackPanel Spacing="16" Margin="0,0,14,0">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                    <Border Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Needed in retirement'}" />
                            <TextBlock Classes="value" Text="{Binding RetirementNeedText}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumericUpDown Value="{Binding RetirementNeedPercent}" Minimum="10" Maximum="150" Increment="5" FormatString="0"
                                               Width="110" MinHeight="30" />
                                <TextBlock Classes="muted" FontSize="12" Text="{l:T '% of today’s living costs'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Expected income'}" />
                            <TextBlock Classes="value" Text="{Binding RetirementIncomeText}" />
                            <TextBlock Classes="muted" FontSize="13" Text="{Binding RetirementIncomeDetail}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Gap'}" />
                            <TextBlock Classes="value" Text="{Binding RetirementGapText}" Classes.negative="{Binding HasRetirementGap}"
                                       Classes.positive="{Binding !HasRetirementGap}" />
                            <ProgressBar Classes="thin" Minimum="0" Maximum="100" Value="{Binding RetirementCoveredPercent}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding !HasRetirementData}"
                           Text="{l:T 'Add your pension letters on the Retirement page to see what you can expect.'}" />

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="sectionTitle" Text="{l:T 'Year of birth'}" />
                        <ItemsControl ItemsSource="{Binding BirthYearRows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="24" LineSpacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BirthYearRow">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" MinWidth="70" />
                                        <NumericUpDown Value="{Binding Year}" Minimum="1920" Maximum="2030" FormatString="0" Width="120"
                                                       PlaceholderText="1985" ShowButtonSpinner="False" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding RetirementPeople}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RetirementPersonRow">
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="24">
                                        <StackPanel>
                                            <TextBlock Classes="sectionTitle" Text="{Binding Name}" />
                                            <TextBlock Classes="muted" FontSize="13" Text="{Binding RetirementText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Classes="label" Text="{l:T 'Pensions'}" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding PensionText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Classes="label" Text="{l:T 'Savings at 65'}" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding CapitalText}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="4" IsVisible="{Binding HasWithdrawals}">
                                        <TextBlock Classes="fieldLabel" Text="{l:T 'Taking out pillar 3a'}" />
                                        <ItemsControl ItemsSource="{Binding WithdrawalLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Classes="secondary" FontSize="13" Text="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding WithdrawalHint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="{l:T 'Savings are spread over 20 years from 65, without interest or inflation. A guide, not financial advice.'}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ Net worth ═══ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,340" ColumnSpacing="16" IsVisible="{Binding IsNetWorthTab}">
            <Border Classes="card" Padding="20,18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10">
                        <TextBlock Classes="label" Text="{l:T 'Net worth'}" />
                        <TextBlock Classes="value" Text="{Binding NetWorthTodayText}" />
                        <TextBlock FontSize="13" Text="{Binding NetWorthChangeText}" Classes="positive" Classes.negative="{Binding IsNetWorthDown}" />
                    </StackPanel>
                    <controls:RunwayChart History="{Binding NetWorthHistory}" Foreground="{DynamicResource TextMuted}" />
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
                <StackPanel Spacing="4">
                    <TextBlock Classes="sectionTitle" Text="{l:T 'Made up of'}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding NetWorthParts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TaxLine">
                                <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="Medium" />
                                            <TextBlock Classes="muted" FontSize="12" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding AmountText}" FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="{l:T 'Retirement savings count as of each account’s latest letter. Property and investments aren’t included.'}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

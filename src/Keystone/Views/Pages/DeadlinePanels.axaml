<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Keystone.Localization"
             xmlns:vm="using:Keystone.ViewModels"
             x:Class="Keystone.Views.Pages.DeadlinePanels"
             x:DataType="vm:MainViewModel">
    <!-- The side forms for a contract, an important date and a warranty. -->
    <Panel>
        <!-- Contract -->
        <Border Classes="panel" Width="460" HorizontalAlignment="Right" IsVisible="{Binding Deadlines.IsContractPanelOpen}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="28,24,20,8">
                    <TextBlock Text="{Binding Deadlines.ContractFormTitle}" FontSize="20" FontWeight="Bold" />
                    <Button Grid.Column="1" Classes="icon" Command="{Binding ClosePanelCommand}" ToolTip.Tip="{l:T 'Close (Esc)'}">
                        <PathIcon Data="{StaticResource IconClose}" />
                    </Button>
                </Grid>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="28,16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Button Classes="primary" Content="{l:T 'Save'}" HorizontalAlignment="Stretch" Command="{Binding Deadlines.SaveContractCommand}" />
                        <Button Grid.Column="1" Classes="secondary" Content="{l:T 'Cancel'}" Command="{Binding ClosePanelCommand}" />
                    </Grid>
                </Border>
                <ScrollViewer>
                    <StackPanel Spacing="18" Margin="28,12,28,20">
                        <Border Background="{DynamicResource BrandSoft}" CornerRadius="10" Padding="14,10" IsVisible="{Binding HasFollowUpHint}">
                            <TextBlock Text="{Binding FollowUpHint}" TextWrapping="Wrap" FontSize="13" />
                        </Border>
                        <Grid ColumnDefinitions="3*,2*" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Provider'}" />
                                <TextBox Text="{Binding Deadlines.ContractProvider}" PlaceholderText="{l:T 'e.g. Swisscom, Fitnesspark'}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Person'}" />
                                <ComboBox ItemsSource="{Binding PersonOptions}" SelectedItem="{Binding Deadlines.ContractPerson}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="3*,2*" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Type'}" />
                                <ComboBox ItemsSource="{Binding Deadlines.ContractKindNames}" SelectedIndex="{Binding Deadlines.ContractKindIndex}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Cost'}" />
                                <NumericUpDown Value="{Binding Deadlines.ContractCost}" Minimum="0" FormatString="N2" PlaceholderText="0.00" ShowButtonSpinner="False" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Paid'}" />
                                <ComboBox ItemsSource="{Binding PremiumRecurrenceNames}" SelectedIndex="{Binding Deadlines.ContractRecurrenceIndex}" />
                            </StackPanel>
                        </Grid>
                        <Border Background="{DynamicResource SurfaceSunken}" CornerRadius="10" Padding="14">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="{l:T 'Minimum term ends on'}" />
                                        <CalendarDatePicker SelectedDate="{Binding Deadlines.ContractEnd}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="{l:T 'Notice period (months)'}" />
                                        <NumericUpDown Value="{Binding Deadlines.ContractNoticeMonths}" Minimum="0" Maximum="24" Increment="1" FormatString="0" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox IsChecked="{Binding Deadlines.ContractRenews}" Content="{l:T 'Renews every year unless cancelled'}" />
                                <TextBlock Classes="secondary" FontSize="13" Text="{Binding Deadlines.ContractCancelByText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Expander Header="{l:T 'More details'}" IsExpanded="{Binding Deadlines.ContractMoreOpen}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="18">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{l:T 'Customer number (optional)'}" />
                                    <TextBox Text="{Binding Deadlines.ContractCustomerNumber}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{l:T 'Contract document'}" />
                                    <ComboBox ItemsSource="{Binding Deadlines.ContractDocumentOptions}" SelectedItem="{Binding Deadlines.ContractDocument}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DocumentOption">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="muted" FontSize="12" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{l:T 'Notes'}" />
                                    <TextBox Text="{Binding Deadlines.ContractNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                        <CheckBox IsChecked="{Binding Deadlines.ContractAddToExpenses}" IsVisible="{Binding Deadlines.EditingContract, Converter={x:Static ObjectConverters.IsNull}}"
                                  Content="{l:T 'Add the cost to expenses from next month, so your runway includes it'}" />
                        <TextBlock Classes="error" Text="{Binding Deadlines.ContractError}" IsVisible="{Binding Deadlines.HasContractError}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Important date -->
        <Border Classes="panel" Width="440" HorizontalAlignment="Right" IsVisible="{Binding Deadlines.IsImportantDatePanelOpen}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="28,24,20,8">
                    <TextBlock Text="{Binding Deadlines.ImportantDateFormTitle}" FontSize="20" FontWeight="Bold" />
                    <Button Grid.Column="1" Classes="icon" Command="{Binding ClosePanelCommand}" ToolTip.Tip="{l:T 'Close (Esc)'}">
                        <PathIcon Data="{StaticResource IconClose}" />
                    </Button>
                </Grid>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="28,16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Button Classes="primary" Content="{l:T 'Save'}" HorizontalAlignment="Stretch" Command="{Binding Deadlines.SaveImportantDateCommand}" />
                        <Button Grid.Column="1" Classes="secondary" Content="{l:T 'Cancel'}" Command="{Binding ClosePanelCommand}" />
                    </Grid>
                </Border>
                <ScrollViewer>
                    <StackPanel Spacing="18" Margin="28,12,28,20">
                        <Border Background="{DynamicResource BrandSoft}" CornerRadius="10" Padding="14,10" IsVisible="{Binding HasFollowUpHint}">
                            <TextBlock Text="{Binding FollowUpHint}" TextWrapping="Wrap" FontSize="13" />
                        </Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Type'}" />
                                <ComboBox ItemsSource="{Binding Deadlines.ImportantDateKindNames}" SelectedIndex="{Binding Deadlines.ImportantDateKindIndex}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Person'}" />
                                <ComboBox ItemsSource="{Binding PersonOptions}" SelectedItem="{Binding Deadlines.ImportantDatePerson}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="fieldLabel" Text="{l:T 'What'}" />
                            <TextBox Text="{Binding Deadlines.ImportantDateTitle}" PlaceholderText="{l:T 'e.g. Passport Anna'}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Date (expires or due)'}" />
                                <CalendarDatePicker SelectedDate="{Binding Deadlines.ImportantDateDate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Repeats'}" />
                                <ComboBox ItemsSource="{Binding Deadlines.RepeatMonthNames}" SelectedIndex="{Binding Deadlines.ImportantDateRepeatIndex}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="fieldLabel" Text="{l:T 'Remind me this many days before'}" />
                            <NumericUpDown Value="{Binding Deadlines.ImportantDateRemindDays}" Minimum="0" Maximum="365" Increment="7" FormatString="0" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="fieldLabel" Text="{l:T 'Notes'}" />
                            <TextBox Text="{Binding Deadlines.ImportantDateNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                        </StackPanel>
                        <TextBlock Classes="error" Text="{Binding Deadlines.ImportantDateError}" IsVisible="{Binding Deadlines.HasImportantDateError}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Warranty -->
        <Border Classes="panel" Width="440" HorizontalAlignment="Right" IsVisible="{Binding Deadlines.IsWarrantyPanelOpen}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="28,24,20,8">
                    <TextBlock Text="{Binding Deadlines.WarrantyFormTitle}" FontSize="20" FontWeight="Bold" />
                    <Button Grid.Column="1" Classes="icon" Command="{Binding ClosePanelCommand}" ToolTip.Tip="{l:T 'Close (Esc)'}">
                        <PathIcon Data="{StaticResource IconClose}" />
                    </Button>
                </Grid>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="28,16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Button Classes="primary" Content="{l:T 'Save'}" HorizontalAlignment="Stretch" Command="{Binding Deadlines.SaveWarrantyCommand}" />
                        <Button Grid.Column="1" Classes="secondary" Content="{l:T 'Cancel'}" Command="{Binding ClosePanelCommand}" />
                    </Grid>
                </Border>
                <ScrollViewer>
                    <StackPanel Spacing="18" Margin="28,12,28,20">
                        <Border Background="{DynamicResource BrandSoft}" CornerRadius="10" Padding="14,10" IsVisible="{Binding HasFollowUpHint}">
                            <TextBlock Text="{Binding FollowUpHint}" TextWrapping="Wrap" FontSize="13" />
                        </Border>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="fieldLabel" Text="{l:T 'What you bought'}" />
                            <TextBox Text="{Binding Deadlines.WarrantyItem}" PlaceholderText="{l:T 'e.g. Washing machine V-ZUG'}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="3*,2*" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Shop'}" />
                                <TextBox Text="{Binding Deadlines.WarrantyStore}" PlaceholderText="{l:T 'e.g. Fust, Digitec'}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Person'}" />
                                <ComboBox ItemsSource="{Binding PersonOptions}" SelectedItem="{Binding Deadlines.WarrantyPerson}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Bought on'}" />
                                <CalendarDatePicker SelectedDate="{Binding Deadlines.WarrantyPurchaseDate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Price'}" />
                                <NumericUpDown Value="{Binding Deadlines.WarrantyPrice}" Minimum="0" FormatString="N2" PlaceholderText="0.00" ShowButtonSpinner="False" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Months'}" />
                                <NumericUpDown Value="{Binding Deadlines.WarrantyMonths}" Minimum="1" Maximum="240" Increment="12" FormatString="0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="secondary" FontSize="13" Text="{Binding Deadlines.WarrantyEndText}" />
                        <StackPanel Spacing="4">
                            <TextBlock Classes="fieldLabel" Text="{l:T 'Receipt'}" />
                            <ComboBox ItemsSource="{Binding Deadlines.WarrantyDocumentOptions}" SelectedItem="{Binding Deadlines.WarrantyDocument}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DocumentOption">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="muted" FontSize="12" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="fieldLabel" Text="{l:T 'Notes'}" />
                            <TextBox Text="{Binding Deadlines.WarrantyNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                     PlaceholderText="{l:T 'e.g. serial number, extended warranty'}" />
                        </StackPanel>
                        <TextBlock Classes="error" Text="{Binding Deadlines.WarrantyError}" IsVisible="{Binding Deadlines.HasWarrantyError}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Panel>
</UserControl>

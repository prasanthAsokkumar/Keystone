<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Keystone.Localization"
             xmlns:vm="using:Keystone.ViewModels"
             xmlns:controls="using:Keystone.Controls"
             x:Class="Keystone.Views.Pages.ContractsPage"
             x:DataType="vm:MainViewModel">
    <!-- Contracts, important dates and warranties: everything with a deadline. -->
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <Border Classes="segments" HorizontalAlignment="Left" Width="480">
            <Grid ColumnDefinitions="*,*,*">
                <RadioButton Classes="segment" GroupName="DeadlineTabs" Content="{l:T 'Contracts'}" IsChecked="{Binding IsContractsTab}" />
                <RadioButton Grid.Column="1" Classes="segment" GroupName="DeadlineTabs" Content="{l:T 'Important dates'}"
                             IsChecked="{Binding IsDatesTab}" />
                <RadioButton Grid.Column="2" Classes="segment" GroupName="DeadlineTabs" Content="{l:T 'Warranties'}"
                             IsChecked="{Binding IsWarrantiesTab}" />
            </Grid>
        </Border>

        <!-- Summary -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16" IsVisible="{Binding IsContractsTab}">
            <Border Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="{l:T 'Contracts per year'}" />
                    <TextBlock Classes="value" Text="{Binding ContractCostText}" />
                    <TextBlock Classes="muted" FontSize="13" Text="{Binding ContractCostDetail}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="{l:T 'Notice deadlines, contracts and insurance'}" />
                    <TextBlock Classes="value" Text="{Binding ContractDeadlineText}" Classes.warning="{Binding IsContractDeadlineSoon}"
                               IsVisible="{Binding !HasAllDeadlineRows}" />
                    <TextBlock Classes="muted" FontSize="13" Text="{Binding ContractDeadlineDetail}" TextWrapping="Wrap"
                               IsVisible="{Binding !HasAllDeadlineRows}" />
                    <ItemsControl ItemsSource="{Binding TopDeadlineRows}" IsVisible="{Binding HasAllDeadlineRows}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NoticeDeadlineRow">
                                <Button Classes="searchResult" HorizontalAlignment="Stretch" Margin="-8,0"
                                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenNoticeDeadlineCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="96,*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                                   Classes.warning="{Binding IsSoon}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="muted" FontSize="12" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Classes="pill" Classes.brand="{Binding IsInsurance}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourceText}" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16" IsVisible="{Binding IsDatesTab}">
            <Border Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="{l:T 'Next date'}" />
                    <TextBlock Classes="value" Text="{Binding NextImportantDateText}" />
                    <TextBlock Classes="muted" FontSize="13" Text="{Binding NextImportantDateDetail}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="{l:T 'Good to keep track of'}" />
                    <TextBlock Classes="secondary" FontSize="13" TextWrapping="Wrap"
                               Text="{l:T 'Passports and ID cards (renewing takes weeks), the driving licence, the car inspection (MFK), tyre changes and the motorway vignette, due every year by 31 January.'}" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16" IsVisible="{Binding IsWarrantiesTab}">
            <Border Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="{l:T 'Under warranty'}" />
                    <TextBlock Classes="value" Text="{Binding WarrantySummaryText}" />
                    <TextBlock Classes="muted" FontSize="13" Text="{Binding WarrantySummaryDetail}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="{l:T 'Warranty in Switzerland'}" />
                    <TextBlock Classes="secondary" FontSize="13" TextWrapping="Wrap"
                               Text="{l:T 'New goods have 2 years of warranty by law, unless the shop’s terms say otherwise. Keep the receipt: link it from Documents.'}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Lists -->
        <Border Grid.Row="2" Classes="card" Padding="8">
            <Panel>
                <!-- Contracts -->
                <Panel IsVisible="{Binding IsContractsTab}">
                    <TextBlock Classes="secondary" IsVisible="{Binding !HasContractRows}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                               Text="{l:T 'No contracts yet. Add your mobile, internet, gym or leasing contracts to see what they cost and when to cancel.'}" />
                    <StackPanel Orientation="Horizontal" Spacing="18" Margin="28,4,28,2" IsVisible="{Binding HasContractRows}" VerticalAlignment="Top">
                        <TextBlock Classes="columnHeader" Text="{l:T 'Sort by'}" Opacity="0.7" VerticalAlignment="Center" />
                        <controls:SortHeader Label="{l:T 'Provider'}" List="contracts" Key="provider" Sorts="{Binding ListSorts}" />
                        <controls:SortHeader Label="{l:T 'Person'}" List="contracts" Key="person" Sorts="{Binding ListSorts}" />
                        <controls:SortHeader Label="{l:T 'Cost per year'}" List="contracts" Key="cost" Sorts="{Binding ListSorts}" />
                        <controls:SortHeader Label="{l:T 'Cancel by'}" List="contracts" Key="deadline" Sorts="{Binding ListSorts}" />
                    </StackPanel>
                    <ListBox Classes="table" ItemsSource="{Binding ContractRows}" IsVisible="{Binding HasContractRows}" Margin="12,34,12,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContractRow">
                                <Grid ColumnDefinitions="*,130,150,190,106" ColumnSpacing="16" Background="Transparent" controls:Drag.Item="{Binding}" controls:Drag.Target="reorder:contracts" controls:Drag.TargetItem="{Binding}"
                                      Opacity="{Binding HasEnded, Converter={x:Static vm:Format.EndedOpacityConverter}}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Provider}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="muted" FontSize="13" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="pill" Classes.brand="{Binding !IsShared}">
                                        <TextBlock Text="{Binding PersonName}" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CostText}" FontWeight="SemiBold" TextAlignment="Right" />
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding YearlyText}" TextAlignment="Right"
                                                   IsVisible="{Binding HasYearly}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Classes="secondary" FontSize="13" Text="{Binding TermText}" TextAlignment="Right"
                                                   TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" Text="{Binding CancelByText}" TextAlignment="Right" IsVisible="{Binding HasCancelBy}"
                                                   Classes="muted" Classes.negative="{Binding IsDeadlineUrgent}" Classes.warning="{Binding IsDeadlineSoon}" />
                                    </StackPanel>
                                    <Grid Grid.Column="4" ColumnDefinitions="34,34,34" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Classes="icon" ToolTip.Tip="{l:T 'Open'}" IsVisible="{Binding HasDocument}"
                                                Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).OpenLinkedDocumentCommand}"
                                                CommandParameter="{Binding Document}">
                                            <PathIcon Data="{StaticResource IconOpen}" />
                                        </Button>
                                        <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{l:T 'Edit'}"
                                                Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).EditContractCommand}"
                                                CommandParameter="{Binding Contract}">
                                            <PathIcon Data="{StaticResource IconEdit}" />
                                        </Button>
                                        <Button Grid.Column="2" Classes="icon danger" ToolTip.Tip="{l:T 'Delete'}"
                                                Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).DeleteContractCommand}"
                                                CommandParameter="{Binding Contract}">
                                            <PathIcon Data="{StaticResource IconDelete}" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Panel>

                <!-- Important dates -->
                <Panel IsVisible="{Binding IsDatesTab}">
                    <TextBlock Classes="secondary" IsVisible="{Binding !HasImportantDateRows}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                               Text="{l:T 'No dates yet. Add when passports and ID cards expire, the car inspection or the vignette.'}" />
                    <StackPanel Orientation="Horizontal" Spacing="18" Margin="28,4,28,2" IsVisible="{Binding HasImportantDateRows}" VerticalAlignment="Top">
                        <TextBlock Classes="columnHeader" Text="{l:T 'Sort by'}" Opacity="0.7" VerticalAlignment="Center" />
                        <controls:SortHeader Label="{l:T 'Title'}" List="dates" Key="title" Sorts="{Binding ListSorts}" />
                        <controls:SortHeader Label="{l:T 'Person'}" List="dates" Key="person" Sorts="{Binding ListSorts}" />
                        <controls:SortHeader Label="{l:T 'Date'}" List="dates" Key="date" Sorts="{Binding ListSorts}" />
                    </StackPanel>
                    <ListBox Classes="table" ItemsSource="{Binding ImportantDateRows}" IsVisible="{Binding HasImportantDateRows}" Margin="12,34,12,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImportantDateRow">
                                <Grid ColumnDefinitions="*,130,190,72" ColumnSpacing="16" Background="Transparent"
                                      Opacity="{Binding HasPassed, Converter={x:Static vm:Format.EndedOpacityConverter}}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="muted" FontSize="13" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="pill" Classes.brand="{Binding !IsShared}">
                                        <TextBlock Text="{Binding PersonName}" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" TextAlignment="Right" />
                                        <TextBlock FontSize="12" Text="{Binding WhenText}" TextAlignment="Right" Classes="muted"
                                                   Classes.warning="{Binding IsSoon}" />
                                    </StackPanel>
                                    <Grid Grid.Column="3" ColumnDefinitions="34,34" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Classes="icon" ToolTip.Tip="{l:T 'Edit'}"
                                                Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).EditImportantDateCommand}"
                                                CommandParameter="{Binding Date}">
                                            <PathIcon Data="{StaticResource IconEdit}" />
                                        </Button>
                                        <Button Grid.Column="1" Classes="icon danger" ToolTip.Tip="{l:T 'Delete'}"
                                                Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).DeleteImportantDateCommand}"
                                                CommandParameter="{Binding Date}">
                                            <PathIcon Data="{StaticResource IconDelete}" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Panel>

                <!-- Warranties -->
                <Panel IsVisible="{Binding IsWarrantiesTab}">
                    <TextBlock Classes="secondary" IsVisible="{Binding !HasWarrantyRows}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                               Text="{l:T 'No warranties yet. Add bigger purchases with their receipt, so you know until when they’re covered.'}" />
                    <StackPanel Orientation="Horizontal" Spacing="18" Margin="28,4,28,2" IsVisible="{Binding HasWarrantyRows}" VerticalAlignment="Top">
                        <TextBlock Classes="columnHeader" Text="{l:T 'Sort by'}" Opacity="0.7" VerticalAlignment="Center" />
                        <controls:SortHeader Label="{l:T 'Item'}" List="warranties" Key="item" Sorts="{Binding ListSorts}" />
                        <controls:SortHeader Label="{l:T 'Person'}" List="warranties" Key="person" Sorts="{Binding ListSorts}" />
                        <controls:SortHeader Label="{l:T 'Price'}" List="warranties" Key="price" Sorts="{Binding ListSorts}" />
                        <controls:SortHeader Label="{l:T 'Ends'}" List="warranties" Key="expires" Sorts="{Binding ListSorts}" />
                    </StackPanel>
                    <ListBox Classes="table" ItemsSource="{Binding WarrantyRows}" IsVisible="{Binding HasWarrantyRows}" Margin="12,34,12,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:WarrantyRow">
                                <Grid ColumnDefinitions="*,130,170,106" ColumnSpacing="16" Background="Transparent"
                                      Opacity="{Binding HasExpired, Converter={x:Static vm:Format.EndedOpacityConverter}}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Item}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="muted" FontSize="13" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="pill" Classes.brand="{Binding !IsShared}">
                                        <TextBlock Text="{Binding PersonName}" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding EndText}" FontWeight="Medium" TextAlignment="Right"
                                               VerticalAlignment="Center" Classes.warning="{Binding IsEndingSoon}" />
                                    <Grid Grid.Column="3" ColumnDefinitions="34,34,34" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Classes="icon" ToolTip.Tip="{l:T 'Open receipt'}" IsVisible="{Binding HasDocument}"
                                                Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).OpenLinkedDocumentCommand}"
                                                CommandParameter="{Binding Document}">
                                            <PathIcon Data="{StaticResource IconOpen}" />
                                        </Button>
                                        <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{l:T 'Edit'}"
                                                Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).EditWarrantyCommand}"
                                                CommandParameter="{Binding Warranty}">
                                            <PathIcon Data="{StaticResource IconEdit}" />
                                        </Button>
                                        <Button Grid.Column="2" Classes="icon danger" ToolTip.Tip="{l:T 'Delete'}"
                                                Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).DeleteWarrantyCommand}"
                                                CommandParameter="{Binding Warranty}">
                                            <PathIcon Data="{StaticResource IconDelete}" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Panel>
            </Panel>
        </Border>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Keystone.Localization"
             xmlns:vm="using:Keystone.ViewModels"
             xmlns:controls="using:Keystone.Controls"
             x:Class="Keystone.Views.Pages.TaxesPage"
             x:DataType="vm:MainViewModel">
    <!-- A tax year's figures and the papers to collect for the return. -->
    <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
        <ScrollViewer>
            <StackPanel Spacing="16" Margin="0,0,16,0">
                <Grid ColumnDefinitions="*,160" ColumnSpacing="12">
                    <TextBlock Classes="secondary" Text="{Binding TaxPageNote}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding PersonFilters}" SelectedItem="{Binding TaxPersonFilter}" />
                </Grid>

        <Border Classes="card" Padding="8" IsVisible="{Binding HasTaxBillRows}">
            <StackPanel Spacing="4">
                <StackPanel Spacing="2" Margin="16,12,12,4">
                    <TextBlock Classes="sectionTitle" Text="{l:T 'Bills to pay'}" />
                    <TextBlock Classes="muted" FontSize="13" Text="{Binding TaxBillsText}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding TaxBillRows}" Margin="12,0,12,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DocumentRow">
                            <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="16,8">
                                <Grid ColumnDefinitions="*,170,106" ColumnSpacing="16" Background="Transparent" controls:Drag.Item="{Binding}">
                                    <StackPanel VerticalAlignment="Center" ToolTip.Tip="{Binding Title}">
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding PersonName}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding InstalmentTip}">
                                        <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" TextAlignment="Right" />
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding StatusText}" TextAlignment="Right"
                                                   Classes.negative="{Binding IsOverdue}" />
                                    </StackPanel>
                                    <Grid Grid.Column="2" ColumnDefinitions="34,34,34" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Classes="icon" ToolTip.Tip="{l:T 'Open'}" IsEnabled="{Binding !IsMissing}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenDocumentCommand}"
                                                CommandParameter="{Binding Document}">
                                            <PathIcon Data="{StaticResource IconOpen}" />
                                        </Button>
                                        <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{Binding MarkPaidTip}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).MarkDocumentPaidCommand}"
                                                CommandParameter="{Binding Document}">
                                            <PathIcon Data="{StaticResource IconCheck}" />
                                        </Button>
                                        <Button Grid.Column="2" Classes="icon" ToolTip.Tip="{l:T 'Edit'}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).EditDocumentCommand}"
                                                CommandParameter="{Binding Document}">
                                            <PathIcon Data="{StaticResource IconEdit}" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

                <ItemsControl ItemsSource="{Binding TaxSections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaxSection">
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="sectionTitle" Text="{Binding Title}" />
                                    <TextBlock Classes="muted" FontSize="13" Text="{Binding Empty}" TextWrapping="Wrap"
                                               IsVisible="{Binding IsEmpty}" />
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TaxLine">
                                                <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1" Padding="0,10">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding Label}" FontWeight="Medium" />
                                                            <TextBlock Classes="muted" FontSize="12" Text="{Binding Detail}" TextWrapping="Wrap"
                                                                       IsVisible="{Binding HasDetail}" />
                                                            <TextBlock Classes="secondary" FontSize="12" Text="{Binding Note}" TextWrapping="Wrap"
                                                                       IsVisible="{Binding HasNote}" Classes.warning="{Binding IsWarning}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding AmountText}" FontWeight="SemiBold"
                                                                   VerticalAlignment="Top" TextAlignment="Right" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasTotal}" Margin="0,2,0,0">
                                        <TextBlock Classes="label" Text="{l:T 'Total'}" />
                                        <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontWeight="Bold" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


                <Border Classes="card" Padding="8">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" Margin="16,12,12,4">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="sectionTitle" Text="{l:T 'Tax payments'}" />
                                <TextBlock Classes="muted" FontSize="13" Text="{Binding TaxEntriesTotal}" IsVisible="{Binding HasTaxEntryRows}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary" Command="{Binding NewTaxEntryCommand}" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconPlus}" />
                                    <TextBlock Text="{l:T 'Add tax payment'}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Classes="muted" FontSize="13" Margin="16,4,16,12" TextWrapping="Wrap" IsVisible="{Binding !HasTaxEntryRows}"
                                   Text="{l:T 'No tax payments yet. Add your provisional instalments or the final bill, so your runway includes them.'}" />
                        <Grid ColumnDefinitions="*,140,108" ColumnSpacing="12" Margin="28,4,28,6" IsVisible="{Binding HasTaxEntryRows}">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <controls:SortHeader Label="{l:T 'Description'}" List="taxPayments" Key="description" Sorts="{Binding ListSorts}" />
                                <controls:SortHeader Label="{l:T 'Date'}" List="taxPayments" Key="date" Sorts="{Binding ListSorts}" />
                            </StackPanel>
                            <controls:SortHeader Grid.Column="1" Label="{l:T 'Amount'}" List="taxPayments" Key="amount" Sorts="{Binding ListSorts}" HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TaxEntryRows}" Margin="12,0,12,8" IsVisible="{Binding HasTaxEntryRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EntryRow">
                                    <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="16,8">
                                        <Grid ColumnDefinitions="*,140,108" ColumnSpacing="12" Background="Transparent" controls:Drag.Item="{Binding}">
                                            <StackPanel VerticalAlignment="Center" ToolTip.Tip="{Binding Description}">
                                                <TextBlock Text="{Binding Description}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="muted" FontSize="12" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Classes="muted" FontSize="12" Text="{Binding DateText}" />
                                                    <TextBlock Classes="muted" FontSize="12" Text="·" />
                                                    <TextBlock Classes="muted" FontSize="12" Text="{Binding PersonName}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding AmountText}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                                            <Grid Grid.Column="2" ColumnDefinitions="34,34,34" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Classes="icon" ToolTip.Tip="{l:T 'Edit'}"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).EditTransactionCommand}"
                                                        CommandParameter="{Binding Transaction}">
                                                    <PathIcon Data="{StaticResource IconEdit}" />
                                                </Button>
                                                <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{l:T 'Stop repeating from today'}" IsVisible="{Binding CanStop}"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).StopTransactionCommand}"
                                                        CommandParameter="{Binding Transaction}">
                                                    <PathIcon Data="{StaticResource IconStop}" />
                                                </Button>
                                                <Button Grid.Column="2" Classes="icon danger" ToolTip.Tip="{l:T 'Delete (removes every repeat)'}"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteTransactionCommand}"
                                                        CommandParameter="{Binding Transaction}">
                                                    <PathIcon Data="{StaticResource IconDelete}" />
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Classes="card" Padding="8">
                    <StackPanel Spacing="4">
                        <StackPanel Spacing="2" Margin="16,12,12,4">
                            <TextBlock Classes="sectionTitle" Text="{l:T 'Tax papers'}" />
                            <TextBlock Classes="muted" FontSize="12" Text="{l:T 'The latest; all of them are under Documents.'}" IsVisible="{Binding HasTaxDocumentRows}" />
                        </StackPanel>
                        <TextBlock Classes="muted" FontSize="13" Margin="16,4,16,12" TextWrapping="Wrap" IsVisible="{Binding !HasTaxDocumentRows}"
                                   Text="{l:T 'No tax papers yet. Tax returns, assessments and bills from the tax office appear here once filed under Documents.'}" />
                        <ItemsControl ItemsSource="{Binding RecentTaxDocumentRows}" Margin="12,0,12,0" IsVisible="{Binding HasTaxDocumentRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DocumentRow">
                                    <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="16,8">
                                        <Grid ColumnDefinitions="*,140,72" ColumnSpacing="12" Background="Transparent" controls:Drag.Item="{Binding}">
                                            <StackPanel VerticalAlignment="Center" ToolTip.Tip="{Binding Title}">
                                                <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="muted" FontSize="12" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Classes="muted" FontSize="12" Text="{Binding DateText}" />
                                                    <TextBlock Classes="muted" FontSize="12" Text="·" />
                                                    <TextBlock Classes="muted" FontSize="12" Text="{Binding PersonName}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" TextAlignment="Right" IsVisible="{Binding HasAmount}" />
                                                <TextBlock Classes="muted" FontSize="12" Text="{Binding StatusText}" TextAlignment="Right"
                                                           IsVisible="{Binding HasStatus}" Classes.negative="{Binding IsOverdue}" />
                                            </StackPanel>
                                            <Grid Grid.Column="2" ColumnDefinitions="34,34" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Classes="icon" ToolTip.Tip="{l:T 'Open'}" IsEnabled="{Binding !IsMissing}"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenDocumentCommand}"
                                                        CommandParameter="{Binding Document}">
                                                    <PathIcon Data="{StaticResource IconOpen}" />
                                                </Button>
                                                <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{l:T 'Edit'}"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).EditDocumentCommand}"
                                                        CommandParameter="{Binding Document}">
                                                    <PathIcon Data="{StaticResource IconEdit}" />
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="link" Margin="28,4,16,12" IsVisible="{Binding HasTaxDocumentRows}"
                                Command="{Binding ShowPapersCommand}" CommandParameter="taxes" Content="{Binding TaxPapersLinkText}" />
                    </StackPanel>
                </Border>

                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="{l:T 'A guide, not tax advice. Your letters and your canton’s rules count.'}" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="16" VerticalAlignment="Top">
            <!-- A rough estimate of the year's tax, from the household's own rate, against the instalments paid -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="sectionTitle" Text="{l:T 'Tax estimate'}" />
                    <TextBlock Classes="value" Text="{Binding TaxEstimateText}" IsVisible="{Binding HasTaxEstimate}" />
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding TaxEstimateDetail}" TextWrapping="Wrap" />
                    <TextBlock Classes="secondary" FontSize="13" Text="{Binding TaxPaidText}" TextWrapping="Wrap" />
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding TaxBalanceText}" TextWrapping="Wrap"
                               IsVisible="{Binding HasTaxBalance}" Classes.warning="{Binding TaxBalanceIsOwed}"
                               Classes.positive="{Binding !TaxBalanceIsOwed}" />
                    <Border Background="{DynamicResource SurfaceSunken}" CornerRadius="10" Padding="12" Margin="0,4,0,0">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{Binding TaxReferenceLabel}" />
                                <NumericUpDown Value="{Binding TaxReferenceAmount}" Minimum="0" FormatString="N0" PlaceholderText="0"
                                               ShowButtonSpinner="False" />
                                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                           Text="{l:T 'From the assessment or final bill: canton, commune, church and federal tax together.'}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Or a rate by hand (%)'}" />
                                <NumericUpDown Value="{Binding TaxRateInput}" Minimum="0" Maximum="60" FormatString="0.#" Increment="0.5"
                                               PlaceholderText="{l:T 'e.g. 15'}" ShowButtonSpinner="False" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="{l:T 'A rough estimate: Keystone uses your own rate, not your canton’s tariffs. A big change in income or deductions makes it rougher. A guide, not tax advice.'}" />
                </StackPanel>
            </Border>
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="sectionTitle" Text="{l:T 'Papers to collect'}" />
                        <TextBlock Classes="muted" FontSize="13" Text="{Binding TaxChecklistSummary}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding TaxChecklist}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TaxChecklistItem">
                                <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="8">
                                    <PathIcon Data="{StaticResource IconCheck}" Width="16" Height="16" VerticalAlignment="Top"
                                              Margin="0,2,0,0" Foreground="{DynamicResource Brand}" IsVisible="{Binding IsFound}" />
                                    <Ellipse Width="14" Height="14" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5"
                                             VerticalAlignment="Top" Margin="1,3,0,0" IsVisible="{Binding IsMissing}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" />
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Detail}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="icon" ToolTip.Tip="{l:T 'Open'}" IsVisible="{Binding HasDocument}"
                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenTaxDocumentCommand}"
                                            CommandParameter="{Binding Document}">
                                        <PathIcon Data="{StaticResource IconOpen}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="{l:T 'Found when a document’s title, sender or notes name it, e.g. “Lohnausweis 2025”.'}" />
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

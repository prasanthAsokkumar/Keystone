<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Keystone.Localization"
             xmlns:vm="using:Keystone.ViewModels"
             xmlns:models="using:Keystone.Models"
             xmlns:controls="using:Keystone.Controls"
             x:Class="Keystone.Views.Pages.TaskPanel"
             x:DataType="vm:MainViewModel">
    <!-- The form for a task. -->
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="28,24,20,8">
            <TextBlock Text="{l:T 'Edit task'}" FontSize="20" FontWeight="Bold" />
            <Button Grid.Column="1" Classes="icon" Command="{Binding ClosePanelCommand}" ToolTip.Tip="{l:T 'Close (Esc)'}"
                    VerticalAlignment="Top">
                <PathIcon Data="{StaticResource IconClose}" />
            </Button>
        </Grid>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0"
                Padding="28,16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Button Classes="primary" Content="{l:T 'Save changes'}" HorizontalAlignment="Stretch"
                        Command="{Binding Tasks.SaveTaskCommand}" />
                <Button Grid.Column="1" Classes="secondary" Content="{l:T 'Cancel'}"
                        Command="{Binding ClosePanelCommand}" />
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Spacing="18" Margin="28,12,28,20">
                <StackPanel Spacing="4">
                    <TextBlock Classes="fieldLabel" Text="{l:T 'What needs to be done'}" />
                    <TextBox Text="{Binding Tasks.TaskTitle}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="fieldLabel" Text="{l:T 'Due on'}" />
                            <Button Grid.Column="1" Classes="link" Content="{l:T 'No date'}" FontSize="12"
                                    Command="{Binding Tasks.ClearTaskDueDateCommand}" Padding="0" />
                        </Grid>
                        <CalendarDatePicker SelectedDate="{Binding Tasks.TaskDueDate}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="fieldLabel" Text="{l:T 'Who does it'}" />
                        <ComboBox ItemsSource="{Binding PersonOptions}" SelectedItem="{Binding Tasks.TaskPerson}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Classes="fieldLabel" Text="{l:T 'Notes'}" />
                    <TextBox Text="{Binding Tasks.TaskNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                             PlaceholderText="{l:T 'Details, links, phone numbers…'}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Classes="fieldLabel" Text="{l:T 'Repeats'}" />
                    <ComboBox ItemsSource="{Binding Tasks.TaskRepeatNames}" SelectedIndex="{Binding Tasks.TaskRepeatIndex}" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="{l:T 'When you tick a repeating task, the next one is added with its new due date.'}" />
                </StackPanel>

                <CheckBox IsChecked="{Binding Tasks.TaskIsDone}" Content="{l:T 'Done'}" />

                <TextBlock Classes="error" Text="{Binding Tasks.TaskError}" IsVisible="{Binding Tasks.HasTaskError}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

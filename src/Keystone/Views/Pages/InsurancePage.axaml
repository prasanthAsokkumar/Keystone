<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Keystone.Localization"
             xmlns:vm="using:Keystone.ViewModels"
             xmlns:controls="using:Keystone.Controls"
             x:Class="Keystone.Views.Pages.InsurancePage"
             x:DataType="vm:MainViewModel">
    <UserControl.Resources>
                            <DataTemplate x:Key="PolicyRow" x:DataType="vm:InsuranceRow">
                                <Grid ColumnDefinitions="*,120,140,220,106" ColumnSpacing="16" Background="Transparent" controls:Drag.Item="{Binding}" controls:Drag.Target="reorder:policies" controls:Drag.TargetItem="{Binding}"
                                      Opacity="{Binding HasEnded, Converter={x:Static vm:Format.EndedOpacityConverter}}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Insurer}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="muted" FontSize="13" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="pill" Classes.brand="{Binding !IsShared}">
                                        <TextBlock Text="{Binding PersonName}" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PremiumText}" FontWeight="SemiBold" TextAlignment="Right" />
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding YearlyText}" TextAlignment="Right"
                                                   IsVisible="{Binding HasYearly}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Classes="secondary" FontSize="13" Text="{Binding TermText}" TextAlignment="Right" />
                                        <TextBlock FontSize="12" Text="{Binding CancelByText}" TextAlignment="Right"
                                                   IsVisible="{Binding HasCancelBy}" Classes="muted"
                                                   Classes.negative="{Binding IsDeadlineUrgent}" Classes.warning="{Binding IsDeadlineSoon}" />
                                    </StackPanel>
                                    <Grid Grid.Column="4" ColumnDefinitions="34,34,34" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Classes="icon" ToolTip.Tip="{l:T 'Open policy document'}" IsVisible="{Binding HasDocument}"
                                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenPolicyDocumentCommand}"
                                                CommandParameter="{Binding Document}">
                                            <PathIcon Data="{StaticResource IconOpen}" />
                                        </Button>
                                        <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{l:T 'Edit'}"
                                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).EditInsuranceCommand}"
                                                CommandParameter="{Binding Policy}">
                                            <PathIcon Data="{StaticResource IconEdit}" />
                                        </Button>
                                        <Button Grid.Column="2" Classes="icon danger" ToolTip.Tip="{l:T 'Delete'}"
                                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DeleteInsuranceCommand}"
                                                CommandParameter="{Binding Policy}">
                                            <PathIcon Data="{StaticResource IconDelete}" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        <DataTemplate x:Key="PremiumRow" x:DataType="vm:EntryRow">
                            <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="16,8">
                                <Grid ColumnDefinitions="*,120,150,130,108" ColumnSpacing="16" Background="Transparent" controls:Drag.Item="{Binding}"
                                      Opacity="{Binding IsEnded, Converter={x:Static vm:Format.EndedOpacityConverter}}">
                                    <StackPanel VerticalAlignment="Center" ToolTip.Tip="{Binding Description}">
                                        <TextBlock Text="{Binding Description}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="pill" Classes.brand="{Binding !IsShared}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PersonName}" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <!-- Since / Until / From / Ended: old and new premiums told apart -->
                                    <TextBlock Grid.Column="2" FontSize="13" FontWeight="Medium" Text="{Binding PhaseText}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Classes.positive="{Binding IsCurrent}"
                                               Classes.warning="{Binding IsEnding}" Classes.muted="{Binding IsEnded}" />
                                    <TextBlock Grid.Column="3" Text="{Binding AmountText}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                                    <Grid Grid.Column="4" ColumnDefinitions="34,34,34" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Classes="icon" ToolTip.Tip="{l:T 'Edit'}"
                                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).EditTransactionCommand}"
                                                CommandParameter="{Binding Transaction}">
                                            <PathIcon Data="{StaticResource IconEdit}" />
                                        </Button>
                                        <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{l:T 'Stop repeating from today'}" IsVisible="{Binding CanStop}"
                                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).StopTransactionCommand}"
                                                CommandParameter="{Binding Transaction}">
                                            <PathIcon Data="{StaticResource IconStop}" />
                                        </Button>
                                        <Button Grid.Column="2" Classes="icon danger" ToolTip.Tip="{l:T 'Delete (removes every repeat)'}"
                                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DeleteTransactionCommand}"
                                                CommandParameter="{Binding Transaction}">
                                            <PathIcon Data="{StaticResource IconDelete}" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
    </UserControl.Resources>
    <!-- What each policy costs, and by when it must be cancelled to switch. -->
    <ScrollViewer>
    <StackPanel x:Name="Sections" Spacing="16" Margin="0,0,14,0">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <Border Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="{l:T 'Premiums per year'}" />
                    <TextBlock Classes="value" Text="{Binding InsurancePremiumsText}" />
                    <TextBlock Classes="muted" FontSize="13" Text="{Binding InsurancePremiumsDetail}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="{l:T 'Next notice deadline'}" />
                    <TextBlock Classes="value" Text="{Binding NextDeadlineText}" Classes.warning="{Binding IsNextDeadlineSoon}" />
                    <TextBlock Classes="muted" FontSize="13" Text="{Binding NextDeadlineDetail}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Classes="card" Padding="8" IsVisible="{Binding HasInsuranceBillRows}" Tag="bills">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" Margin="16,12,12,4">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="sectionTitle" Text="{l:T 'Bills to pay'}" />
                        <TextBlock Classes="muted" FontSize="13" Text="{Binding InsuranceBillsText}" />
                    </StackPanel>
                    <controls:SectionTools Grid.Column="1" DataContext="{Binding BillsSection}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding InsuranceBillRows}" Margin="12,0,12,8" IsVisible="{Binding BillsSection.IsOpen}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DocumentRow">
                            <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="16,8">
                                <Grid ColumnDefinitions="*,120,190,106" ColumnSpacing="16" Background="Transparent" controls:Drag.Item="{Binding}">
                                    <StackPanel VerticalAlignment="Center" ToolTip.Tip="{Binding Title}">
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="pill" Classes.brand="{Binding !IsShared}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PersonName}" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding InstalmentTip}">
                                        <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" TextAlignment="Right" />
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding StatusText}" TextAlignment="Right"
                                                   Classes.negative="{Binding IsOverdue}" />
                                    </StackPanel>
                                    <Grid Grid.Column="3" ColumnDefinitions="34,34,34" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Classes="icon" ToolTip.Tip="{l:T 'Open'}" IsEnabled="{Binding !IsMissing}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenDocumentCommand}"
                                                CommandParameter="{Binding Document}">
                                            <PathIcon Data="{StaticResource IconOpen}" />
                                        </Button>
                                        <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{Binding MarkPaidTip}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).MarkDocumentPaidCommand}"
                                                CommandParameter="{Binding Document}">
                                            <PathIcon Data="{StaticResource IconCheck}" />
                                        </Button>
                                        <Button Grid.Column="2" Classes="icon" ToolTip.Tip="{l:T 'Edit'}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).EditDocumentCommand}"
                                                CommandParameter="{Binding Document}">
                                            <PathIcon Data="{StaticResource IconEdit}" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- What health insurance costs in a year: premiums and cost-sharing bills (Leistungsabrechnungen), per person -->
        <Border Classes="card" Padding="8" Tag="health">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="16,12,12,4">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="sectionTitle" Text="{l:T 'Health costs'}" />
                        <TextBlock Classes="muted" FontSize="13" Text="{Binding HealthSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                        <Button Classes="icon" Command="{Binding PreviousHealthYearCommand}" ToolTip.Tip="{l:T 'Previous year'}">
                            <PathIcon Data="{StaticResource IconChevronLeft}" />
                        </Button>
                        <TextBlock Text="{Binding HealthYearText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0" />
                        <Button Classes="icon" Command="{Binding NextHealthYearCommand}" IsEnabled="{Binding CanShowNextHealthYear}"
                                ToolTip.Tip="{l:T 'Next year'}">
                            <PathIcon Data="{StaticResource IconChevronRight}" />
                        </Button>
                    </StackPanel>
                    <controls:SectionTools Grid.Column="2" DataContext="{Binding HealthSection}" />
                </Grid>
                <StackPanel Spacing="4" IsVisible="{Binding HealthSection.IsOpen}">
                    <Grid ColumnDefinitions="*,150,170,130" ColumnSpacing="16" Margin="28,4,28,6" IsVisible="{Binding HasHealthCostRows}">
                        <TextBlock Classes="label" Text="{l:T 'Person'}" />
                        <TextBlock Grid.Column="1" Classes="label" Text="{l:T 'Premiums'}" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Classes="label" Text="{l:T 'Cost sharing'}" TextAlignment="Right"
                                   ToolTip.Tip="{l:T 'Deductible and 10% share billed by the health insurer (Leistungsabrechnung)'}" />
                        <TextBlock Grid.Column="3" Classes="label" Text="{l:T 'Total'}" TextAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding HealthCostRows}" Margin="12,0,12,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HealthCostRow">
                                <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="16,8">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,150,170,130" ColumnSpacing="16">
                                            <TextBlock Text="{Binding PersonName}" FontWeight="Medium" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PremiumsText}" TextAlignment="Right" />
                                                <TextBlock Classes="muted" FontSize="12" Text="{Binding PremiumsDetail}" TextAlignment="Right" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CostSharingText}" TextAlignment="Right" />
                                                <TextBlock FontSize="12" Classes="warning" Text="{Binding CostSharingDetail}" TextAlignment="Right"
                                                           IsVisible="{Binding HasCostSharingOpen}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding TotalText}" FontWeight="SemiBold" TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <!-- Deductible plus 10% share: how much of the year's maximum is billed -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding HasMax}">
                                            <ProgressBar Value="{Binding MaxUsed}" Minimum="0" Maximum="1" Height="6" MinHeight="6"
                                                         VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Classes="muted" FontSize="12" Text="{Binding MaxText}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="16,2,16,10" Spacing="6" IsVisible="{Binding HasHealthStatements}">
                        <Button Classes="link" FontSize="12" Padding="0" Content="{Binding HealthStatementsText}"
                                Command="{Binding ToggleHealthStatementsCommand}" HorizontalAlignment="Left" />
                        <ItemsControl ItemsSource="{Binding HealthStatementRows}" IsVisible="{Binding ShowHealthStatements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DocumentRow">
                                    <Grid ColumnDefinitions="*,100,110,160,40" ColumnSpacing="12" Margin="0,3">
                                        <StackPanel VerticalAlignment="Center" ToolTip.Tip="{Binding Title}">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="muted" FontSize="12" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Classes="secondary" FontSize="13" Text="{Binding PersonName}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Classes="secondary" FontSize="13" Text="{Binding DateText}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" TextAlignment="Right" />
                                            <TextBlock Classes="muted" FontSize="12" Text="{Binding StatusText}" TextAlignment="Right"
                                                       Classes.negative="{Binding IsOverdue}" Classes.positive="{Binding IsPaid}" />
                                        </StackPanel>
                                        <Button Grid.Column="4" Classes="icon" ToolTip.Tip="{l:T 'Open'}" IsEnabled="{Binding !IsMissing}"
                                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenDocumentCommand}"
                                                CommandParameter="{Binding Document}">
                                            <PathIcon Data="{StaticResource IconOpen}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Classes="muted" FontSize="12" Margin="16,0,16,10" TextWrapping="Wrap"
                               Text="{l:T 'Cost-sharing bills are the papers from your health insurer after a doctor’s or pharmacy bill. Enter your deductible on the basic insurance policy to see the year’s maximum. A guide, not advice.'}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="card" Padding="8" Tag="policies">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,160,Auto" ColumnSpacing="12" Margin="16,12,12,8">
                    <TextBlock Classes="sectionTitle" Text="{l:T 'Policies'}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding PersonFilters}" SelectedItem="{Binding InsurancePersonFilter}" />
                    <controls:SectionTools Grid.Column="2" VerticalAlignment="Center" DataContext="{Binding PoliciesSection}" />
                </Grid>
                <Border DockPanel.Dock="Bottom" Padding="16,8" IsVisible="{Binding HasError}">
                    <TextBlock Classes="error" Text="{Binding ErrorMessage}" />
                </Border>
                <!-- Policies that have ended, kept for reference but apart from the current ones -->
                <StackPanel DockPanel.Dock="Bottom" IsVisible="{Binding PoliciesSection.IsOpen}">
                    <StackPanel Margin="16,4,16,8" Spacing="6" IsVisible="{Binding HasEndedInsuranceRows}">
                        <Button Classes="link" FontSize="12" Padding="0" Content="{Binding EndedPoliciesText}"
                                Command="{Binding ToggleEndedPoliciesCommand}" HorizontalAlignment="Left" />
                        <ItemsControl ItemsSource="{Binding EndedInsuranceRows}" IsVisible="{Binding ShowEndedPolicies}"
                                      ItemTemplate="{StaticResource PolicyRow}" Margin="-4,0" />
                    </StackPanel>
                </StackPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1"
                        Padding="28,6,28,10" Margin="0,0,0,4" IsVisible="{Binding PoliciesSection.IsOpen}">
                    <Grid ColumnDefinitions="*,120,140,220,106" ColumnSpacing="16">
                        <controls:SortHeader Label="{l:T 'Insurer'}" List="policies" Key="insurer" Sorts="{Binding ListSorts}" />
                        <controls:SortHeader Grid.Column="1" Label="{l:T 'Person'}" List="policies" Key="person" Sorts="{Binding ListSorts}" />
                        <controls:SortHeader Grid.Column="2" Label="{l:T 'Premium'}" List="policies" Key="premium" Sorts="{Binding ListSorts}" HorizontalAlignment="Right" />
                        <controls:SortHeader Grid.Column="3" Label="{l:T 'Term and notice'}" List="policies" Key="deadline" Sorts="{Binding ListSorts}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>
                <Panel MinHeight="120" IsVisible="{Binding PoliciesSection.IsOpen}">
                    <TextBlock Classes="secondary" Text="{Binding InsuranceEmptyText}" IsVisible="{Binding !HasInsuranceRows}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="420" />
                    <ListBox Classes="table" ItemsSource="{Binding InsuranceRows}" IsVisible="{Binding HasInsuranceRows}" Margin="12,0"
                             ItemTemplate="{StaticResource PolicyRow}">
                    </ListBox>
                </Panel>
            </DockPanel>
        </Border>

        <Border Classes="card" Padding="8" Tag="cover">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" Margin="16,12,12,4">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="sectionTitle" Text="{l:T 'Your cover'}" />
                        <TextBlock Classes="muted" FontSize="13" Text="{Binding CoverSummary}" />
                    </StackPanel>
                    <controls:SectionTools Grid.Column="1" DataContext="{Binding CoverSection}" />
                </Grid>
                <StackPanel Spacing="4" IsVisible="{Binding CoverSection.IsOpen}">
                <TextBlock Classes="muted" FontSize="12" Margin="16,0,16,6" TextWrapping="Wrap"
                           Text="{l:T 'The insurances most Swiss households have. A guide, not advice: what you need depends on your canton, your job and whether you rent or own.'}" />
                <ItemsControl ItemsSource="{Binding CoverRows}" Margin="12,0,12,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CoverRow">
                            <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="16,10">
                                <Grid ColumnDefinitions="*,170,220,72" ColumnSpacing="16">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Hint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="pill" Classes.brand="{Binding IsRequired}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NeedText}" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14" Foreground="{DynamicResource Positive}"
                                                  IsVisible="{Binding IsCovered}" />
                                        <TextBlock FontSize="13" Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="200"
                                                   Classes="secondary" Classes.warning="{Binding IsGap}" />
                                    </StackPanel>
                                    <Grid Grid.Column="3" ColumnDefinitions="34,34" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Classes="icon" ToolTip.Tip="{l:T 'Add this insurance'}" IsVisible="{Binding CanAdd}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).AddCoverCommand}"
                                                CommandParameter="{Binding}">
                                            <PathIcon Data="{StaticResource IconPlus}" />
                                        </Button>
                                        <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{l:T 'Doesn’t apply to us (hide)'}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).HideCoverCommand}"
                                                CommandParameter="{Binding}">
                                            <PathIcon Data="{StaticResource IconClose}" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Margin="16,2,16,10" Spacing="6" IsVisible="{Binding HasHiddenCover}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding HiddenCoverText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="link" FontSize="12" Padding="0" Command="{Binding ToggleHiddenCoverCommand}"
                                Content="{l:T 'Show them'}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding HiddenCoverRows}" IsVisible="{Binding ShowHiddenCover}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CoverRow">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <TextBlock Classes="secondary" FontSize="13" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="link" FontSize="12" Padding="0" Content="{l:T 'Show again'}"
                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).UnhideCoverCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="card" Padding="8" Tag="premiums">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="16,12,12,4">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="sectionTitle" Text="{l:T 'Premiums'}" />
                        <TextBlock Classes="muted" FontSize="13" Text="{Binding InsuranceEntriesTotal}" IsVisible="{Binding HasInsuranceEntryRows}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="secondary" Command="{Binding NewInsuranceEntryCommand}" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" />
                            <TextBlock Text="{l:T 'Add premium'}" />
                        </StackPanel>
                    </Button>
                    <controls:SectionTools Grid.Column="2" DataContext="{Binding PremiumsSection}" />
                </Grid>
                <StackPanel Spacing="4" IsVisible="{Binding PremiumsSection.IsOpen}">
                <TextBlock Classes="muted" FontSize="13" Margin="16,4,16,12" TextWrapping="Wrap" IsVisible="{Binding !HasInsuranceEntryRows}"
                           Text="{l:T 'No premiums yet. Add what you pay for health and other insurance, so your runway includes it.'}" />
                <Grid ColumnDefinitions="*,120,150,130,108" ColumnSpacing="16" Margin="28,4,28,6" IsVisible="{Binding HasInsuranceEntryRows}">
                    <controls:SortHeader Label="{l:T 'Description'}" List="premiums" Key="description" Sorts="{Binding ListSorts}" />
                    <controls:SortHeader Grid.Column="1" Label="{l:T 'Person'}" List="premiums" Key="person" Sorts="{Binding ListSorts}" />
                    <controls:SortHeader Grid.Column="2" Label="{l:T 'Date'}" List="premiums" Key="date" Sorts="{Binding ListSorts}" />
                    <controls:SortHeader Grid.Column="3" Label="{l:T 'Amount'}" List="premiums" Key="amount" Sorts="{Binding ListSorts}" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding InsuranceEntryRows}" Margin="12,0,12,8" IsVisible="{Binding HasInsuranceEntryRows}"
                              ItemTemplate="{StaticResource PremiumRow}" />
                <!-- Old premiums (replaced by a new one) and payments already made, out of the way -->
                <StackPanel Margin="16,0,16,8" Spacing="6" IsVisible="{Binding HasEndedInsuranceEntryRows}">
                    <Button Classes="link" FontSize="12" Padding="0" Content="{Binding EndedPremiumsText}"
                            Command="{Binding ToggleEndedPremiumsCommand}" HorizontalAlignment="Left" />
                    <ItemsControl ItemsSource="{Binding EndedInsuranceEntryRows}" IsVisible="{Binding ShowEndedPremiums}"
                                  ItemTemplate="{StaticResource PremiumRow}" Margin="-4,0" />
                </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Classes="card" Padding="8" Tag="papers">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" Margin="16,12,12,4">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="sectionTitle" Text="{l:T 'Insurance papers'}" />
                        <TextBlock Classes="muted" FontSize="12" Text="{l:T 'The latest; all of them are under Documents.'}" IsVisible="{Binding HasInsuranceDocumentRows}" />
                    </StackPanel>
                    <controls:SectionTools Grid.Column="1" DataContext="{Binding PapersSection}" />
                </Grid>
                <StackPanel Spacing="4" IsVisible="{Binding PapersSection.IsOpen}">
                <TextBlock Classes="muted" FontSize="13" Margin="16,4,16,12" TextWrapping="Wrap" IsVisible="{Binding !HasInsuranceDocumentRows}"
                           Text="{l:T 'No insurance papers yet. Policies, premium bills and letters from your insurers appear here once filed under Documents.'}" />
                <ItemsControl ItemsSource="{Binding RecentInsuranceDocumentRows}" Margin="12,0,12,0" IsVisible="{Binding HasInsuranceDocumentRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DocumentRow">
                            <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="16,8">
                                <Grid ColumnDefinitions="*,120,110,140,72" ColumnSpacing="16" Background="Transparent" controls:Drag.Item="{Binding}">
                                    <StackPanel VerticalAlignment="Center" ToolTip.Tip="{Binding Title}">
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="pill" Classes.brand="{Binding !IsShared}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PersonName}" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Classes="secondary" FontSize="13" Text="{Binding DateText}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" TextAlignment="Right" IsVisible="{Binding HasAmount}" />
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding StatusText}" TextAlignment="Right"
                                                   IsVisible="{Binding HasStatus}" Classes.negative="{Binding IsOverdue}" />
                                    </StackPanel>
                                    <Grid Grid.Column="4" ColumnDefinitions="34,34" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Classes="icon" ToolTip.Tip="{l:T 'Open'}" IsEnabled="{Binding !IsMissing}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenDocumentCommand}"
                                                CommandParameter="{Binding Document}">
                                            <PathIcon Data="{StaticResource IconOpen}" />
                                        </Button>
                                        <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{l:T 'Edit'}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).EditDocumentCommand}"
                                                CommandParameter="{Binding Document}">
                                            <PathIcon Data="{StaticResource IconEdit}" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="link" Margin="28,4,16,12" IsVisible="{Binding HasInsuranceDocumentRows}"
                        Command="{Binding ShowPapersCommand}" CommandParameter="insurance" Content="{Binding InsurancePapersLinkText}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>

<Window xmlns:l="using:Keystone.Localization"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Keystone.Views.AboutWindow"
        Title="{l:T 'About Keystone'}"
        Icon="/Assets/keystone.ico"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="32,28" Spacing="14" HorizontalAlignment="Stretch">
        <Image Source="/Assets/keystone.png" Width="112" Height="112" HorizontalAlignment="Center" />
        <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="{l:T 'Keystone'}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock x:Name="VersionText" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"
                   Text="{l:T 'Keystone holds your household together: income, expenses and debts, how long your money lasts, bills and letters for everyone, tasks, notes and your Swiss retirement provision.'}" />
        <Border Background="#14808080" CornerRadius="8" Padding="12,10">
            <StackPanel Spacing="4">
                <TextBlock Text="{l:T 'Your data stays on this Mac'}" FontWeight="SemiBold" FontSize="12" />
                <TextBlock x:Name="DatabaseText" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="CopyrightText" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
        <Button Content="{l:T 'Close'}" HorizontalAlignment="Center" MinWidth="96" HorizontalContentAlignment="Center"
                IsDefault="True" IsCancel="True" Click="Close_Click" />
    </StackPanel>
</Window>

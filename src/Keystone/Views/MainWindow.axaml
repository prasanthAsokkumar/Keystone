<Window xmlns:l="using:Keystone.Localization"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Keystone.ViewModels"
        xmlns:models="using:Keystone.Models"
        xmlns:controls="using:Keystone.Controls"
        xmlns:pages="using:Keystone.Views.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
        x:Class="Keystone.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/keystone.ico"
        Width="1320" Height="880" MinWidth="1180" MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Title="{l:T 'Keystone'}"
        DragDrop.AllowDrop="True">

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding ClosePanelCommand}" />
        <KeyBinding Gesture="Meta+N" Command="{Binding OpenNewMenuCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding OpenNewMenuCommand}" />
        <KeyBinding Gesture="Meta+L" Command="{Binding Lock.LockNowCommand}" />
    </Window.KeyBindings>

    <Panel>
    <Grid ColumnDefinitions="236,*" IsVisible="{Binding !Lock.IsLocked}">

        <!-- ═══════════════ Sidebar ═══════════════ -->
        <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Hairline}"
                BorderThickness="0,0,1,0" Padding="16,22">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="8,0,0,18">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image Source="/Assets/keystone.png" Width="34" Height="34" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T 'Keystone'}" FontSize="17" FontWeight="Bold" />
                            <TextBlock Classes="muted" Text="{l:T 'Household finances'}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="icon" Command="{Binding Lock.LockNowCommand}" IsVisible="{Binding Lock.IsLockEnabled}"
                            ToolTip.Tip="{l:T 'Lock now (⌘L)'}" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconLock}" />
                    </Button>
                </Grid>

                <!-- Whose things the app shows: everyone, or one person on every page -->
                <ComboBox DockPanel.Dock="Top" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding ViewPersonOptions}" SelectedItem="{Binding ViewPerson}"
                          ToolTip.Tip="{l:T 'Show one person’s things on every page'}" />
                <Panel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBox x:Name="GlobalSearchBox" Text="{Binding GlobalSearch}" PlaceholderText="{l:T 'Search everything (⌘F)'}">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource IconSearch}" Width="16" Height="16" Margin="10,0,0,0"
                                      Foreground="{DynamicResource TextMuted}" />
                        </TextBox.InnerLeftContent>
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding OpenFirstSearchResultCommand}" />
                            <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Popup x:Name="SearchPopup" PlacementTarget="{Binding #GlobalSearchBox}" Placement="BottomEdgeAlignedLeft"
                           VerticalOffset="6" IsLightDismissEnabled="True">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                                CornerRadius="12" Padding="6" Width="440" BoxShadow="0 8 24 0 #26000000">
                            <Panel>
                                <TextBlock Classes="muted" Text="{l:T 'Nothing found.'}" Margin="12,10"
                                           IsVisible="{Binding ShowsNoSearchResults}" />
                                <ScrollViewer MaxHeight="460" IsVisible="{Binding HasSearchResults}">
                                    <ItemsControl ItemsSource="{Binding SearchResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SearchResult">
                                                <Button Classes="searchResult" HorizontalAlignment="Stretch"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenSearchResultCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Classes="muted" FontSize="12" Text="{Binding Detail}"
                                                                       TextTrimming="CharacterEllipsis" IsVisible="{Binding HasDetail}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Classes="pill" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Kind}" />
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Panel>
                        </Border>
                    </Popup>
                </Panel>

                <Button x:Name="NewButton" DockPanel.Dock="Bottom" Classes="primary" HorizontalAlignment="Stretch"
                        ToolTip.Tip="{l:T 'Add anything: an entry, a bill, a task… (⌘N)'}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconPlus}" />
                        <TextBlock Text="{l:T 'New'}" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedLeft">
                            <ItemsControl ItemsSource="{Binding NewMenuItems}" Width="300">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NewMenuItem">
                                        <Button Classes="searchResult" HorizontalAlignment="Stretch" Click="NewMenuItem_Click">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Medium" />
                                                <TextBlock Classes="muted" FontSize="12" Text="{Binding Hint}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button DockPanel.Dock="Bottom" Classes="secondary" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                        Click="Import_Click" IsVisible="{Binding IsImportEnabled}" ToolTip.Tip="{l:T 'Or drop a bill, payslip or statement anywhere on the window'}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconImport}" />
                        <TextBlock Text="{l:T 'Import document'}" />
                    </StackPanel>
                </Button>

                <ScrollViewer>
                <StackPanel Spacing="2">
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsOverviewPage}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconOverview}" />
                            <TextBlock Text="{l:T 'Overview'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <TextBlock Classes="navHeading" Text="{l:T 'Money'}" />
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsTransactionsPlace}" controls:Drag.Target="transactions">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconList}" />
                            <TextBlock Text="{l:T 'Transactions'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsWealthPlace}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconPiggy}" />
                            <TextBlock Text="{l:T 'Debts &amp; assets'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsRetirementPlace}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconShield}" />
                            <TextBlock Text="{l:T 'Retirement'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsPlanningPage}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconChartLine}" />
                            <TextBlock Text="{l:T 'Planning'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <TextBlock Classes="navHeading" Text="{l:T 'Paperwork'}" />
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsDocumentsPage}" controls:Drag.Target="documents">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconFolder}" />
                            <TextBlock Text="{l:T 'Documents'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsInsurancePage}" controls:Drag.Target="insurance">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconUmbrella}" />
                            <TextBlock Text="{l:T 'Insurance'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsTaxesPage}" controls:Drag.Target="taxes">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconReceipt}" />
                            <TextBlock Text="{l:T 'Taxes'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsContractsPage}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconCalendarClock}" />
                            <TextBlock Text="{l:T 'Contracts &amp; dates'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <TextBlock Classes="navHeading" Text="{l:T 'Home'}" />
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsHouseholdPage}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconPeople}" />
                            <TextBlock Text="{l:T 'Household'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsAgendaPlace}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconCalendar}" />
                            <TextBlock Text="{l:T 'Agenda'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsNotesPage}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconNote}" />
                            <TextBlock Text="{l:T 'Notes'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <Border Height="10" />
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsSettingsPage}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconSettings}" />
                            <TextBlock Text="{l:T 'Settings'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══════════════ Main area ═══════════════ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="36,28,36,28" RowSpacing="22">

            <!-- Page header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Classes="pageTitle" Text="{Binding PageTitle}" />
                    <TextBlock Classes="secondary" Text="{Binding PageSubtitle}" TextTrimming="CharacterEllipsis" />
                    <!-- One person's view -->
                    <Border Background="{DynamicResource BrandSoft}" CornerRadius="9" Padding="12,6" Margin="0,10,0,0"
                            HorizontalAlignment="Left" IsVisible="{Binding ShowsPersonViewBar}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource IconPeople}" Width="15" Height="15" Foreground="{DynamicResource BrandText}" />
                            <TextBlock Text="{Binding PersonViewText}" Foreground="{DynamicResource BrandText}" FontWeight="Medium" VerticalAlignment="Center" />
                            <Button Classes="link" Command="{Binding ShowEveryoneCommand}" Content="{l:T 'Show everyone'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!-- Pages that share a place in the sidebar, as tabs -->
                    <Border Classes="segments" HorizontalAlignment="Left" Margin="0,12,0,0" IsVisible="{Binding HasPageTabs}">
                        <ItemsControl ItemsSource="{Binding PageTabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PageTab">
                                    <RadioButton Classes="segment" GroupName="PageTabs" MinWidth="110" Content="{Binding Title}"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).GoToPageCommand}"
                                                 CommandParameter="{Binding Page}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Year switcher -->
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsYearPage}">
                        <Button Classes="icon" Command="{Binding PreviousYearCommand}" ToolTip.Tip="{l:T 'Previous year'}">
                            <PathIcon Data="{StaticResource IconChevronLeft}" />
                        </Button>
                        <TextBlock Text="{Binding Report.Label}" FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center" MinWidth="96" TextAlignment="Center" />
                        <Button Classes="icon" Command="{Binding NextYearCommand}" ToolTip.Tip="{l:T 'Next year'}">
                            <PathIcon Data="{StaticResource IconChevronRight}" />
                        </Button>
                        <Button Classes="secondary" Content="{l:T 'This year'}" Command="{Binding CurrentYearCommand}"
                                Margin="6,0,0,0" />
                        <Button Classes="secondary" Margin="2,0,0,0"
                                ToolTip.Tip="{l:T 'For your records or a tax advisor'}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconDownload}" />
                                <TextBlock Text="{l:T 'Export'}" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="{l:T 'Every booking of the year (CSV)'}" Click="ExportYearCsv_Click" />
                                    <MenuItem Header="{l:T 'Summary for the year (PDF)'}" Click="ExportYearPdf_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- Tax year switcher -->
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsTaxesPage}">
                        <Button Classes="icon" Command="{Binding PreviousTaxYearCommand}" ToolTip.Tip="{l:T 'Previous year'}">
                            <PathIcon Data="{StaticResource IconChevronLeft}" />
                        </Button>
                        <TextBlock Text="{Binding TaxYear}" FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center" MinWidth="64" TextAlignment="Center" />
                        <Button Classes="icon" Command="{Binding NextTaxYearCommand}" ToolTip.Tip="{l:T 'Next year'}">
                            <PathIcon Data="{StaticResource IconChevronRight}" />
                        </Button>
                        <Button Classes="secondary" Command="{Binding CopyTaxSummaryCommand}" Margin="6,0,0,0"
                                ToolTip.Tip="{Binding TaxCopyStatus}">
                            <TextBlock Text="{l:T 'Copy summary'}" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsTransactionsPage}">
                        <Button Classes="secondary" Click="ExportEntries_Click" IsEnabled="{Binding HasEntryRows}"
                                ToolTip.Tip="{l:T 'Save the entries shown as a CSV file for Excel or Numbers'}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconDownload}" />
                                <TextBlock Text="{l:T 'Export'}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary" Click="ImportBankStatement_Click"
                                ToolTip.Tip="{l:T 'camt.053 or CSV from your bank, or a Revolut PDF statement. You can also drop it on the window.'}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconBank}" />
                                <TextBlock Text="{l:T 'Import bank statement'}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="primary" Command="{Binding NewEntryCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconPlus}" />
                                <TextBlock Text="{Binding NewEntryText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Classes="primary" Command="{Binding Appointments.NewAppointmentCommand}" IsVisible="{Binding IsAppointmentsPage}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" />
                            <TextBlock Text="{l:T 'New appointment'}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding Deadlines.AddDeadlineCommand}" IsVisible="{Binding IsContractsPage}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" />
                            <TextBlock Text="{Binding Deadlines.AddDeadlineText}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsInsurancePage}">
                        <TextBlock Classes="muted" FontSize="13" Text="{Binding CheckPapersStatus}" IsVisible="{Binding IsCheckingPapers}"
                                   VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                        <Button Classes="secondary" Command="{Binding StopCheckingPapersCommand}" IsVisible="{Binding IsCheckingPapers}"
                                Content="{l:T 'Stop'}" />
                        <Button Classes="secondary" Command="{Binding CheckFiledPapersCommand}" IsVisible="{Binding !IsCheckingPapers}"
                                ToolTip.Tip="{l:T 'Reads the insurance papers you filed before and adds or updates their policies and premiums'}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconSync}" />
                                <TextBlock Text="{l:T 'Check filed papers'}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Classes="primary" Command="{Binding NewInsuranceCommand}" IsVisible="{Binding IsInsurancePage}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" />
                            <TextBlock Text="{l:T 'Add insurance'}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding Notes.NewNoteCommand}" IsVisible="{Binding IsNotesPage}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" />
                            <TextBlock Text="{l:T 'New note'}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsDocumentsPage}">
                        <Button Classes="secondary" Command="{Binding OpenDocumentsFolderCommand}"
                                ToolTip.Tip="{Binding DocumentsFolder}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconOpen}" />
                                <TextBlock Text="{l:T 'Open folder'}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary" Command="{Binding FileInboxCommand}" IsVisible="{Binding HasInboxFiles}"
                                ToolTip.Tip="{Binding InboxNote}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconInbox}" Foreground="{DynamicResource Brand}" />
                                <TextBlock Text="{Binding InboxText}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="primary" Click="AddDocument_Click"
                                ToolTip.Tip="{l:T 'Pick one or more files, or drop them on the window'}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconPlus}" />
                                <TextBlock Text="{l:T 'Add documents'}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Classes="primary" Command="{Binding Retirement.NewStatementCommand}" IsVisible="{Binding IsRetirementPage}"
                            ToolTip.Tip="{l:T 'Or drop the letter anywhere on the window'}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" />
                            <TextBlock Text="{l:T 'Add statement'}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding NewMemberCommand}" IsVisible="{Binding IsHouseholdPage}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" />
                            <TextBlock Text="{l:T 'Add household member'}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding Assets.NewAssetCommand}" IsVisible="{Binding IsAssetsPage}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" />
                            <TextBlock Text="{l:T 'Add asset'}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding NewDebtCommand}" IsVisible="{Binding IsDebtsPage}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" />
                            <TextBlock Text="{l:T 'Add debt'}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══ Overview ═══ -->
            <pages:OverviewPage Grid.Row="1" IsVisible="{Binding IsOverviewPage}" />

            <!-- ═══ Transactions ═══ -->
            <pages:TransactionsPage Grid.Row="1" IsVisible="{Binding IsTransactionsPage}" />

            <!-- ═══ Documents ═══ -->
            <pages:DocumentsPage Grid.Row="1" IsVisible="{Binding IsDocumentsPage}" />

            <!-- ═══ Tasks ═══ -->
            <pages:TasksPage x:Name="TasksView" Grid.Row="1" IsVisible="{Binding IsTasksPage}" />

            <!-- ═══ Appointments ═══ -->
            <pages:AppointmentsPage Grid.Row="1" IsVisible="{Binding IsAppointmentsPage}" />

            <!-- ═══ Notes ═══ -->
            <Panel Grid.Row="1" IsVisible="{Binding IsNotesPage}">
                <pages:NotesPage x:Name="NotesView" DataContext="{Binding Notes}" />
            </Panel>

            <!-- ═══ Debts ═══ -->
            <pages:DebtsPage Grid.Row="1" IsVisible="{Binding IsDebtsPage}" />

            <!-- ═══ Retirement ═══ -->
            <pages:RetirementPage Grid.Row="1" IsVisible="{Binding IsRetirementPage}" />

            <!-- ═══ Insurance ═══ -->
            <pages:InsurancePage Grid.Row="1" IsVisible="{Binding IsInsurancePage}" />
            <pages:AssetsPage Grid.Row="1" IsVisible="{Binding IsAssetsPage}" />
            <pages:HouseholdPage Grid.Row="1" IsVisible="{Binding IsHouseholdPage}" />

            <!-- ═══ Taxes ═══ -->
            <pages:TaxesPage Grid.Row="1" IsVisible="{Binding IsTaxesPage}" />

            <!-- ═══ Contracts & dates ═══ -->
            <pages:ContractsPage Grid.Row="1" IsVisible="{Binding IsContractsPage}" />

            <!-- ═══ Planning ═══ -->
            <pages:PlanningPage Grid.Row="1" IsVisible="{Binding IsPlanningPage}" />
            <pages:NetWorthPage Grid.Row="1" IsVisible="{Binding IsNetWorthPage}" />
            <pages:RetirementPlanPage Grid.Row="1" IsVisible="{Binding IsRetirementPlanPage}" />

            <!-- ═══ Year ═══ -->
            <pages:YearPage Grid.Row="1" IsVisible="{Binding IsYearPage}" />

            <!-- ═══ Settings ═══ -->
            <pages:SettingsPage Grid.Row="1" IsVisible="{Binding IsSettingsPage}" />
        </Grid>

        <!-- ═══════════════ Side panel ═══════════════ -->
        <Panel Grid.ColumnSpan="2" IsVisible="{Binding IsPanelOpen}">
            <Border Background="{DynamicResource Backdrop}" PointerPressed="Backdrop_PointerPressed" />

            <!-- Entry form -->
            <Border Classes="panel" Width="440" HorizontalAlignment="Right" IsVisible="{Binding IsEntryPanelOpen}">
                <pages:EntryPanel />
            </Border>

            <!-- Debt form -->
            <Border Classes="panel" Width="440" HorizontalAlignment="Right" IsVisible="{Binding IsDebtPanelOpen}">
                <pages:DebtPanel />
            </Border>

            <!-- Import review -->
            <Border Classes="panel" Width="620" HorizontalAlignment="Right" IsVisible="{Binding IsImportPanelOpen}">
                <pages:ImportPanel />
            </Border>

            <!-- Document form -->
            <Border Classes="panel" Width="460" HorizontalAlignment="Right" IsVisible="{Binding IsDocumentPanelOpen}">
                <pages:DocumentPanel />
            </Border>
            <!-- Task form -->
            <Border Classes="panel" Width="440" HorizontalAlignment="Right" IsVisible="{Binding Tasks.IsTaskPanelOpen}">
                <pages:TaskPanel />
            </Border>
            <!-- Pension statement form -->
            <Border Classes="panel" Width="460" HorizontalAlignment="Right" IsVisible="{Binding Retirement.IsStatementPanelOpen}">
                <pages:StatementPanel />
            </Border>

            <!-- Pension account form -->
            <Border Classes="panel" Width="460" HorizontalAlignment="Right" IsVisible="{Binding Retirement.IsPensionAccountPanelOpen}">
                <pages:PensionAccountPanel />
            </Border>
            <!-- Bulk document import -->
            <Border Classes="panel" Width="640" HorizontalAlignment="Right" IsVisible="{Binding IsBulkPanelOpen}">
                <pages:BulkPanel />
            </Border>
        </Panel>

        <!-- Insurance and account forms -->
        <Panel Grid.ColumnSpan="2" IsVisible="{Binding IsPanelOpen}" IsHitTestVisible="{Binding IsPanelOpen}">
            <Border Classes="panel" Width="460" HorizontalAlignment="Right" IsVisible="{Binding IsInsurancePanelOpen}">
                <pages:InsurancePanel />
            </Border>
            <Border Classes="panel" Width="440" HorizontalAlignment="Right" IsVisible="{Binding IsAccountPanelOpen}">
                <pages:AccountPanel />
            </Border>
            <pages:DeadlinePanels />
            <Border Classes="panel" Width="440" HorizontalAlignment="Right" IsVisible="{Binding Appointments.IsAppointmentPanelOpen}">
                <pages:AppointmentPanel />
            </Border>
            <Border Classes="panel" Width="440" HorizontalAlignment="Right" IsVisible="{Binding Planning.IsGoalPanelOpen}">
                <pages:GoalPanel />
            </Border>
            <Border Classes="panel" Width="440" HorizontalAlignment="Right" IsVisible="{Binding Assets.IsAssetPanelOpen}">
                <pages:AssetPanel />
            </Border>
            <pages:HouseholdPanels />
        </Panel>

        <!-- While a document is dragged: drop it on a person to make it theirs (its file moves to their folder). -->
        <Border Grid.Column="1" IsVisible="{Binding IsDraggingDocument}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24" Padding="14,10" CornerRadius="12" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Hairline}" BorderThickness="1" BoxShadow="0 6 24 0 #33000000">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="secondary" Text="{l:T 'Drop on a person to make it theirs:'}" VerticalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding PersonOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PersonOption">
                            <Border Background="{DynamicResource SurfaceSunken}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                                    CornerRadius="16" Padding="14,6" controls:Drag.Target="person" controls:Drag.TargetItem="{Binding}">
                                <TextBlock Text="{Binding}" FontWeight="Medium" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Short message with Undo after deleting, or where an export was saved. -->
        <Border Grid.Column="1" IsVisible="{Binding HasNotice}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24" Padding="18,10,10,10" CornerRadius="10" MaxWidth="680"
                Background="{DynamicResource TextPrimary}" BoxShadow="0 6 24 0 #33000000">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock Text="{Binding NoticeText}" Foreground="{DynamicResource Surface}" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                <Button Content="{l:T 'Undo'}" Command="{Binding UndoCommand}" IsVisible="{Binding CanUndo}"
                        Foreground="{DynamicResource Brand}" Background="Transparent" FontWeight="SemiBold" Padding="8,4" />
                <Button Classes="icon" Command="{Binding DismissNoticeCommand}" ToolTip.Tip="{l:T 'Close'}"
                        Foreground="{DynamicResource Surface}">
                    <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Shown while a file is dragged over the window. -->
        <Border x:Name="DropOverlay" Grid.ColumnSpan="2" IsVisible="False" IsHitTestVisible="False"
                Background="{DynamicResource Backdrop}" Padding="40">
            <Border Background="{DynamicResource BrandSoft}" CornerRadius="20" BorderThickness="2"
                    BorderBrush="{DynamicResource Brand}" Opacity="0.96">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <PathIcon Data="{StaticResource IconImport}" Width="44" Height="44"
                              Foreground="{DynamicResource Brand}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding DropHint}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Classes="muted" HorizontalAlignment="Center"
                               Text="{Binding DropDetailText}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>

    <!-- ═══════════════ Lock screen ═══════════════ -->
    <Border Background="{DynamicResource AppBackground}" IsVisible="{Binding Lock.IsLocked}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="320">
            <Image Source="/Assets/keystone.png" Width="96" Height="96" HorizontalAlignment="Center" />
            <TextBlock Text="{l:T 'Keystone is locked'}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center"
                       Text="{l:T 'Unlock with Touch ID or your Mac password.'}" />
            <Button Classes="primary" HorizontalAlignment="Center" Command="{Binding Lock.UnlockCommand}" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconLock}" />
                    <TextBlock Text="{l:T 'Unlock'}" />
                </StackPanel>
            </Button>
            <TextBlock Classes="error" Text="{Binding Lock.LockMessage}" HorizontalAlignment="Center" TextAlignment="Center" />
        </StackPanel>
    </Border>
    </Panel>
</Window>

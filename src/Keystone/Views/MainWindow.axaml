<Window xmlns:l="using:Keystone.Localization"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Keystone.ViewModels"
        xmlns:models="using:Keystone.Models"
        xmlns:controls="using:Keystone.Controls"
        xmlns:pages="using:Keystone.Views.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
        x:Class="Keystone.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/keystone.ico"
        Width="1320" Height="880" MinWidth="1180" MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Title="{l:T 'Keystone'}"
        DragDrop.AllowDrop="True">

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding ClosePanelCommand}" />
        <KeyBinding Gesture="Meta+N" Command="{Binding NewEntryCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewEntryCommand}" />
        <KeyBinding Gesture="Meta+L" Command="{Binding LockNowCommand}" />
    </Window.KeyBindings>

    <Panel>
    <Grid ColumnDefinitions="236,*" IsVisible="{Binding !IsLocked}">

        <!-- ═══════════════ Sidebar ═══════════════ -->
        <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Hairline}"
                BorderThickness="0,0,1,0" Padding="16,22">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="8,0,0,18">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image Source="/Assets/keystone.png" Width="34" Height="34" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T 'Keystone'}" FontSize="17" FontWeight="Bold" />
                            <TextBlock Classes="muted" Text="{l:T 'Household finances'}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="icon" Command="{Binding LockNowCommand}" IsVisible="{Binding IsLockEnabled}"
                            ToolTip.Tip="{l:T 'Lock now (⌘L)'}" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconLock}" />
                    </Button>
                </Grid>

                <Panel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBox x:Name="GlobalSearchBox" Text="{Binding GlobalSearch}" PlaceholderText="{l:T 'Search everything (⌘F)'}">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource IconSearch}" Width="16" Height="16" Margin="10,0,0,0"
                                      Foreground="{DynamicResource TextMuted}" />
                        </TextBox.InnerLeftContent>
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding OpenFirstSearchResultCommand}" />
                            <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Popup x:Name="SearchPopup" PlacementTarget="{Binding #GlobalSearchBox}" Placement="BottomEdgeAlignedLeft"
                           VerticalOffset="6" IsLightDismissEnabled="True">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                                CornerRadius="12" Padding="6" Width="440" BoxShadow="0 8 24 0 #26000000">
                            <Panel>
                                <TextBlock Classes="muted" Text="{l:T 'Nothing found.'}" Margin="12,10"
                                           IsVisible="{Binding ShowsNoSearchResults}" />
                                <ScrollViewer MaxHeight="460" IsVisible="{Binding HasSearchResults}">
                                    <ItemsControl ItemsSource="{Binding SearchResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SearchResult">
                                                <Button Classes="searchResult" HorizontalAlignment="Stretch"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenSearchResultCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Classes="muted" FontSize="12" Text="{Binding Detail}"
                                                                       TextTrimming="CharacterEllipsis" IsVisible="{Binding HasDetail}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Classes="pill" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Kind}" />
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Panel>
                        </Border>
                    </Popup>
                </Panel>

                <Button DockPanel.Dock="Bottom" Classes="primary" HorizontalAlignment="Stretch"
                        Command="{Binding NewEntryCommand}" ToolTip.Tip="{l:T 'New entry (⌘N)'}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconPlus}" />
                        <TextBlock Text="{l:T 'New entry'}" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Bottom" Classes="secondary" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                        Click="Import_Click" IsVisible="{Binding IsImportEnabled}" ToolTip.Tip="{l:T 'Or drop a bill, payslip or statement anywhere on the window'}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconImport}" />
                        <TextBlock Text="{l:T 'Import document'}" />
                    </StackPanel>
                </Button>

                <StackPanel Spacing="2">
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsOverviewPage}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconOverview}" />
                            <TextBlock Text="{l:T 'Overview'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsTransactionsPage}" controls:Drag.Target="transactions">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconList}" />
                            <TextBlock Text="{l:T 'Transactions'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsDocumentsPage}" controls:Drag.Target="documents">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconFolder}" />
                            <TextBlock Text="{l:T 'Documents'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsTasksPage}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconTask}" />
                            <TextBlock Text="{l:T 'Tasks'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsAppointmentsPage}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconAppointment}" />
                            <TextBlock Text="{l:T 'Appointments'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsNotesPage}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconNote}" />
                            <TextBlock Text="{l:T 'Notes'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsHouseholdPage}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconPeople}" />
                            <TextBlock Text="{l:T 'Household'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsDebtsPage}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconCard}" />
                            <TextBlock Text="{l:T 'Debts'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsAssetsPage}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconPiggy}" />
                            <TextBlock Text="{l:T 'Assets'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsRetirementPage}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconShield}" />
                            <TextBlock Text="{l:T 'Retirement'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsInsurancePage}" controls:Drag.Target="insurance">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconUmbrella}" />
                            <TextBlock Text="{l:T 'Insurance'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsContractsPage}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconCalendarClock}" />
                            <TextBlock Text="{l:T 'Contracts &amp; dates'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsTaxesPage}" controls:Drag.Target="taxes">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconReceipt}" />
                            <TextBlock Text="{l:T 'Taxes'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsPlanningPage}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconChartLine}" />
                            <TextBlock Text="{l:T 'Planning'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsYearPage}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconCalendar}" />
                            <TextBlock Text="{l:T 'Year'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="Nav" IsChecked="{Binding IsSettingsPage}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconSettings}" />
                            <TextBlock Text="{l:T 'Settings'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════════ Main area ═══════════════ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="36,28,36,28" RowSpacing="22">

            <!-- Page header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Classes="pageTitle" Text="{Binding PageTitle}" />
                    <TextBlock Classes="secondary" Text="{Binding PageSubtitle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Year switcher -->
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsYearPage}">
                        <Button Classes="icon" Command="{Binding PreviousYearCommand}" ToolTip.Tip="{l:T 'Previous year'}">
                            <PathIcon Data="{StaticResource IconChevronLeft}" />
                        </Button>
                        <TextBlock Text="{Binding Report.Label}" FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center" MinWidth="96" TextAlignment="Center" />
                        <Button Classes="icon" Command="{Binding NextYearCommand}" ToolTip.Tip="{l:T 'Next year'}">
                            <PathIcon Data="{StaticResource IconChevronRight}" />
                        </Button>
                        <Button Classes="secondary" Content="{l:T 'This year'}" Command="{Binding CurrentYearCommand}"
                                Margin="6,0,0,0" />
                        <Button Classes="secondary" Margin="2,0,0,0"
                                ToolTip.Tip="{l:T 'For your records or a tax advisor'}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconDownload}" />
                                <TextBlock Text="{l:T 'Export'}" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="{l:T 'Every booking of the year (CSV)'}" Click="ExportYearCsv_Click" />
                                    <MenuItem Header="{l:T 'Summary for the year (PDF)'}" Click="ExportYearPdf_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- Tax year switcher -->
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsTaxesPage}">
                        <Button Classes="icon" Command="{Binding PreviousTaxYearCommand}" ToolTip.Tip="{l:T 'Previous year'}">
                            <PathIcon Data="{StaticResource IconChevronLeft}" />
                        </Button>
                        <TextBlock Text="{Binding TaxYear}" FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center" MinWidth="64" TextAlignment="Center" />
                        <Button Classes="icon" Command="{Binding NextTaxYearCommand}" ToolTip.Tip="{l:T 'Next year'}">
                            <PathIcon Data="{StaticResource IconChevronRight}" />
                        </Button>
                        <Button Classes="secondary" Command="{Binding CopyTaxSummaryCommand}" Margin="6,0,0,0"
                                ToolTip.Tip="{Binding TaxCopyStatus}">
                            <TextBlock Text="{l:T 'Copy summary'}" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsTransactionsPage}">
                        <Button Classes="secondary" Click="ExportEntries_Click" IsEnabled="{Binding HasEntryRows}"
                                ToolTip.Tip="{l:T 'Save the entries shown as a CSV file for Excel or Numbers'}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconDownload}" />
                                <TextBlock Text="{l:T 'Export'}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary" Click="ImportBankStatement_Click"
                                ToolTip.Tip="{l:T 'camt.053 or CSV from your bank, or a Revolut PDF statement. You can also drop it on the window.'}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconBank}" />
                                <TextBlock Text="{l:T 'Import bank statement'}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="primary" Command="{Binding NewEntryCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconPlus}" />
                                <TextBlock Text="{Binding NewEntryText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Classes="primary" Command="{Binding NewAppointmentCommand}" IsVisible="{Binding IsAppointmentsPage}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" />
                            <TextBlock Text="{l:T 'New appointment'}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding AddDeadlineCommand}" IsVisible="{Binding IsContractsPage}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" />
                            <TextBlock Text="{Binding AddDeadlineText}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsInsurancePage}">
                        <TextBlock Classes="muted" FontSize="13" Text="{Binding CheckPapersStatus}" IsVisible="{Binding IsCheckingPapers}"
                                   VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                        <Button Classes="secondary" Command="{Binding StopCheckingPapersCommand}" IsVisible="{Binding IsCheckingPapers}"
                                Content="{l:T 'Stop'}" />
                        <Button Classes="secondary" Command="{Binding CheckFiledPapersCommand}" IsVisible="{Binding !IsCheckingPapers}"
                                ToolTip.Tip="{l:T 'Reads the insurance papers you filed before and adds or updates their policies and premiums'}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconSync}" />
                                <TextBlock Text="{l:T 'Check filed papers'}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Classes="primary" Command="{Binding NewInsuranceCommand}" IsVisible="{Binding IsInsurancePage}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" />
                            <TextBlock Text="{l:T 'Add insurance'}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding NewNoteCommand}" IsVisible="{Binding IsNotesPage}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" />
                            <TextBlock Text="{l:T 'New note'}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsDocumentsPage}">
                        <Button Classes="secondary" Command="{Binding OpenDocumentsFolderCommand}"
                                ToolTip.Tip="{Binding DocumentsFolder}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconOpen}" />
                                <TextBlock Text="{l:T 'Open folder'}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary" Command="{Binding FileInboxCommand}" IsVisible="{Binding HasInboxFiles}"
                                ToolTip.Tip="{Binding InboxNote}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconInbox}" Foreground="{DynamicResource Brand}" />
                                <TextBlock Text="{Binding InboxText}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="primary" Click="AddDocument_Click"
                                ToolTip.Tip="{l:T 'Pick one or more files, or drop them on the window'}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconPlus}" />
                                <TextBlock Text="{l:T 'Add documents'}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Classes="primary" Command="{Binding NewStatementCommand}" IsVisible="{Binding IsRetirementPage}"
                            ToolTip.Tip="{l:T 'Or drop the letter anywhere on the window'}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" />
                            <TextBlock Text="{l:T 'Add statement'}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding NewMemberCommand}" IsVisible="{Binding IsHouseholdPage}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" />
                            <TextBlock Text="{l:T 'Add household member'}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding NewAssetCommand}" IsVisible="{Binding IsAssetsPage}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" />
                            <TextBlock Text="{l:T 'Add asset'}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" Command="{Binding NewDebtCommand}" IsVisible="{Binding IsDebtsPage}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" />
                            <TextBlock Text="{l:T 'Add debt'}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══ Overview ═══ -->
            <pages:OverviewPage Grid.Row="1" IsVisible="{Binding IsOverviewPage}" />

            <!-- ═══ Transactions ═══ -->
            <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="16" IsVisible="{Binding IsTransactionsPage}">
            <!-- Income, expenses and transfers each on their own tab -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
                <Border Classes="segments" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <UniformGrid Rows="1">
                        <RadioButton Classes="segment" GroupName="TransactionTabs" Content="{l:T 'Income'}" MinWidth="130"
                                     IsChecked="{Binding IsIncomeTab}" controls:Drag.Target="income" />
                        <RadioButton Classes="segment" GroupName="TransactionTabs" Content="{l:T 'Expenses'}" MinWidth="130"
                                     IsChecked="{Binding IsExpensesTab}" controls:Drag.Target="expenses" />
                        <RadioButton Classes="segment" GroupName="TransactionTabs" Content="{l:T 'Recurring'}" MinWidth="130"
                                     IsChecked="{Binding IsRecurringTab}" controls:Drag.Target="recurring" />
                        <RadioButton Classes="segment" GroupName="TransactionTabs" Content="{l:T 'Transfers'}" MinWidth="130"
                                     IsChecked="{Binding IsTransfersTab}" IsVisible="{Binding ShowTransfersTab}" />
                    </UniformGrid>
                </Border>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding TransactionsTabTotal}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"
                               Classes.positive="{Binding IsIncomeTab}" />
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding TransactionsTabDetail}" HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Classes="card" Padding="8">
                <DockPanel>
                    <!-- Filters -->
                    <WrapPanel DockPanel.Dock="Top" ItemSpacing="8" LineSpacing="8" Margin="12,12,12,8">
                        <TextBox Text="{Binding SearchText}" PlaceholderText="{l:T 'Search'}" Width="160">
                            <TextBox.InnerLeftContent>
                                <PathIcon Data="{StaticResource IconSearch}" Width="16" Height="16"
                                          Margin="10,0,0,0" Foreground="{DynamicResource TextMuted}" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                        <ComboBox ItemsSource="{Binding PersonFilters}" SelectedItem="{Binding PersonFilter}" Width="120" />
                        <ComboBox ItemsSource="{Binding AccountFilters}" SelectedItem="{Binding AccountFilter}" Width="150"
                                  IsVisible="{Binding HasSeveralAccounts}" />
                        <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding CategoryFilter}" Width="150" />
                        <ComboBox ItemsSource="{Binding ScheduleFilters}" SelectedIndex="{Binding ScheduleFilterIndex}" Width="152"
                                  IsVisible="{Binding ShowScheduleFilter}" />
                        <Button Classes="icon" Command="{Binding ClearFiltersCommand}" ToolTip.Tip="{l:T 'Clear filters'}"
                                VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconClose}" />
                        </Button>
                    </WrapPanel>

                    <!-- Premiums and tax payments are listed on their own pages -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceSunken}" CornerRadius="8"
                            Padding="14,8" Margin="12,4,12,0" IsVisible="{Binding HasMovedExpenses}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Classes="secondary" FontSize="13" Text="{Binding MovedExpensesText}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="secondary" Content="{l:T 'Insurance'}" Command="{Binding ShowInsuranceCommand}" />
                            <Button Grid.Column="2" Classes="secondary" Content="{l:T 'Taxes'}" Command="{Binding ShowTaxesCommand}" />
                        </Grid>
                    </Border>

                    <!-- Totals for the filtered rows -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0"
                            Padding="16,12,16,6" Margin="0,4,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="error" Text="{Binding ErrorMessage}"
                                       IsVisible="{Binding HasError}" />
                            <TextBlock Classes="muted" FontSize="13" Text="{Binding EntriesSummaryText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Column headers -->
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1"
                            Padding="28,10,28,10" Margin="0,4,0,4">
                        <Grid ColumnDefinitions="*,130,110,150,108" ColumnSpacing="16">
                            <controls:SortHeader Label="{l:T 'Description'}" List="transactions" Key="description" Sorts="{Binding ListSorts}" />
                            <controls:SortHeader Grid.Column="1" Label="{l:T 'Person'}" List="transactions" Key="person" Sorts="{Binding ListSorts}" />
                            <controls:SortHeader Grid.Column="2" Label="{l:T 'Date'}" List="transactions" Key="date" Sorts="{Binding ListSorts}" />
                            <controls:SortHeader Grid.Column="3" Label="{l:T 'Amount'}" List="transactions" Key="amount" Sorts="{Binding ListSorts}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Panel>
                        <StackPanel IsVisible="{Binding !HasEntryRows}" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Spacing="12">
                            <TextBlock Classes="secondary" Text="{Binding EntriesEmptyText}" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="360" />
                        </StackPanel>
                        <ListBox Classes="table" ItemsSource="{Binding EntryRows}" IsVisible="{Binding HasEntryRows}"
                                 Margin="12,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:EntryRow">
                                    <Grid ColumnDefinitions="*,130,110,150,108" ColumnSpacing="16" Background="Transparent"
                                          DoubleTapped="EntryRow_DoubleTapped" controls:Drag.Item="{Binding}">
                                        <StackPanel VerticalAlignment="Center" MinWidth="140" ToolTip.Tip="{Binding Description}">
                                            <TextBlock Text="{Binding Description}" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="muted" Text="{Binding DetailText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Classes="pill" Classes.brand="{Binding !IsShared}">
                                            <TextBlock Text="{Binding PersonName}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Classes="secondary" FontSize="13" Text="{Binding DateText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding AmountText}" FontWeight="SemiBold"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Classes.positive="{Binding IsIncome}" />
                                        <Grid Grid.Column="4" ColumnDefinitions="34,34,34" HorizontalAlignment="Right"
                                              VerticalAlignment="Center">
                                            <Button Classes="icon" ToolTip.Tip="{l:T 'Edit'}"
                                                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).EditTransactionCommand}"
                                                    CommandParameter="{Binding Transaction}">
                                                <PathIcon Data="{StaticResource IconEdit}" />
                                            </Button>
                                            <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{l:T 'Stop repeating from today'}"
                                                    IsVisible="{Binding CanStop}"
                                                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).StopTransactionCommand}"
                                                    CommandParameter="{Binding Transaction}">
                                                <PathIcon Data="{StaticResource IconStop}" />
                                            </Button>
                                            <Button Grid.Column="2" Classes="icon danger" ToolTip.Tip="{l:T 'Delete (removes every repeat)'}"
                                                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).DeleteTransactionCommand}"
                                                    CommandParameter="{Binding Transaction}">
                                                <PathIcon Data="{StaticResource IconDelete}" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Panel>
                </DockPanel>
            </Border>

            </Grid>

            <!-- ═══ Documents ═══ -->
            <Border Grid.Row="1" Classes="card" Padding="8" IsVisible="{Binding IsDocumentsPage}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" ItemSpacing="8" LineSpacing="8" Margin="12,12,12,8">
                        <TextBox Text="{Binding DocumentSearch}" PlaceholderText="{l:T 'Search title, sender, notes'}" Width="240">
                            <TextBox.InnerLeftContent>
                                <PathIcon Data="{StaticResource IconSearch}" Width="16" Height="16"
                                          Margin="10,0,0,0" Foreground="{DynamicResource TextMuted}" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                        <ComboBox ItemsSource="{Binding PersonFilters}" SelectedItem="{Binding DocumentPersonFilter}" Width="140" />
                        <ComboBox ItemsSource="{Binding DocumentKindFilters}" SelectedIndex="{Binding DocumentKindFilterIndex}"
                                  Width="130" />
                        <ComboBox ItemsSource="{Binding DocumentStatusFilters}"
                                  SelectedIndex="{Binding DocumentStatusFilterIndex}" Width="130" />
                    </WrapPanel>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0"
                            Padding="16,12,16,6" Margin="0,4,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
                            <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                                       Text="{Binding DocumentsFolderNote}" />
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1"
                            Padding="28,10,28,10" Margin="0,4,0,4">
                        <Grid ColumnDefinitions="*,130,110,190,142" ColumnSpacing="16">
                            <controls:SortHeader Label="{l:T 'Document'}" List="documents" Key="title" Sorts="{Binding ListSorts}" />
                            <controls:SortHeader Grid.Column="1" Label="{l:T 'Person'}" List="documents" Key="person" Sorts="{Binding ListSorts}" />
                            <controls:SortHeader Grid.Column="2" Label="{l:T 'Date'}" List="documents" Key="date" Sorts="{Binding ListSorts}" />
                            <controls:SortHeader Grid.Column="3" Label="{l:T 'To pay'}" List="documents" Key="amount" Sorts="{Binding ListSorts}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Panel>
                        <TextBlock Classes="secondary" Text="{Binding DocumentsEmptyText}" IsVisible="{Binding !HasDocumentRows}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="360" />
                        <ListBox Classes="table" ItemsSource="{Binding DocumentRows}" IsVisible="{Binding HasDocumentRows}"
                                 Margin="12,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:DocumentRow">
                                    <Grid ColumnDefinitions="*,130,110,190,142" ColumnSpacing="16" Background="Transparent"
                                          DoubleTapped="DocumentRow_DoubleTapped" controls:Drag.Item="{Binding}">
                                        <StackPanel VerticalAlignment="Center" MinWidth="140" ToolTip.Tip="{Binding Title}">
                                            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Classes="muted" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="negative" FontSize="12" Text="{l:T 'File not found'}"
                                                           IsVisible="{Binding IsMissing}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" Classes="pill" Classes.brand="{Binding !IsShared}">
                                            <TextBlock Text="{Binding PersonName}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Classes="secondary" FontSize="13" Text="{Binding DateText}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Background="Transparent"
                                                    ToolTip.Tip="{Binding InstalmentTip}">
                                            <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" TextAlignment="Right"
                                                       IsVisible="{Binding HasAmount}" />
                                            <TextBlock FontSize="12" Text="{Binding StatusText}" TextAlignment="Right"
                                                       IsVisible="{Binding HasStatus}" Classes="muted"
                                                       Classes.negative="{Binding IsOverdue}" Classes.positive="{Binding IsPaid}" />
                                        </StackPanel>
                                        <Grid Grid.Column="4" ColumnDefinitions="34,34,34,34" HorizontalAlignment="Right"
                                              VerticalAlignment="Center">
                                            <Button Classes="icon" ToolTip.Tip="{l:T 'Open'}"
                                                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).OpenDocumentCommand}"
                                                    CommandParameter="{Binding Document}">
                                                <PathIcon Data="{StaticResource IconOpen}" />
                                            </Button>
                                            <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{Binding MarkPaidTip}"
                                                    IsVisible="{Binding CanMarkPaid}"
                                                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).MarkDocumentPaidCommand}"
                                                    CommandParameter="{Binding Document}">
                                                <PathIcon Data="{StaticResource IconCheck}" />
                                            </Button>
                                            <Button Grid.Column="2" Classes="icon" ToolTip.Tip="{l:T 'Edit'}"
                                                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).EditDocumentCommand}"
                                                    CommandParameter="{Binding Document}">
                                                <PathIcon Data="{StaticResource IconEdit}" />
                                            </Button>
                                            <Button Grid.Column="3" Classes="icon danger"
                                                    ToolTip.Tip="{l:T 'Delete (moves the file to the Deleted folder)'}"
                                                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).DeleteDocumentCommand}"
                                                    CommandParameter="{Binding Document}">
                                                <PathIcon Data="{StaticResource IconDelete}" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Panel>
                </DockPanel>
            </Border>

            <!-- ═══ Tasks ═══ -->
            <Border Grid.Row="1" Classes="card" Padding="8" IsVisible="{Binding IsTasksPage}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="12,12,12,4">
                        <Grid ColumnDefinitions="*,170,150,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding NewTaskTitle}" PlaceholderText="{l:T 'Add a task, e.g. Renew passport'}">
                                <TextBox.InnerLeftContent>
                                    <PathIcon Data="{StaticResource IconPlus}" Width="16" Height="16"
                                              Margin="10,0,0,0" Foreground="{DynamicResource TextMuted}" />
                                </TextBox.InnerLeftContent>
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding AddTaskCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding NewTaskDueDate}"
                                                PlaceholderText="{l:T 'Due date'}" ToolTip.Tip="{l:T 'Due date (optional)'}" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding PersonOptions}" SelectedItem="{Binding NewTaskPerson}"
                                      ToolTip.Tip="{l:T 'Who does it'}" />
                            <Button Grid.Column="3" Classes="primary" Command="{Binding AddTaskCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconPlus}" />
                                    <TextBlock Text="{l:T 'Add task'}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Classes="error" Text="{Binding NewTaskError}" IsVisible="{Binding HasNewTaskError}" />
                    </StackPanel>

                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,8,12,8">
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <TextBox Text="{Binding TaskSearch}" PlaceholderText="{l:T 'Search tasks'}" Width="220">
                                <TextBox.InnerLeftContent>
                                    <PathIcon Data="{StaticResource IconSearch}" Width="16" Height="16"
                                              Margin="10,0,0,0" Foreground="{DynamicResource TextMuted}" />
                                </TextBox.InnerLeftContent>
                            </TextBox>
                            <ComboBox ItemsSource="{Binding PersonFilters}" SelectedItem="{Binding TaskPersonFilter}" Width="140" />
                            <ComboBox ItemsSource="{Binding TaskStatusFilters}" SelectedIndex="{Binding TaskStatusFilterIndex}"
                                      Width="140" />
                        </WrapPanel>
                        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding TaskCountText}" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                    </Grid>

                    <Border DockPanel.Dock="Bottom" Padding="16,4,16,4" IsVisible="{Binding HasError}">
                        <TextBlock Classes="error" Text="{Binding ErrorMessage}" />
                    </Border>

                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0"
                            Margin="12,0,12,4" />

                    <Panel>
                        <TextBlock Classes="secondary" Text="{Binding TasksEmptyText}" IsVisible="{Binding !HasTaskRows}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="360" />
                        <StackPanel Orientation="Horizontal" Spacing="18" Margin="28,4,28,6" IsVisible="{Binding HasTaskRows}" VerticalAlignment="Top">
                            <TextBlock Classes="columnHeader" Text="{l:T 'Sort by'}" Opacity="0.7" VerticalAlignment="Center" />
                            <controls:SortHeader Label="{l:T 'Title'}" List="tasks" Key="title" Sorts="{Binding ListSorts}" />
                            <controls:SortHeader Label="{l:T 'Person'}" List="tasks" Key="person" Sorts="{Binding ListSorts}" />
                            <controls:SortHeader Label="{l:T 'Due'}" List="tasks" Key="due" Sorts="{Binding ListSorts}" />
                        </StackPanel>
                        <ListBox Classes="table" ItemsSource="{Binding TaskRows}" IsVisible="{Binding HasTaskRows}" Margin="12,30,12,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskRow">
                                    <Grid ColumnDefinitions="Auto,*,130,190,72" ColumnSpacing="16" Background="Transparent"
                                          DoubleTapped="TaskRow_DoubleTapped" controls:Drag.Item="{Binding}" controls:Drag.Target="reorder:tasks" controls:Drag.TargetItem="{Binding}">
                                        <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}" VerticalAlignment="Center"
                                                  ToolTip.Tip="{l:T 'Mark as done'}" MinWidth="0" Padding="0"
                                                  Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).ToggleTaskCommand}"
                                                  CommandParameter="{Binding Task}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="{Binding Title}">
                                            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                       Classes.done="{Binding IsDone}" />
                                            <TextBlock Classes="muted" Text="{Binding NotesPreview}" TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding HasNotes}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Classes="pill" Classes.brand="{Binding !IsShared}">
                                            <TextBlock Text="{Binding PersonName}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock FontSize="13" Text="{Binding DueText}" TextAlignment="Right" Classes="secondary"
                                                       Classes.negative="{Binding IsOverdue}" Classes.warning="{Binding IsDueSoon}"
                                                       Classes.positive="{Binding IsDone}" />
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" IsVisible="{Binding Repeats}">
                                                <PathIcon Data="{StaticResource IconRepeat}" Width="11" Height="11" Foreground="{DynamicResource TextMuted}" />
                                                <TextBlock Classes="muted" FontSize="12" Text="{Binding RepeatText}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid Grid.Column="4" ColumnDefinitions="34,34" HorizontalAlignment="Right"
                                              VerticalAlignment="Center">
                                            <Button Classes="icon" ToolTip.Tip="{l:T 'Edit'}"
                                                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).EditTaskCommand}"
                                                    CommandParameter="{Binding Task}">
                                                <PathIcon Data="{StaticResource IconEdit}" />
                                            </Button>
                                            <Button Grid.Column="1" Classes="icon danger" ToolTip.Tip="{l:T 'Delete'}"
                                                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).DeleteTaskCommand}"
                                                    CommandParameter="{Binding Task}">
                                                <PathIcon Data="{StaticResource IconDelete}" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Panel>
                </DockPanel>
            </Border>

            <!-- ═══ Appointments ═══ -->
            <pages:AppointmentsPage Grid.Row="1" IsVisible="{Binding IsAppointmentsPage}" />

            <!-- ═══ Notes ═══ -->
            <Grid Grid.Row="1" ColumnDefinitions="340,*" ColumnSpacing="16" IsVisible="{Binding IsNotesPage}">
                <Border Classes="card" Padding="8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="8,8,8,10">
                            <TextBox Text="{Binding NoteSearch}" PlaceholderText="{l:T 'Search notes'}">
                                <TextBox.InnerLeftContent>
                                    <PathIcon Data="{StaticResource IconSearch}" Width="16" Height="16"
                                              Margin="10,0,0,0" Foreground="{DynamicResource TextMuted}" />
                                </TextBox.InnerLeftContent>
                            </TextBox>
                            <ComboBox ItemsSource="{Binding NoteProjectFilters}" SelectedItem="{Binding NoteProjectFilter}" />
                        </StackPanel>
                        <Panel>
                            <TextBlock Classes="secondary" Text="{Binding NotesEmptyText}" IsVisible="{Binding !HasNoteItems}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="260" />
                            <ListBox Classes="notes" ItemsSource="{Binding NoteItems}" SelectedItem="{Binding SelectedNoteItem}"
                                     IsVisible="{Binding HasNoteItems}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NoteItem">
                                        <StackPanel Spacing="3">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Classes.muted="{Binding IsUntitled}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                    <PathIcon Data="{StaticResource IconPin}" Width="12" Height="12"
                                                              Foreground="{DynamicResource Brand}" IsVisible="{Binding IsPinned}" />
                                                    <TextBlock Classes="muted" FontSize="12" Text="{Binding UpdatedText}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Classes="secondary" FontSize="13" Text="{Binding Preview}" TextWrapping="Wrap"
                                                       MaxLines="2" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasPreview}" />
                                            <Border Classes="pill brand" HorizontalAlignment="Left" Margin="0,3,0,0"
                                                    IsVisible="{Binding HasProject}">
                                                <TextBlock Text="{Binding Project}" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Panel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Classes="card" Padding="28,22">
                    <Panel>
                        <StackPanel IsVisible="{Binding !IsEditingNote}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="12">
                            <PathIcon Data="{StaticResource IconNote}" Width="36" Height="36" HorizontalAlignment="Center"
                                      Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Classes="secondary" Text="{l:T 'Pick a note on the left, or start a new one.'}"
                                       HorizontalAlignment="Center" />
                            <Button Classes="secondary" HorizontalAlignment="Center" Command="{Binding NewNoteCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconPlus}" />
                                    <TextBlock Text="{l:T 'New note'}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <DockPanel IsVisible="{Binding IsEditingNote}">
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBox x:Name="NoteTitleBox" Classes="bare" Text="{Binding NoteTitle}"
                                         PlaceholderText="{l:T 'Title'}" FontSize="22" FontWeight="Bold" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                    <Button Classes="icon" Classes.active="{Binding NoteIsPinned}"
                                            Command="{Binding ToggleNotePinCommand}" ToolTip.Tip="{l:T 'Pin to the top'}">
                                        <PathIcon Data="{StaticResource IconPin}" />
                                    </Button>
                                    <Button Classes="icon danger" Command="{Binding DeleteNoteCommand}"
                                            ToolTip.Tip="{l:T 'Delete note'}">
                                        <PathIcon Data="{StaticResource IconDelete}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="240,*" ColumnSpacing="12" Margin="0,10,0,14">
                                <AutoCompleteBox Text="{Binding NoteProject}" ItemsSource="{Binding NoteProjects}"
                                                 FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                                                 PlaceholderText="{l:T 'Project (optional)'}" />
                                <TextBlock Grid.Column="1" Classes="muted" FontSize="13" Text="{Binding NoteSaveStatus}"
                                           Classes.negative="{Binding HasNoteSaveError}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0"
                                    Margin="0,0,0,14" />
                            <TextBox Classes="bare" Text="{Binding NoteBody}" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" FontSize="15" LineHeight="23"
                                     PlaceholderText="{l:T 'Write down your thoughts, ideas, plans…'}" />
                        </DockPanel>
                    </Panel>
                </Border>
            </Grid>

            <!-- ═══ Debts ═══ -->
            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" RowSpacing="16" IsVisible="{Binding IsDebtsPage}">
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                    <Border Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Still owed'}" />
                            <TextBlock Classes="value negative" Text="{Binding TotalDebtText}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Payments next month'}" />
                            <TextBlock Classes="value" Text="{Binding MonthlyDebtPaymentsText}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Debt-free by'}" />
                            <TextBlock Classes="value" Text="{Binding DebtFreeText}" />
                            <TextBlock Classes="muted" Text="{l:T 'A payment doesn’t cover its interest'}"
                                       TextWrapping="Wrap" IsVisible="{Binding HasNeverEndingDebt}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Interest still to pay'}" />
                            <TextBlock Classes="value" Text="{Binding DebtInterestText}" />
                            <TextBlock Classes="muted" Text="{l:T 'Excludes debts without a payoff date'}"
                                       TextWrapping="Wrap" IsVisible="{Binding HasDebtWithoutEnd}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="1" Classes="error" Text="{Binding DebtError}"
                           IsVisible="{Binding HasDebtError}" />

                <Panel Grid.Row="2">
                    <Border Classes="card" IsVisible="{Binding !HasDebts}" VerticalAlignment="Top" Padding="32">
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <TextBlock Classes="sectionTitle" Text="{l:T 'No debts yet'}" HorizontalAlignment="Center" />
                            <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                                       Text="{l:T 'Add loans, credit cards or bills you still have to pay. Their payments are added to your plan automatically.'}" />
                            <Button Classes="primary" Content="{l:T 'Add your first debt'}" HorizontalAlignment="Center"
                                    Command="{Binding NewDebtCommand}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer IsVisible="{Binding HasDebts}">
<StackPanel>
<StackPanel Orientation="Horizontal" Spacing="18" Margin="4,0,0,10" IsVisible="{Binding HasDebts}" VerticalAlignment="Top">
                        <TextBlock Classes="columnHeader" Text="{l:T 'Sort by'}" Opacity="0.7" VerticalAlignment="Center" />
                        <controls:SortHeader Label="{l:T 'Name'}" List="debts" Key="name" Sorts="{Binding ListSorts}" />
                        <controls:SortHeader Label="{l:T 'Still owed'}" List="debts" Key="outstanding" Sorts="{Binding ListSorts}" />
                        <controls:SortHeader Label="{l:T 'Paid off'}" List="debts" Key="payoff" Sorts="{Binding ListSorts}" />
                    </StackPanel>

                        <ItemsControl ItemsSource="{Binding Debts}" Margin="0,0,14,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DebtItemViewModel">
                                    <Border Classes="card" Padding="20,18" controls:Drag.Item="{Binding}" controls:Drag.Target="reorder:debts" controls:Drag.TargetItem="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                            <Border Classes="iconTile" VerticalAlignment="Top">
                                                <PathIcon Data="{StaticResource IconCard}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="10">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                                        <TextBlock Classes="muted" FontSize="13" Text="{Binding TermsText}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding OutstandingText}" FontSize="20"
                                                                   FontWeight="Bold" HorizontalAlignment="Right" />
                                                        <TextBlock Classes="muted" Text="{l:T 'still owed'}" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                                <ProgressBar Classes="thin" Value="{Binding PaidPercent}" Maximum="100" />
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Classes="secondary" FontSize="13" Text="{Binding PayoffText}"
                                                                   IsVisible="{Binding !HasPayoffProblem}" />
                                                        <TextBlock Classes="error" Text="{Binding PayoffText}"
                                                                   IsVisible="{Binding HasPayoffProblem}" />
                                                        <TextBlock Classes="muted" Text="{Binding InterestText}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                                VerticalAlignment="Center">
                                                        <Button Classes="secondary" Content="{Binding ExtraPaymentLabel}">
                                                            <Button.Flyout>
                                                                <Flyout Placement="BottomEdgeAlignedRight">
                                                                    <StackPanel Spacing="10" Width="240" Margin="4">
                                                                        <TextBlock Text="{Binding ExtraPaymentTitle}" FontWeight="SemiBold" />
                                                                        <NumericUpDown Value="{Binding ExtraAmount}" Minimum="0"
                                                                                       FormatString="N2" Increment="50"
                                                                                       ShowButtonSpinner="False"
                                                                                       PlaceholderText="{l:T 'Amount'}" />
                                                                        <Button Classes="primary" Content="{l:T 'Record payment'}"
                                                                                HorizontalAlignment="Stretch"
                                                                                Command="{Binding RecordExtraPaymentCommand}" />
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                        <Button Classes="secondary" Content="{l:T 'Borrowed more'}">
                                                            <Button.Flyout>
                                                                <Flyout Placement="BottomEdgeAlignedRight">
                                                                    <StackPanel Spacing="10" Width="260" Margin="4">
                                                                        <TextBlock Text="{l:T 'Borrowed more today'}" FontWeight="SemiBold" />
                                                                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                                                                   Text="{l:T 'The debt grows by this amount and the money counts as cash coming in.'}" />
                                                                        <NumericUpDown Value="{Binding BorrowAmount}" Minimum="0"
                                                                                       FormatString="N2" Increment="100"
                                                                                       ShowButtonSpinner="False"
                                                                                       PlaceholderText="{l:T 'Amount'}" />
                                                                        <Button Classes="primary" Content="{l:T 'Record borrowing'}"
                                                                                HorizontalAlignment="Stretch"
                                                                                Command="{Binding BorrowMoreCommand}" />
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                        <Button Classes="icon" ToolTip.Tip="{l:T 'Edit debt'}"
                                                                Command="{Binding EditCommand}">
                                                            <PathIcon Data="{StaticResource IconEdit}" />
                                                        </Button>
                                                        <Button Classes="icon danger" ToolTip.Tip="{l:T 'Delete debt'}"
                                                                Command="{Binding DeleteCommand}">
                                                            <PathIcon Data="{StaticResource IconDelete}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
</ScrollViewer>
                </Panel>
            </Grid>

            <!-- ═══ Retirement ═══ -->
            <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="16" IsVisible="{Binding IsRetirementPage}">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                    <Border Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Retirement savings'}" />
                            <TextBlock Classes="value" Text="{Binding RetirementSavingsText}" />
                            <TextBlock Classes="muted" FontSize="13" Text="{Binding RetirementSavingsDetail}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Expected pension at 65'}" />
                            <TextBlock Classes="value" Text="{Binding ExpectedPensionText}" />
                            <TextBlock Classes="muted" FontSize="13" Text="{Binding ExpectedPensionDetail}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Pension fund buy-in possible'}" />
                            <TextBlock Classes="value" Text="{Binding BuyInText}" />
                            <TextBlock Classes="muted" FontSize="13" Text="{Binding BuyInDetail}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,350" ColumnSpacing="16" Margin="0,0,0,0">
                    <Border Classes="card" Padding="8">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,160" Margin="16,12,12,8">
                                <TextBlock Classes="sectionTitle" Text="{l:T 'Accounts'}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding PersonFilters}"
                                          SelectedItem="{Binding RetirementPersonFilter}" />
                            </Grid>
                            <Border DockPanel.Dock="Bottom" Padding="16,4" IsVisible="{Binding HasError}">
                                <TextBlock Classes="error" Text="{Binding ErrorMessage}" />
                            </Border>
                            <Panel>
                                <TextBlock Classes="secondary" Text="{Binding RetirementEmptyText}"
                                           IsVisible="{Binding !HasPensionAccounts}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
                                <StackPanel Orientation="Horizontal" Spacing="18" Margin="28,4,28,6" IsVisible="{Binding HasPensionAccounts}" VerticalAlignment="Top">
                                    <TextBlock Classes="columnHeader" Text="{l:T 'Sort by'}" Opacity="0.7" VerticalAlignment="Center" />
                                    <controls:SortHeader Label="{l:T 'Name'}" List="pensionAccounts" Key="name" Sorts="{Binding ListSorts}" />
                                    <controls:SortHeader Label="{l:T 'Person'}" List="pensionAccounts" Key="person" Sorts="{Binding ListSorts}" />
                                    <controls:SortHeader Label="{l:T 'Pillar'}" List="pensionAccounts" Key="pillar" Sorts="{Binding ListSorts}" />
                                    <controls:SortHeader Label="{l:T 'Value'}" List="pensionAccounts" Key="balance" Sorts="{Binding ListSorts}" />
                                </StackPanel>
                                <ListBox Classes="table" ItemsSource="{Binding PensionAccountRows}"
                                         IsVisible="{Binding HasPensionAccounts}" Margin="4,30,4,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PensionAccountRow">
                                            <Grid ColumnDefinitions="*,Auto,106" ColumnSpacing="16" Background="Transparent"
                                                  DoubleTapped="PensionAccountRow_DoubleTapped">
                                                <StackPanel Spacing="5" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Border Classes="pill">
                                                            <TextBlock Text="{Binding PillarText}" />
                                                        </Border>
                                                        <Border Classes="pill" Classes.brand="{Binding !IsShared}">
                                                            <TextBlock Text="{Binding PersonName}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Classes="muted" FontSize="13" Text="{Binding DetailText}"
                                                               TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="150">
                                                    <TextBlock Text="{Binding ValueText}" FontSize="17" FontWeight="SemiBold"
                                                               TextAlignment="Right" Classes.muted="{Binding !HasStatement}" />
                                                    <TextBlock Classes="muted" FontSize="12" Text="{Binding AsOfText}"
                                                               TextAlignment="Right" />
                                                    <TextBlock FontSize="12" Text="{Binding ChangeText}" TextAlignment="Right"
                                                               IsVisible="{Binding HasChange}" Classes="positive"
                                                               Classes.negative="{Binding IsChangeNegative}" />
                                                </StackPanel>
                                                <Grid Grid.Column="2" ColumnDefinitions="34,34,34" HorizontalAlignment="Right"
                                                      VerticalAlignment="Center">
                                                    <Button Classes="icon" ToolTip.Tip="{l:T 'Add statement'}"
                                                            Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).AddStatementToCommand}"
                                                            CommandParameter="{Binding Account}">
                                                        <PathIcon Data="{StaticResource IconPlus}" />
                                                    </Button>
                                                    <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{l:T 'Edit and history'}"
                                                            Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).EditPensionAccountCommand}"
                                                            CommandParameter="{Binding Account}">
                                                        <PathIcon Data="{StaticResource IconEdit}" />
                                                    </Button>
                                                    <Button Grid.Column="2" Classes="icon danger"
                                                            ToolTip.Tip="{l:T 'Delete account (letters stay in Documents)'}"
                                                            Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).DeletePensionAccountCommand}"
                                                            CommandParameter="{Binding Account}">
                                                        <PathIcon Data="{StaticResource IconDelete}" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Panel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" Margin="0,0,-14,0">
                        <StackPanel Spacing="16" Margin="0,0,14,0">
                            <Border Classes="card">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="sectionTitle" Text="{Binding Pillar3aTitle}" />
                                    <ItemsControl ItemsSource="{Binding Pillar3aRows}" IsVisible="{Binding HasPillar3aRows}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="14" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:Pillar3aRow">
                                                <StackPanel Spacing="5">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding PersonName}" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="1" Text="{Binding PaidText}" FontSize="13" />
                                                    </Grid>
                                                    <ProgressBar Classes="thin" Minimum="0" Maximum="100" Value="{Binding Percent}"
                                                                 ToolTip.Tip="{Binding LimitNote}" />
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding StatusText}"
                                                                   Classes.negative="{Binding IsOver}" TextWrapping="Wrap" />
                                                        <Button Grid.Column="1" Classes="link" FontSize="12" Padding="0"
                                                                Content="{l:T 'Add payment'}" IsVisible="{Binding !IsFull}"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).AddPillar3aPaymentCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="muted" FontSize="12" Text="{Binding Pillar3aHint}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="sectionTitle" Text="{l:T 'How it works in Switzerland'}" />
                                    <ItemsControl ItemsSource="{Binding RetirementRules}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid ColumnDefinitions="14,*">
                                                    <TextBlock Classes="muted" Text="•" FontSize="13" />
                                                    <TextBlock Grid.Column="1" Classes="secondary" FontSize="13" Text="{Binding}"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                               Text="{l:T 'A guide, not tax advice. Your letters and your canton’s rules count.'}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ═══ Insurance ═══ -->
            <pages:InsurancePage Grid.Row="1" IsVisible="{Binding IsInsurancePage}" />
            <pages:AssetsPage Grid.Row="1" IsVisible="{Binding IsAssetsPage}" />
            <pages:HouseholdPage Grid.Row="1" IsVisible="{Binding IsHouseholdPage}" />

            <!-- ═══ Taxes ═══ -->
            <pages:TaxesPage Grid.Row="1" IsVisible="{Binding IsTaxesPage}" />

            <!-- ═══ Contracts & dates ═══ -->
            <pages:ContractsPage Grid.Row="1" IsVisible="{Binding IsContractsPage}" />

            <!-- ═══ Planning ═══ -->
            <pages:PlanningPage Grid.Row="1" IsVisible="{Binding IsPlanningPage}" />

            <!-- ═══ Year ═══ -->
            <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="16" IsVisible="{Binding IsYearPage}">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                    <Border Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Income'}" />
                            <TextBlock Classes="value positive" Text="{Binding YearIncomeText}" />
                            <TextBlock Classes="muted" Text="{Binding Report.RangeText}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Expenses'}" />
                            <TextBlock Classes="value negative" Text="{Binding YearExpensesText}" />
                            <TextBlock Classes="muted" Text="{Binding YearPlannedText}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:T 'Net for the year'}" />
                            <TextBlock Classes="value" Text="{Binding YearNetText}" />
                            <TextBlock Classes="muted" Text="{l:T 'Income minus expenses'}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="2*,*" ColumnSpacing="16">
                    <Border Classes="card">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                <TextBlock Classes="sectionTitle" Text="{l:T 'Month by month'}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#10B981" />
                                        <TextBlock Classes="muted" Text="{l:T 'Income'}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#F97066" />
                                        <TextBlock Classes="muted" Text="{l:T 'Expenses'}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#F97066" Opacity="0.35" />
                                        <TextBlock Classes="muted" Text="{l:T 'Planned'}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <controls:MonthlyBarChart Months="{Binding Report.Months}"
                                                      Foreground="{DynamicResource TextMuted}" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="card">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="sectionTitle" Text="{l:T 'Where the money goes'}"
                                       Margin="0,0,0,14" />
                            <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{l:T 'No expenses this year'}"
                                       IsVisible="{Binding !HasCategoryRows}" />
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding CategoryRows}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="14" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CategoryRow">
                                            <StackPanel Spacing="6" Margin="0,0,8,0">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding Category}" FontWeight="Medium"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding AmountText}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="2" Classes="muted" Text="{Binding ShareText}"
                                                               MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <ProgressBar Classes="thin" Value="{Binding Percent}" Maximum="100" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ═══ Settings ═══ -->
            <ScrollViewer Grid.Row="1" IsVisible="{Binding IsSettingsPage}">
                <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

                    <Border Classes="card" Padding="24">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="sectionTitle" Text="{l:T 'Bank accounts'}" />
                                    <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                                               Text="{l:T 'Each account’s balance comes from its starting balance plus its entries. Match it to what your bank shows today, or import a bank statement.'}" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="secondary" Command="{Binding NewBankAccountCommand}" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconPlus}" />
                                        <TextBlock Text="{l:T 'Add account'}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding AccountRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccountRow">
                                        <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="0,10">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                                <Border Classes="iconTile">
                                                    <PathIcon Data="{StaticResource IconBank}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Classes="muted" FontSize="12" Text="{Binding DetailText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BalanceText}" FontWeight="SemiBold" TextAlignment="Right"
                                                               Classes.negative="{Binding IsNegative}" />
                                                    <TextBlock Classes="muted" FontSize="12" Text="{Binding OverdraftText}" TextAlignment="Right"
                                                               IsVisible="{Binding HasOverdraft}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Classes="icon" ToolTip.Tip="{l:T 'Match my bank balance'}">
                                                        <PathIcon Data="{StaticResource IconCheck}" />
                                                        <Button.Flyout>
                                                            <Flyout Placement="BottomEdgeAlignedRight">
                                                                <StackPanel Spacing="10" Width="250" Margin="4">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13"
                                                                               Text="{l:T 'What does your bank show for this account today?'}" />
                                                                    <NumericUpDown FormatString="N2" ShowButtonSpinner="False" PlaceholderText="{Binding BalanceText}"
                                                                                   Value="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).BankBalance}" />
                                                                    <Button Classes="primary" Content="{l:T 'Match'}" HorizontalAlignment="Stretch"
                                                                            Click="MatchAccount_Click" Tag="{Binding Account}" />
                                                                </StackPanel>
                                                            </Flyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                    <Button Classes="icon" ToolTip.Tip="{l:T 'Edit'}"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).EditBankAccountCommand}"
                                                            CommandParameter="{Binding Account}">
                                                        <PathIcon Data="{StaticResource IconEdit}" />
                                                    </Button>
                                                    <Button Classes="icon danger" ToolTip.Tip="{l:T 'Delete'}" IsVisible="{Binding !IsPrimary}"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteBankAccountCommand}"
                                                            CommandParameter="{Binding Account}">
                                                        <PathIcon Data="{StaticResource IconDelete}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="24">
                        <Grid ColumnDefinitions="*,200" ColumnSpacing="24">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="sectionTitle" Text="{l:T 'Language'}" />
                                <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                                           Text="{l:T 'The language of the app, its dates and amounts. Your own entries and documents stay as you wrote them.'}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Classes="card" Padding="24">
                        <Grid ColumnDefinitions="*,200" ColumnSpacing="24">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="sectionTitle" Text="{l:T 'Financial year'}" />
                                <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                                           Text="{l:T 'The month your year starts in. Used for &quot;Saving this year&quot; and the Year page.'}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MonthNames}"
                                      SelectedIndex="{Binding FinancialYearStartIndex}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Reminders -->
                    <Border Classes="card" Padding="24">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Classes="iconTile">
                                    <PathIcon Data="{StaticResource IconBell}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="sectionTitle" Text="{l:T 'Reminders'}" />
                                    <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                                               Text="{l:T 'Notifications for bills due, tasks, insurance notice deadlines and pillar 3a in December. They arrive even when Keystone is closed.'}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsChecked="{Binding RemindersEnabled}" OnContent="" OffContent=""
                                              VerticalAlignment="Top" />
                            </Grid>
                            <Grid ColumnDefinitions="*,140" ColumnSpacing="12" IsVisible="{Binding RemindersEnabled}">
                                <TextBlock Classes="secondary" FontSize="13" Text="{l:T 'Time of day'}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ReminderHourNames}" SelectedIndex="{Binding ReminderHourIndex}" />
                            </Grid>
                            <StackPanel Spacing="6" IsVisible="{Binding RemindersEnabled}">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Coming up'}" IsVisible="{Binding HasUpcomingReminders}" />
                                <ItemsControl ItemsSource="{Binding UpcomingReminders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReminderRow">
                                            <Grid ColumnDefinitions="150,*" ColumnSpacing="12" Margin="0,3">
                                                <TextBlock Classes="muted" FontSize="13" Text="{Binding WhenText}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="muted" FontSize="12" Text="{Binding Body}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Classes="muted" FontSize="13" Text="{Binding ReminderPermissionText}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" Classes.warning="{Binding IsNotificationsDenied}" />
                                <Button Grid.Column="1" Classes="secondary" Content="{l:T 'Open System Settings'}"
                                        Command="{Binding OpenNotificationSettingsCommand}" IsVisible="{Binding IsNotificationsDenied}" />
                                <Button Grid.Column="2" Classes="secondary" Content="{l:T 'Send a test reminder'}"
                                        Command="{Binding SendTestReminderCommand}" IsVisible="{Binding CanSendNotifications}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Calendar -->
                    <Border Classes="card" Padding="24">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Classes="iconTile">
                                    <PathIcon Data="{StaticResource IconAppointment}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="sectionTitle" Text="{l:T 'Calendar sync'}" />
                                    <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                                               Text="{l:T 'Keeps your appointments in step with a calendar in the Calendar app, both ways: what you add or change in Keystone shows there, and what you add or change there shows here. With an iCloud or Google calendar, also on your iPhone.'}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsCalendarSyncEnabled}" IsEnabled="{Binding CanUseCalendar}"
                                              OnContent="" OffContent="" VerticalAlignment="Top" />
                            </Grid>
                            <Grid ColumnDefinitions="*,280" ColumnSpacing="12" IsVisible="{Binding ShowsCalendarChoice}">
                                <TextBlock Classes="secondary" FontSize="13" Text="{l:T 'Calendar'}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding CalendarOptions}" SelectedItem="{Binding SelectedCalendar}"
                                          PlaceholderText="{l:T 'Choose a calendar'}" HorizontalAlignment="Stretch" />
                            </Grid>
                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding ShowsCalendarChoice}"
                                       Text="{l:T 'Appointments from 30 days ago to a year ahead are compared. Deleting an appointment in one place deletes it in the other. A calendar of its own keeps household appointments apart from work.'}" />
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="{Binding CalendarPermissionText}" Classes.warning="{Binding IsCalendarDenied}" />
                                <Button Grid.Column="1" Classes="secondary" Content="{l:T 'Open System Settings'}"
                                        Command="{Binding OpenCalendarSettingsCommand}" IsVisible="{Binding IsCalendarDenied}" />
                                <Button Grid.Column="2" Classes="secondary" Command="{Binding CreateKeystoneCalendarCommand}"
                                        IsVisible="{Binding ShowsCalendarChoice}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconPlus}" />
                                        <TextBlock Text="{l:T 'New “Keystone” calendar'}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Classes="error" FontSize="13" TextWrapping="Wrap" Text="{Binding CalendarSyncError}"
                                       IsVisible="{Binding HasCalendarSyncError}" />
                        </StackPanel>
                    </Border>

                    <!-- App lock -->
                    <Border Classes="card" Padding="24">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Classes="iconTile">
                                    <PathIcon Data="{StaticResource IconLock}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="sectionTitle" Text="{l:T 'App lock'}" />
                                    <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                                               Text="{l:T 'Ask for Touch ID or your Mac password when Keystone opens and after time away.'}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsLockEnabled}" IsEnabled="{Binding CanLock}"
                                              OnContent="" OffContent="" VerticalAlignment="Top" />
                            </Grid>
                            <Grid ColumnDefinitions="*,240" ColumnSpacing="12" IsVisible="{Binding IsLockEnabled}">
                                <TextBlock Classes="secondary" FontSize="13" Text="{l:T 'Lock again'}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding LockDelayNames}" SelectedIndex="{Binding LockDelayIndex}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Backup -->
                    <Border Classes="card" Padding="24">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Classes="iconTile">
                                    <PathIcon Data="{StaticResource IconCloud}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="sectionTitle" Text="{l:T 'Backup'}" />
                                    <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Text="{Binding BackupNote}" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Classes="secondary" FontSize="13" Text="{Binding BackupStatusText}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                                <Button Grid.Column="1" Classes="secondary" Content="{l:T 'Back up now'}" Command="{Binding BackUpNowCommand}" />
                                <Button Grid.Column="2" Classes="secondary" Content="{l:T 'Open folder'}" Command="{Binding OpenBackupsFolderCommand}" />
                                <Button Grid.Column="3" Classes="secondary" Content="{l:T 'Restore…'}" Click="RestoreBackup_Click" />
                            </Grid>
                            <Border Background="{DynamicResource WarningSoft}" CornerRadius="10" Padding="14"
                                    IsVisible="{Binding HasRestoreCandidate}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding RestoreQuestion}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="primary" Content="{l:T 'Restore'}" Command="{Binding RestoreBackupCommand}" />
                                        <Button Classes="secondary" Content="{l:T 'Cancel'}" Command="{Binding CancelRestoreCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Classes="error" Text="{Binding BackupError}" IsVisible="{Binding HasBackupError}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="24">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="sectionTitle" Text="{l:T 'Household'}" />
                                <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                                           Text="{l:T 'Tie income and expenses to a person. Entries without one are shared. Removing a person keeps their entries as shared; their medicines, jobs and sick days are removed with them.'}" />
                                <Button Classes="link" Command="{Binding OpenHouseholdCommand}" Content="{l:T 'Details, health and work of each person are on the Household page →'}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding People}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Person">
                                        <Border Background="{DynamicResource SurfaceSunken}" CornerRadius="10" Padding="10,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border Width="32" Height="32" CornerRadius="16"
                                                        Background="{DynamicResource BrandSoft}">
                                                    <TextBlock Text="{Binding Name, Converter={x:Static vm:Format.InitialConverter}}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontWeight="Bold" Foreground="{DynamicResource BrandText}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="2" Classes="icon danger" ToolTip.Tip="{l:T 'Remove'}"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeletePersonCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="{StaticResource IconDelete}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding NewPersonName}" PlaceholderText="{l:T 'Name, e.g. Anna'}">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding AddPersonCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="1" Classes="secondary" Command="{Binding AddPersonCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconPlus}" />
                                        <TextBlock Text="{l:T 'Add person'}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Classes="error" Text="{Binding HouseholdError}" IsVisible="{Binding HasHouseholdError}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="24">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="sectionTitle" Text="{l:T 'Documents folder'}" />
                                <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                                           Text="{l:T 'Bills, letters and notices are filed here as Person / Year / Type. Use a OneDrive folder to keep them backed up and available on your phone.'}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding DocumentsFolder}" IsReadOnly="True" />
                                <Button Grid.Column="1" Classes="secondary" Content="{l:T 'Change…'}" Click="ChangeDocumentsFolder_Click" />
                                <Button Grid.Column="2" Classes="secondary" Content="{l:T 'Use default'}"
                                        Command="{Binding ResetDocumentsFolderCommand}"
                                        IsVisible="{Binding !IsDefaultDocumentsFolder}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <PathIcon Data="{StaticResource IconInbox}" Width="18" Height="18" Foreground="{DynamicResource Brand}" />
                                <TextBlock Grid.Column="1" Classes="secondary" FontSize="13" TextWrapping="Wrap" Text="{Binding InboxNote}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="2" Classes="secondary" Content="{l:T 'Open inbox'}" Command="{Binding OpenInboxFolderCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="24">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="sectionTitle" Text="{l:T 'Local AI'}" />
                                    <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                                               Text="{l:T 'Reads dropped bills, payslips and statements to suggest income and expenses, and fills in a document’s details when you add it. It runs an open-source model on this Mac with Ollama, so documents never leave your computer.'}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsImportEnabled}" VerticalAlignment="Top"
                                              OnContent="{l:T 'On'}" OffContent="{l:T 'Off'}" />
                            </Grid>
                            <StackPanel Spacing="14" IsVisible="{Binding IsImportEnabled}">
                                <Border Background="{DynamicResource SurfaceSunken}" CornerRadius="10" Padding="14,10">
                                    <StackPanel Spacing="4">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{l:T 'One-time setup'}" />
                                        <TextBlock Classes="secondary" FontSize="13" TextWrapping="Wrap"
                                                   Text="{l:T 'Run Ollama with Docker from the project folder, then download the model:'}" />
                                        <SelectableTextBlock Text="docker compose up -d" FontFamily="Menlo,monospace" FontSize="13" />
                                        <SelectableTextBlock Text="{Binding AiSetupCommand}" FontFamily="Menlo,monospace" FontSize="13" />
                                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                                   Text="{l:T 'Or install the Ollama app from ollama.com, which is faster on Apple Silicon because it can use the GPU.'}" />
                                    </StackPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="{l:T 'Ollama address'}" />
                                        <TextBox Text="{Binding AiEndpoint}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="{l:T 'Model'}" />
                                        <ComboBox ItemsSource="{Binding InstalledModels}" Text="{Binding AiModel}" IsEditable="True"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="primary" Content="{l:T 'Save and test'}" VerticalAlignment="Bottom"
                                            Command="{Binding SaveAiSettingsCommand}" />
                                </Grid>
                                <TextBlock Text="{Binding AiStatus}" TextWrapping="Wrap" FontSize="13" IsVisible="{Binding HasAiStatus}"
                                           Classes="positive" Classes.negative="{Binding AiStatusIsError}"
                                           Classes.positive="{Binding !AiStatusIsError}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="24">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="sectionTitle" Text="{l:T 'Your data'}" />
                            <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                                       Text="{l:T 'Everything is stored on this Mac only, in:'}" />
                            <SelectableTextBlock Text="{Binding DatabasePath}" FontSize="13"
                                                 Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════════ Side panel ═══════════════ -->
        <Panel Grid.ColumnSpan="2" IsVisible="{Binding IsPanelOpen}">
            <Border Background="{DynamicResource Backdrop}" PointerPressed="Backdrop_PointerPressed" />

            <!-- Entry form -->
            <Border Classes="panel" Width="440" HorizontalAlignment="Right" IsVisible="{Binding IsEntryPanelOpen}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="28,24,20,8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding FormTitle}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Classes="muted" FontSize="13" Text="{l:T 'Changes apply to every repeat of this entry'}"
                                       IsVisible="{Binding IsEditing}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon" Command="{Binding ClosePanelCommand}" ToolTip.Tip="{l:T 'Close (Esc)'}"
                                VerticalAlignment="Top">
                            <PathIcon Data="{StaticResource IconClose}" />
                        </Button>
                    </Grid>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0"
                            Padding="28,16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Button Classes="primary" Content="{Binding SubmitText}" HorizontalAlignment="Stretch"
                                    IsDefault="True" Command="{Binding SaveTransactionCommand}" />
                            <Button Grid.Column="1" Classes="secondary" Content="{l:T 'Cancel'}"
                                    Command="{Binding ClosePanelCommand}" />
                        </Grid>
                    </Border>

                    <ScrollViewer>
                        <StackPanel Spacing="18" Margin="28,12,28,20">
                            <Border Classes="segments" IsVisible="{Binding !HasSeveralAccounts}">
                                <Grid ColumnDefinitions="*,*">
                                    <RadioButton Classes="segment" GroupName="EntryType" Content="{l:T 'Expense'}"
                                                 IsChecked="{Binding NewIsExpense}" />
                                    <RadioButton Grid.Column="1" Classes="segment" GroupName="EntryType" Content="{l:T 'Income'}"
                                                 IsChecked="{Binding NewIsIncome}" />
                                </Grid>
                            </Border>
                            <Border Classes="segments" IsVisible="{Binding HasSeveralAccounts}">
                                <Grid ColumnDefinitions="*,*,*">
                                    <RadioButton Classes="segment" GroupName="EntryType3" Content="{l:T 'Expense'}"
                                                 IsChecked="{Binding NewIsExpense}" />
                                    <RadioButton Grid.Column="1" Classes="segment" GroupName="EntryType3" Content="{l:T 'Income'}"
                                                 IsChecked="{Binding NewIsIncome}" />
                                    <RadioButton Grid.Column="2" Classes="segment" GroupName="EntryType3" Content="{l:T 'Transfer'}"
                                                 IsChecked="{Binding NewIsTransfer}" />
                                </Grid>
                            </Border>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding HasSeveralAccounts}">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{Binding AccountLabel}" />
                                    <ComboBox ItemsSource="{Binding AccountOptions}" SelectedItem="{Binding NewAccount}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" IsVisible="{Binding NewIsTransfer}">
                                    <TextBlock Classes="fieldLabel" Text="{l:T 'To account'}" />
                                    <ComboBox ItemsSource="{Binding AccountOptions}" SelectedItem="{Binding NewToAccount}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Description'}" />
                                <TextBox Text="{Binding NewDescription}" PlaceholderText="{l:T 'e.g. Apartment rent'}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{l:T 'Amount'}" />
                                    <NumericUpDown Value="{Binding NewAmount}" Minimum="0" FormatString="N2"
                                                   Increment="10" PlaceholderText="0.00" ShowButtonSpinner="False" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{l:T 'Person'}" />
                                    <ComboBox ItemsSource="{Binding PersonOptions}" SelectedItem="{Binding NewPerson}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="4" IsVisible="{Binding !NewIsTransfer}">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Category'}" />
                                <ComboBox ItemsSource="{Binding CategoryOptions}" Text="{Binding NewCategory}"
                                          IsEditable="True" PlaceholderText="{l:T 'Choose or type a category'}" />
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'How often'}" />
                                <Border Classes="segments">
                                    <Grid ColumnDefinitions="*,*,*,*">
                                        <RadioButton Classes="segment" GroupName="EntryRecurrence" Content="{l:T 'Once'}"
                                                     IsChecked="{Binding NewIsOneTime}" />
                                        <RadioButton Grid.Column="1" Classes="segment" GroupName="EntryRecurrence"
                                                     Content="{l:T 'Monthly'}" IsChecked="{Binding NewIsMonthly}" />
                                        <RadioButton Grid.Column="2" Classes="segment" GroupName="EntryRecurrence"
                                                     Content="{l:T 'Quarterly'}" IsChecked="{Binding NewIsQuarterly}" />
                                        <RadioButton Grid.Column="3" Classes="segment" GroupName="EntryRecurrence"
                                                     Content="{l:T 'Yearly'}" IsChecked="{Binding NewIsYearly}" />
                                    </Grid>
                                </Border>
                                <TextBlock Classes="muted" Text="{Binding RecurrenceHint}" TextWrapping="Wrap"
                                           IsVisible="{Binding NewIsRecurring}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{Binding DateLabel}" TextTrimming="CharacterEllipsis" />
                                    <CalendarDatePicker SelectedDate="{Binding NewDate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" IsVisible="{Binding NewIsRecurring}">
                                    <TextBlock Classes="fieldLabel" Text="{l:T 'Ends on (optional)'}" />
                                    <CalendarDatePicker SelectedDate="{Binding NewEndDate}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

                            <Border IsVisible="{Binding CanChangeOneTime}" Padding="16,14" CornerRadius="10"
                                    Background="{DynamicResource SurfaceSunken}">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{l:T 'Change one time only'}" FontWeight="SemiBold" />
                                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                                   Text="{l:T 'A 13th salary, a bonus, a smaller bill or a month without it. The other times stay as they are.'}" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="fieldLabel" Text="{l:T 'When'}" />
                                            <ComboBox ItemsSource="{Binding ChangeDateOptions}" SelectedItem="{Binding ChangeDate}"
                                                      HorizontalAlignment="Stretch" MaxDropDownHeight="320" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Classes="fieldLabel" Text="{l:T 'Amount this time'}" />
                                            <NumericUpDown Value="{Binding ChangeAmount}" Minimum="0" FormatString="N2"
                                                           ShowButtonSpinner="False" IsEnabled="{Binding ChangeAmountEnabled}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBox Text="{Binding ChangeNote}" PlaceholderText="{l:T 'Note (optional), e.g. 13th salary'}" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <CheckBox Content="{l:T 'Skip this time'}" IsChecked="{Binding ChangeSkip}" />
                                        <Button Grid.Column="1" Classes="secondary" Content="{l:T 'Save for this time'}"
                                                Command="{Binding SaveEntryChangeCommand}" />
                                    </Grid>
                                    <TextBlock Classes="error" Text="{Binding ChangeError}" IsVisible="{Binding HasChangeError}"
                                               TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding EntryChangeRows}" IsVisible="{Binding HasEntryChanges}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:EntryChangeRow">
                                                <Grid ColumnDefinitions="100,*,Auto" ColumnSpacing="8" Margin="0,2">
                                                    <TextBlock Classes="secondary" FontSize="13" Text="{Binding DateText}"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock FontSize="13" Text="{Binding AmountText}" TextWrapping="Wrap" />
                                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Note}"
                                                                   IsVisible="{Binding HasNote}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Classes="icon danger" ToolTip.Tip="{l:T 'Back to the usual'}"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveEntryChangeCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{StaticResource IconDelete}" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !IsEditing}"
                                       Text="{l:T 'The panel stays open after adding, so you can enter several in a row.'}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Debt form -->
            <Border Classes="panel" Width="440" HorizontalAlignment="Right" IsVisible="{Binding IsDebtPanelOpen}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="28,24,20,8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding DebtFormTitle}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                                       Text="{l:T 'Payments are added to your expenses automatically. Don’t also enter them as entries.'}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon" Command="{Binding ClosePanelCommand}" ToolTip.Tip="{l:T 'Close (Esc)'}"
                                VerticalAlignment="Top">
                            <PathIcon Data="{StaticResource IconClose}" />
                        </Button>
                    </Grid>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0"
                            Padding="28,16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Button Classes="primary" Content="{Binding DebtSubmitText}" HorizontalAlignment="Stretch"
                                    Command="{Binding AddDebtCommand}" />
                            <Button Grid.Column="1" Classes="secondary" Content="{l:T 'Cancel'}"
                                    Command="{Binding ClosePanelCommand}" />
                        </Grid>
                    </Border>

                    <ScrollViewer>
                        <StackPanel Spacing="18" Margin="28,12,28,20">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Name'}" />
                                <TextBox Text="{Binding NewDebtName}" PlaceholderText="{l:T 'e.g. Car loan'}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{Binding DebtBalanceLabel}" />
                                <NumericUpDown Value="{Binding NewDebtBalance}" Minimum="0" FormatString="N2"
                                               Increment="100" PlaceholderText="0.00" ShowButtonSpinner="False" />
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'How it’s repaid'}" />
                                <Border Classes="segments">
                                    <Grid ColumnDefinitions="*,*,*">
                                        <RadioButton Classes="segment" GroupName="DebtRepayment" Content="{l:T 'Monthly'}"
                                                     IsChecked="{Binding NewDebtIsMonthly}" />
                                        <RadioButton Grid.Column="1" Classes="segment" GroupName="DebtRepayment"
                                                     Content="{l:T 'All at once'}" IsChecked="{Binding NewDebtIsLumpSum}" />
                                        <RadioButton Grid.Column="2" Classes="segment" GroupName="DebtRepayment"
                                                     Content="{l:T 'Interest only'}" IsChecked="{Binding NewDebtIsInterestOnly}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="4" IsVisible="{Binding NewDebtIsNotInterestOnly}">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Interest rate per year (%)'}" />
                                <NumericUpDown Value="{Binding NewDebtRate}" Minimum="0" Maximum="100"
                                               FormatString="0.##" Increment="0.25" />
                            </StackPanel>
                            <StackPanel Spacing="4" IsVisible="{Binding NewDebtIsInterestOnly}">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Interest per 1,000 per month'}" />
                                <NumericUpDown Value="{Binding NewDebtInterestPer1000}" Minimum="0"
                                               FormatString="0.##" Increment="5" PlaceholderText="e.g. 25" />
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           Text="{l:T 'Interest is paid monthly on what you still owe. Use Repay on the debt whenever you pay back part of it.'}" />
                            </StackPanel>
                            <StackPanel Spacing="4" IsVisible="{Binding !NewDebtIsLumpSum}">
                                <TextBlock Classes="fieldLabel" Text="{Binding DebtPaymentLabel}" />
                                <NumericUpDown Value="{Binding NewDebtPayment}" Minimum="0" FormatString="N2"
                                               Increment="10" PlaceholderText="0.00" ShowButtonSpinner="False" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{Binding DebtDateLabel}" />
                                <CalendarDatePicker SelectedDate="{Binding NewDebtDate}" />
                            </StackPanel>

                            <StackPanel Spacing="6" IsVisible="{Binding HasDebtPaymentRows}">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Extra payments and borrowing'}" />
                                <ItemsControl ItemsSource="{Binding DebtPaymentRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DebtPaymentRow">
                                            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8" Margin="0,2">
                                                <TextBlock Classes="secondary" FontSize="13" Text="{Binding DateText}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" FontSize="13" Text="{Binding Text}" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Classes="icon danger" ToolTip.Tip="{l:T 'Remove'}"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveDebtPaymentCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="{StaticResource IconDelete}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Classes="error" Text="{Binding DebtError}" IsVisible="{Binding HasDebtError}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Import review -->
            <Border Classes="panel" Width="620" HorizontalAlignment="Right" IsVisible="{Binding IsImportPanelOpen}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="28,24,20,8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{l:T 'Import document'}" FontSize="20" FontWeight="Bold" IsVisible="{Binding !IsBankImport}" />
                            <TextBlock Text="{l:T 'Import bank statement'}" FontSize="20" FontWeight="Bold" IsVisible="{Binding IsBankImport}" />
                            <TextBlock Classes="muted" FontSize="13" Text="{Binding ImportFileName}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon" Command="{Binding ClosePanelCommand}" ToolTip.Tip="{l:T 'Close (Esc)'}"
                                VerticalAlignment="Top">
                            <PathIcon Data="{StaticResource IconClose}" />
                        </Button>
                    </Grid>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0"
                            Padding="28,16">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        IsVisible="{Binding HasImportItems}">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Person'}" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding PersonOptions}" SelectedItem="{Binding ImportPerson}" MinWidth="130" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="primary" Content="{Binding AddImportedText}"
                                    HorizontalAlignment="Stretch" IsVisible="{Binding HasImportItems}"
                                    IsEnabled="{Binding CanAddImported}" Command="{Binding AddImportedCommand}" />
                            <Button Grid.Column="2" Classes="secondary" Content="{l:T 'Cancel'}"
                                    Command="{Binding ClosePanelCommand}" />
                        </Grid>
                    </Border>

                    <ScrollViewer>
                        <StackPanel Spacing="12" Margin="28,12,28,20">
                            <StackPanel Spacing="10" IsVisible="{Binding IsImporting}" Margin="0,24">
                                <ProgressBar Classes="thin" IsIndeterminate="True" />
                                <TextBlock Classes="secondary" Text="{Binding ImportStatus}" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>

                            <TextBlock Classes="error" Text="{Binding ImportError}" IsVisible="{Binding HasImportError}"
                                       TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding IsBankImport}">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Account'}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AccountOptions}" SelectedItem="{Binding ImportAccount}"
                                          HorizontalAlignment="Stretch" />
                            </Grid>
                            <CheckBox IsChecked="{Binding ImportMatchBalance}" IsVisible="{Binding HasImportBalance}">
                                <TextBlock Text="{Binding ImportBalanceText}" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Classes="muted" Text="{Binding ImportNote}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasImportItems}"
                                       Text="{l:T 'Check what was found. Untick anything you don’t want, and fix the details before adding.'}" />

                            <Border Background="{DynamicResource SurfaceSunken}" CornerRadius="10" Padding="14,12"
                                    IsVisible="{Binding HasImportItems}">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="fieldLabel" Text="{l:T 'Tick'}" />
                                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                                        <Button Classes="secondary" Content="{l:T 'All'}" Command="{Binding SelectImportedCommand}"
                                                CommandParameter="all" />
                                        <Button Classes="secondary" Content="{Binding ImportExpensesOnlyText}"
                                                Command="{Binding SelectImportedCommand}" CommandParameter="expenses" />
                                        <Button Classes="secondary" Content="{Binding ImportIncomeOnlyText}"
                                                Command="{Binding SelectImportedCommand}" CommandParameter="income" />
                                        <Button Classes="secondary" Content="{l:T 'None'}" Command="{Binding SelectImportedCommand}"
                                                CommandParameter="none" />
                                    </WrapPanel>
                                    <TextBlock Classes="muted" FontSize="12" Text="{Binding ImportSelectionText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding ImportItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ImportItem">
                                        <Border Background="{DynamicResource SurfaceSunken}" CornerRadius="10" Padding="12">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                                <StackPanel Grid.Column="1" Spacing="8">
                                                    <Grid ColumnDefinitions="*,120" ColumnSpacing="8">
                                                        <TextBox Text="{Binding Description}" PlaceholderText="{l:T 'Description'}" />
                                                        <NumericUpDown Grid.Column="1" Value="{Binding Amount}" Minimum="0"
                                                                       FormatString="N2" ShowButtonSpinner="False" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="100,128,118,*" ColumnSpacing="8">
                                                        <ComboBox ItemsSource="{Binding TypeNames}"
                                                                  SelectedIndex="{Binding TypeIndex}" HorizontalAlignment="Stretch" />
                                                        <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding Date}"
                                                                            HorizontalAlignment="Stretch" />
                                                        <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:ImportItem.RecurrenceNames}"
                                                                  SelectedIndex="{Binding RecurrenceIndex}" HorizontalAlignment="Stretch" />
                                                        <ComboBox Grid.Column="3" ItemsSource="{Binding CategoryOptions}"
                                                                  Text="{Binding Category}" IsEditable="True" IsVisible="{Binding IsNotTransfer}"
                                                                  PlaceholderText="{l:T 'Category'}" HorizontalAlignment="Stretch" />
                                                        <ComboBox Grid.Column="3" IsVisible="{Binding IsTransfer}" HorizontalAlignment="Stretch"
                                                                  ItemsSource="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).AccountOptions}"
                                                                  SelectedItem="{Binding CounterAccount}" ToolTip.Tip="{l:T 'The other account'}" />
                                                    </Grid>
                                                    <Border Classes="pill" HorizontalAlignment="Left" IsVisible="{Binding IsDuplicate}">
                                                        <TextBlock Text="{l:T 'Looks like an entry you already have'}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Document form -->
            <Border Classes="panel" Width="460" HorizontalAlignment="Right" IsVisible="{Binding IsDocumentPanelOpen}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="28,24,20,8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding DocumentFormTitle}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Classes="muted" FontSize="13" Text="{Binding DocumentFileName}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon" Command="{Binding ClosePanelCommand}" ToolTip.Tip="{l:T 'Close (Esc)'}"
                                VerticalAlignment="Top">
                            <PathIcon Data="{StaticResource IconClose}" />
                        </Button>
                    </Grid>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0"
                            Padding="28,16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Button Classes="primary" Content="{Binding DocumentSubmitText}" HorizontalAlignment="Stretch"
                                    Command="{Binding SaveDocumentCommand}" />
                            <Button Grid.Column="1" Classes="secondary" Content="{l:T 'Cancel'}"
                                    Command="{Binding ClosePanelCommand}" />
                        </Grid>
                    </Border>

                    <ScrollViewer>
                        <StackPanel Spacing="18" Margin="28,12,28,20">
                            <Border Background="{DynamicResource WarningSoft}" CornerRadius="10" Padding="14,12"
                                    IsVisible="{Binding HasDocumentDuplicate}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding DocumentDuplicateText}" TextWrapping="Wrap" FontWeight="Medium" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="secondary" Content="{l:T 'Show it'}" Command="{Binding ShowDuplicateDocumentCommand}" />
                                        <Button Classes="secondary" Content="{l:T 'Skip this file'}" Command="{Binding SkipDuplicateDocumentCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="8" IsVisible="{Binding HasDocumentAiStatus}">
                                <ProgressBar Classes="thin" IsIndeterminate="True" IsVisible="{Binding IsDocumentAiBusy}" />
                                <TextBlock Classes="muted" Text="{Binding DocumentAiStatus}" TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{l:T 'Type'}" />
                                    <ComboBox ItemsSource="{Binding DocumentKindNames}" SelectedIndex="{Binding DocumentKindIndex}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{l:T 'Person'}" />
                                    <ComboBox ItemsSource="{Binding PersonOptions}" SelectedItem="{Binding DocumentPerson}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Title'}" />
                                <TextBox Text="{Binding DocumentTitle}" PlaceholderText="{l:T 'e.g. Health insurance premium 2027'}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{l:T 'From'}" />
                                    <TextBox Text="{Binding DocumentSender}" PlaceholderText="{l:T 'e.g. Helsana'}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{l:T 'Document date'}" />
                                    <CalendarDatePicker SelectedDate="{Binding DocumentDate}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource SurfaceSunken}" CornerRadius="10" Padding="14"
                                    IsVisible="{Binding DocumentIsPayable}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="fieldLabel" Text="{l:T 'Amount to pay'}" />
                                            <NumericUpDown Value="{Binding DocumentAmount}" Minimum="0" FormatString="N2"
                                                           PlaceholderText="0.00" ShowButtonSpinner="False" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Classes="fieldLabel" Text="{l:T 'Due on'}" />
                                            <CalendarDatePicker SelectedDate="{Binding DocumentDueDate}"
                                                                HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="12,10"
                                            IsVisible="{Binding HasPaymentDetails}">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <PathIcon Data="{StaticResource IconQr}" Width="16" Height="16" Foreground="{DynamicResource Brand}" />
                                                <TextBlock Grid.Column="1" Classes="fieldLabel" Text="{l:T 'Payment details'}" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Classes="link" FontSize="12" Padding="0" Content="{l:T 'Copy all'}"
                                                        Command="{Binding CopyAllPaymentDetailsCommand}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="70,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                                <TextBlock Classes="muted" FontSize="12" Text="{l:T 'Account'}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding DocumentPaymentIban}" FontFamily="Menlo, monospace" FontSize="12" />
                                                <Button Grid.Column="2" Classes="icon" ToolTip.Tip="{l:T 'Copy'}"
                                                        Command="{Binding CopyPaymentTextCommand}" CommandParameter="{Binding DocumentPaymentIban}">
                                                    <PathIcon Data="{StaticResource IconCopy}" />
                                                </Button>
                                                <TextBlock Grid.Row="1" Classes="muted" FontSize="12" Text="{l:T 'Reference'}" VerticalAlignment="Center" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DocumentPaymentReference}" FontFamily="Menlo, monospace" FontSize="12" />
                                                <Button Grid.Row="1" Grid.Column="2" Classes="icon" ToolTip.Tip="{l:T 'Copy'}"
                                                        Command="{Binding CopyPaymentTextCommand}" CommandParameter="{Binding DocumentPaymentReference}">
                                                    <PathIcon Data="{StaticResource IconCopy}" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <CheckBox IsChecked="{Binding DocumentIsPaid}" Content="{l:T 'Already paid'}"
                                              IsVisible="{Binding CanTickDocumentPaid}" />
                                    <CheckBox IsChecked="{Binding DocumentPaysInInstalments}" IsVisible="{Binding CanPayDocumentInInstalments}"
                                              Content="{l:T 'Pay in instalments'}"
                                              ToolTip.Tip="{l:T 'For a bill too big to pay at once, e.g. taxes you agreed to pay in parts'}" />
                                    <StackPanel Spacing="10" IsVisible="{Binding DocumentPaysInInstalments}">
                                        <Grid ColumnDefinitions="*,*,1.4*" ColumnSpacing="10">
                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="fieldLabel" Text="{l:T 'Instalments'}" />
                                                <NumericUpDown Value="{Binding InstalmentCount}" Minimum="2" Maximum="36" Increment="1"
                                                               FormatString="0" MinWidth="0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Classes="fieldLabel" Text="{l:T 'Every … months'}" />
                                                <NumericUpDown Value="{Binding InstalmentEveryMonths}" Minimum="1" Maximum="12" Increment="1"
                                                               FormatString="0" MinWidth="0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock Classes="fieldLabel" Text="{l:T 'First one on'}" />
                                                <CalendarDatePicker SelectedDate="{Binding InstalmentFirstDate}" HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding InstalmentRows}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:InstalmentRow">
                                                    <Grid ColumnDefinitions="26,*,110,Auto" ColumnSpacing="8">
                                                        <TextBlock Classes="muted" Text="{Binding NumberText}" VerticalAlignment="Center" />
                                                        <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding DueDate}"
                                                                            HorizontalAlignment="Stretch" IsEnabled="{Binding !IsPaid}" />
                                                        <NumericUpDown Grid.Column="2" Value="{Binding Amount}" Minimum="0" FormatString="N2"
                                                                       ShowButtonSpinner="False" MinWidth="0" IsEnabled="{Binding !IsPaid}" />
                                                        <CheckBox Grid.Column="3" IsChecked="{Binding IsPaid}" Content="{l:T 'Paid'}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Classes="secondary" FontSize="12" Text="{Binding InstalmentSummaryText}" />
                                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding InstalmentDifferenceText}"
                                                   IsVisible="{Binding HasInstalmentDifference}" />
                                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                                   Text="{l:T 'Each instalment is reminded on its own date. Changing the number, the months between or the first date shares out again what isn’t paid yet.'}" />
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding DocumentCreateEntry}" IsVisible="{Binding CanCreateDocumentEntry}">
                                        <TextBlock Text="{Binding DocumentCreateEntryText}" TextWrapping="Wrap" />
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Notes'}" />
                                <TextBox Text="{Binding DocumentNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                                         PlaceholderText="{l:T 'Anything to remember, e.g. reference number'}" />
                            </StackPanel>

                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding DocumentRetentionText}"
                                       IsVisible="{Binding IsEditingDocument}" />

                            <Border Background="{DynamicResource BrandSoft}" CornerRadius="10" Padding="14,12"
                                    IsVisible="{Binding HasDocumentFollowUp}">
                                <StackPanel Spacing="4">
                                    <CheckBox IsChecked="{Binding DocumentAddFollowUp}">
                                        <TextBlock Text="{Binding DocumentFollowUpText}" TextWrapping="Wrap" FontWeight="Medium" />
                                    </CheckBox>
                                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="28,0,0,0"
                                               Text="{Binding DocumentFollowUpNote}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Classes="error" Text="{Binding DocumentError}" IsVisible="{Binding HasDocumentError}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <!-- Task form -->
            <Border Classes="panel" Width="440" HorizontalAlignment="Right" IsVisible="{Binding IsTaskPanelOpen}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="28,24,20,8">
                        <TextBlock Text="{l:T 'Edit task'}" FontSize="20" FontWeight="Bold" />
                        <Button Grid.Column="1" Classes="icon" Command="{Binding ClosePanelCommand}" ToolTip.Tip="{l:T 'Close (Esc)'}"
                                VerticalAlignment="Top">
                            <PathIcon Data="{StaticResource IconClose}" />
                        </Button>
                    </Grid>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0"
                            Padding="28,16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Button Classes="primary" Content="{l:T 'Save changes'}" HorizontalAlignment="Stretch"
                                    Command="{Binding SaveTaskCommand}" />
                            <Button Grid.Column="1" Classes="secondary" Content="{l:T 'Cancel'}"
                                    Command="{Binding ClosePanelCommand}" />
                        </Grid>
                    </Border>

                    <ScrollViewer>
                        <StackPanel Spacing="18" Margin="28,12,28,20">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'What needs to be done'}" />
                                <TextBox Text="{Binding TaskTitle}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="fieldLabel" Text="{l:T 'Due on'}" />
                                        <Button Grid.Column="1" Classes="link" Content="{l:T 'No date'}" FontSize="12"
                                                Command="{Binding ClearTaskDueDateCommand}" Padding="0" />
                                    </Grid>
                                    <CalendarDatePicker SelectedDate="{Binding TaskDueDate}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{l:T 'Who does it'}" />
                                    <ComboBox ItemsSource="{Binding PersonOptions}" SelectedItem="{Binding TaskPerson}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Notes'}" />
                                <TextBox Text="{Binding TaskNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                                         PlaceholderText="{l:T 'Details, links, phone numbers…'}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Repeats'}" />
                                <ComboBox ItemsSource="{Binding TaskRepeatNames}" SelectedIndex="{Binding TaskRepeatIndex}" />
                                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                           Text="{l:T 'When you tick a repeating task, the next one is added with its new due date.'}" />
                            </StackPanel>

                            <CheckBox IsChecked="{Binding TaskIsDone}" Content="{l:T 'Done'}" />

                            <TextBlock Classes="error" Text="{Binding TaskError}" IsVisible="{Binding HasTaskError}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <!-- Pension statement form -->
            <Border Classes="panel" Width="460" HorizontalAlignment="Right" IsVisible="{Binding IsStatementPanelOpen}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="28,24,20,8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding StatementFormTitle}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Classes="muted" FontSize="13" Text="{Binding StatementLetterName}"
                                       TextTrimming="CharacterEllipsis" IsVisible="{Binding HasStatementLetter}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon" Command="{Binding ClosePanelCommand}" ToolTip.Tip="{l:T 'Close (Esc)'}"
                                VerticalAlignment="Top">
                            <PathIcon Data="{StaticResource IconClose}" />
                        </Button>
                    </Grid>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0"
                            Padding="28,16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Button Classes="primary" Content="{l:T 'Save statement'}" HorizontalAlignment="Stretch"
                                    Command="{Binding SaveStatementCommand}" />
                            <Button Grid.Column="1" Classes="secondary" Content="{l:T 'Cancel'}"
                                    Command="{Binding ClosePanelCommand}" />
                        </Grid>
                    </Border>

                    <ScrollViewer>
                        <StackPanel Spacing="18" Margin="28,12,28,20">
                            <StackPanel Spacing="8" IsVisible="{Binding HasStatementAiStatus}">
                                <ProgressBar Classes="thin" IsIndeterminate="True" IsVisible="{Binding IsStatementAiBusy}" />
                                <TextBlock Classes="muted" Text="{Binding StatementAiStatus}" TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding CanChooseStatementAccount}">
                                <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="{l:T 'Attach the letter to file it in Documents. With local AI on, the figures are read from it.'}" />
                                <Button Grid.Column="1" Classes="secondary" Click="AttachStatementLetter_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconImport}" />
                                        <TextBlock Text="{l:T 'Attach letter'}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Account'}" />
                                <ComboBox ItemsSource="{Binding StatementAccountOptions}" SelectedItem="{Binding StatementAccount}"
                                          IsEnabled="{Binding CanChooseStatementAccount}" />
                            </StackPanel>

                            <Border Background="{DynamicResource SurfaceSunken}" CornerRadius="10" Padding="14"
                                    IsVisible="{Binding IsNewStatementAccount}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="{l:T 'Pension fund, bank or insurer'}" />
                                        <TextBox Text="{Binding NewPensionAccountName}"
                                                 PlaceholderText="{l:T 'e.g. Pensionskasse Basel-Stadt'}" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="3*,2*" ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="fieldLabel" Text="{l:T 'Type'}" />
                                            <ComboBox ItemsSource="{Binding PillarNames}" SelectedIndex="{Binding NewPensionPillarIndex}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Classes="fieldLabel" Text="{l:T 'Person'}" />
                                            <ComboBox ItemsSource="{Binding PersonOptions}" SelectedItem="{Binding NewPensionPerson}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Figures as of'}" />
                                <CalendarDatePicker SelectedDate="{Binding StatementDate}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding StatementShowsBalance}">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{Binding StatementBalanceLabel}" />
                                    <NumericUpDown Value="{Binding StatementBalance}" Minimum="0" FormatString="N2"
                                                   PlaceholderText="0.00" ShowButtonSpinner="False" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{l:T 'Paid in that year (optional)'}" />
                                    <NumericUpDown Value="{Binding StatementPaidIn}" Minimum="0" FormatString="N2"
                                                   PlaceholderText="0.00" ShowButtonSpinner="False" />
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource SurfaceSunken}" CornerRadius="10" Padding="14"
                                    IsVisible="{Binding StatementShowsPension}">
                                <StackPanel Spacing="12">
                                    <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                                               Text="{l:T 'Projections at 65, as shown in the letter'}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <StackPanel Spacing="4" IsVisible="{Binding StatementShowsPensionFund}">
                                            <TextBlock Classes="fieldLabel" Text="{l:T 'Savings at 65'}" />
                                            <NumericUpDown Value="{Binding StatementProjectedCapital}" Minimum="0" FormatString="N2"
                                                           PlaceholderText="0.00" ShowButtonSpinner="False" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Classes="fieldLabel" Text="{l:T 'Pension per year'}" />
                                            <NumericUpDown Value="{Binding StatementProjectedPension}" Minimum="0" FormatString="N2"
                                                           PlaceholderText="0.00" ShowButtonSpinner="False" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="4" IsVisible="{Binding StatementShowsPensionFund}">
                                        <TextBlock Classes="fieldLabel" Text="{l:T 'Possible buy-in (optional)'}" />
                                        <NumericUpDown Value="{Binding StatementBuyIn}" Minimum="0" FormatString="N2"
                                                       PlaceholderText="0.00" ShowButtonSpinner="False" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Classes="error" Text="{Binding StatementError}" IsVisible="{Binding HasStatementError}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Pension account form -->
            <Border Classes="panel" Width="460" HorizontalAlignment="Right" IsVisible="{Binding IsPensionAccountPanelOpen}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="28,24,20,8">
                        <TextBlock Text="{l:T 'Edit account'}" FontSize="20" FontWeight="Bold" />
                        <Button Grid.Column="1" Classes="icon" Command="{Binding ClosePanelCommand}" ToolTip.Tip="{l:T 'Close (Esc)'}"
                                VerticalAlignment="Top">
                            <PathIcon Data="{StaticResource IconClose}" />
                        </Button>
                    </Grid>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0"
                            Padding="28,16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Button Classes="primary" Content="{l:T 'Save changes'}" HorizontalAlignment="Stretch"
                                    Command="{Binding SavePensionAccountCommand}" />
                            <Button Grid.Column="1" Classes="secondary" Content="{l:T 'Cancel'}"
                                    Command="{Binding ClosePanelCommand}" />
                        </Grid>
                    </Border>

                    <ScrollViewer>
                        <StackPanel Spacing="18" Margin="28,12,28,20">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Pension fund, bank or insurer'}" />
                                <TextBox Text="{Binding PensionAccountName}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="3*,2*" ColumnSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{l:T 'Type'}" />
                                    <ComboBox ItemsSource="{Binding PillarNames}" SelectedIndex="{Binding PensionPillarIndex}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="fieldLabel" Text="{l:T 'Person'}" />
                                    <ComboBox ItemsSource="{Binding PersonOptions}" SelectedItem="{Binding PensionAccountPerson}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="fieldLabel" Text="{l:T 'Notes'}" />
                                <TextBox Text="{Binding PensionAccountNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                         PlaceholderText="{l:T 'e.g. insurance number, contact person'}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="fieldLabel" Text="{l:T 'Statements'}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="link" FontSize="12" Padding="0" Content="{l:T 'Add statement'}"
                                            Command="{Binding AddStatementToCommand}" CommandParameter="{Binding EditingPensionAccount}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding StatementHistory}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PensionStatementRow">
                                            <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid ColumnDefinitions="104,*,Auto,34,34,34" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding DateText}" VerticalAlignment="Center" FontSize="13" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ChangeText}" FontSize="12"
                                                               VerticalAlignment="Center" Classes="positive"
                                                               Classes.negative="{Binding IsChangeNegative}" MinWidth="70"
                                                               TextAlignment="Right" />
                                                    <Button Grid.Column="3" Classes="icon" ToolTip.Tip="{l:T 'Open letter'}"
                                                            IsVisible="{Binding HasLetter}"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenStatementLetterCommand}"
                                                            CommandParameter="{Binding Statement}">
                                                        <PathIcon Data="{StaticResource IconOpen}" />
                                                    </Button>
                                                    <Button Grid.Column="4" Classes="icon" ToolTip.Tip="{l:T 'Edit'}"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).EditStatementCommand}"
                                                            CommandParameter="{Binding Statement}">
                                                        <PathIcon Data="{StaticResource IconEdit}" />
                                                    </Button>
                                                    <Button Grid.Column="5" Classes="icon danger" ToolTip.Tip="{l:T 'Delete'}"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteStatementCommand}"
                                                            CommandParameter="{Binding Statement}">
                                                        <PathIcon Data="{StaticResource IconDelete}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Classes="error" Text="{Binding PensionAccountError}" IsVisible="{Binding HasPensionAccountError}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <!-- Bulk document import -->
            <Border Classes="panel" Width="640" HorizontalAlignment="Right" IsVisible="{Binding IsBulkPanelOpen}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="28,24,20,8">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding BulkTitle}" FontSize="20" FontWeight="Bold" />
                            <ProgressBar Classes="thin" Minimum="0" Maximum="100" Value="{Binding BulkProgress}"
                                         IsVisible="{Binding IsBulkBusy}" />
                            <TextBlock Classes="muted" FontSize="13" Text="{Binding BulkStatusText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon" Command="{Binding ClosePanelCommand}" ToolTip.Tip="{l:T 'Close (Esc)'}"
                                VerticalAlignment="Top">
                            <PathIcon Data="{StaticResource IconClose}" />
                        </Button>
                    </Grid>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0"
                            Padding="28,16">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="error" Text="{Binding BulkError}" IsVisible="{Binding HasBulkError}" />
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <Button Classes="primary" Content="{Binding BulkSaveText}" HorizontalAlignment="Stretch"
                                        Command="{Binding SaveBulkCommand}" IsEnabled="{Binding CanSaveBulk}" />
                                <Button Grid.Column="1" Classes="secondary" Click="AddDocument_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconPlus}" />
                                        <TextBlock Text="{l:T 'Add files'}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Classes="secondary" Content="{l:T 'Cancel'}"
                                        Command="{Binding ClosePanelCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding BulkItems}" Margin="28,8,34,20">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BulkDocumentItem">
                                    <Border Background="{DynamicResource SurfaceSunken}" CornerRadius="10" Padding="14,12">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <CheckBox IsChecked="{Binding IsSelected}" MinWidth="0" Padding="0"
                                                          ToolTip.Tip="{l:T 'Save this file'}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourcePath}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasStatus}">
                                                        <ProgressBar Classes="thin" IsIndeterminate="True" Width="60"
                                                                     VerticalAlignment="Center" IsVisible="{Binding IsReading}" />
                                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding StatusText}"
                                                                   TextWrapping="Wrap" Classes.negative="{Binding IsFailed}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="icon" ToolTip.Tip="{l:T 'Remove from the list'}"
                                                        VerticalAlignment="Top"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveBulkItemCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="{StaticResource IconClose}" />
                                                </Button>
                                            </Grid>

                                            <Border Background="{DynamicResource WarningSoft}" CornerRadius="8" Padding="10,8"
                                                    IsVisible="{Binding HasDuplicate}">
                                                <TextBlock Text="{Binding DuplicateText}" TextWrapping="Wrap" FontSize="12" FontWeight="Medium" />
                                            </Border>

                                            <StackPanel Spacing="10" IsEnabled="{Binding IsEditable}">
                                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="fieldLabel" Text="{l:T 'Type'}" />
                                                        <ComboBox SelectedIndex="{Binding KindIndex}"
                                                                  ItemsSource="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DocumentKindNames}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock Classes="fieldLabel" Text="{l:T 'Person'}" />
                                                        <ComboBox SelectedItem="{Binding Person}"
                                                                  ItemsSource="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PersonOptions}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="4">
                                                        <TextBlock Classes="fieldLabel" Text="{l:T 'Document date'}" />
                                                        <CalendarDatePicker SelectedDate="{Binding Date}" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid ColumnDefinitions="2*,*" ColumnSpacing="10">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Classes="fieldLabel" Text="{l:T 'Title'}" />
                                                        <TextBox Text="{Binding Title}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock Classes="fieldLabel" Text="{l:T 'From'}" />
                                                        <TextBox Text="{Binding Sender}" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Spacing="8" IsVisible="{Binding IsPayable}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasPaymentDetails}">
                                                        <PathIcon Data="{StaticResource IconQr}" Width="13" Height="13" Foreground="{DynamicResource Brand}" />
                                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding PaymentIban}" FontFamily="Menlo, monospace" />
                                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding PaymentReference}" FontFamily="Menlo, monospace" />
                                                    </StackPanel>
                                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Classes="fieldLabel" Text="{l:T 'Amount to pay'}" />
                                                            <NumericUpDown Value="{Binding Amount}" Minimum="0" FormatString="N2"
                                                                           PlaceholderText="0.00" ShowButtonSpinner="False" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBlock Classes="fieldLabel" Text="{l:T 'Due on'}" />
                                                            <CalendarDatePicker SelectedDate="{Binding DueDate}" />
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsPaid}" Content="{l:T 'Already paid'}"
                                                                  VerticalAlignment="Bottom" Margin="0,0,0,6" />
                                                    </Grid>
                                                    <CheckBox IsChecked="{Binding CreateEntry}" IsVisible="{Binding CanCreateEntry}"
                                                              Content="{l:T 'Add to expenses on the due date, so your runway includes it'}" />
                                                </StackPanel>
                                                <CheckBox IsChecked="{Binding AddFollowUp}" IsVisible="{Binding HasFollowUp}">
                                                    <TextBlock Text="{Binding FollowUpText}" TextWrapping="Wrap" />
                                                </CheckBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <!-- Insurance and account forms -->
        <Panel Grid.ColumnSpan="2" IsVisible="{Binding IsPanelOpen}" IsHitTestVisible="{Binding IsPanelOpen}">
            <Border Classes="panel" Width="460" HorizontalAlignment="Right" IsVisible="{Binding IsInsurancePanelOpen}">
                <pages:InsurancePanel />
            </Border>
            <Border Classes="panel" Width="440" HorizontalAlignment="Right" IsVisible="{Binding IsAccountPanelOpen}">
                <pages:AccountPanel />
            </Border>
            <pages:DeadlinePanels />
            <Border Classes="panel" Width="440" HorizontalAlignment="Right" IsVisible="{Binding IsAppointmentPanelOpen}">
                <pages:AppointmentPanel />
            </Border>
            <Border Classes="panel" Width="440" HorizontalAlignment="Right" IsVisible="{Binding IsGoalPanelOpen}">
                <pages:GoalPanel />
            </Border>
            <Border Classes="panel" Width="440" HorizontalAlignment="Right" IsVisible="{Binding IsAssetPanelOpen}">
                <pages:AssetPanel />
            </Border>
            <pages:HouseholdPanels />
        </Panel>

        <!-- While a document is dragged: drop it on a person to make it theirs (its file moves to their folder). -->
        <Border Grid.Column="1" IsVisible="{Binding IsDraggingDocument}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24" Padding="14,10" CornerRadius="12" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Hairline}" BorderThickness="1" BoxShadow="0 6 24 0 #33000000">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="secondary" Text="{l:T 'Drop on a person to make it theirs:'}" VerticalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding PersonOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PersonOption">
                            <Border Background="{DynamicResource SurfaceSunken}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                                    CornerRadius="16" Padding="14,6" controls:Drag.Target="person" controls:Drag.TargetItem="{Binding}">
                                <TextBlock Text="{Binding}" FontWeight="Medium" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Short message with Undo after deleting, or where an export was saved. -->
        <Border Grid.Column="1" IsVisible="{Binding HasNotice}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24" Padding="18,10,10,10" CornerRadius="10" MaxWidth="680"
                Background="{DynamicResource TextPrimary}" BoxShadow="0 6 24 0 #33000000">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock Text="{Binding NoticeText}" Foreground="{DynamicResource Surface}" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                <Button Content="{l:T 'Undo'}" Command="{Binding UndoCommand}" IsVisible="{Binding CanUndo}"
                        Foreground="{DynamicResource Brand}" Background="Transparent" FontWeight="SemiBold" Padding="8,4" />
                <Button Classes="icon" Command="{Binding DismissNoticeCommand}" ToolTip.Tip="{l:T 'Close'}"
                        Foreground="{DynamicResource Surface}">
                    <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Shown while a file is dragged over the window. -->
        <Border x:Name="DropOverlay" Grid.ColumnSpan="2" IsVisible="False" IsHitTestVisible="False"
                Background="{DynamicResource Backdrop}" Padding="40">
            <Border Background="{DynamicResource BrandSoft}" CornerRadius="20" BorderThickness="2"
                    BorderBrush="{DynamicResource Brand}" Opacity="0.96">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <PathIcon Data="{StaticResource IconImport}" Width="44" Height="44"
                              Foreground="{DynamicResource Brand}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding DropHint}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Classes="muted" HorizontalAlignment="Center"
                               Text="{Binding DropDetailText}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>

    <!-- ═══════════════ Lock screen ═══════════════ -->
    <Border Background="{DynamicResource AppBackground}" IsVisible="{Binding IsLocked}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="320">
            <Image Source="/Assets/keystone.png" Width="96" Height="96" HorizontalAlignment="Center" />
            <TextBlock Text="{l:T 'Keystone is locked'}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center"
                       Text="{l:T 'Unlock with Touch ID or your Mac password.'}" />
            <Button Classes="primary" HorizontalAlignment="Center" Command="{Binding UnlockCommand}" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconLock}" />
                    <TextBlock Text="{l:T 'Unlock'}" />
                </StackPanel>
            </Button>
            <TextBlock Classes="error" Text="{Binding LockMessage}" HorizontalAlignment="Center" TextAlignment="Center" />
        </StackPanel>
    </Border>
    </Panel>
</Window>

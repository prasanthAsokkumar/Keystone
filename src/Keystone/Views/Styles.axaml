<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
    </Styles.Resources>

    <!-- ── Surfaces ───────────────────────────────────────────────────────── -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style Selector="Border.divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Hairline}" />
    </Style>

    <!-- Rounded tinted square behind an icon. -->
    <Style Selector="Border.iconTile">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource BrandSoft}" />
    </Style>
    <Style Selector="Border.iconTile > PathIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource BrandText}" />
    </Style>
    <!-- Overview: something overdue or close gets a red tile, the rest a calm grey one. -->
    <Style Selector="Border.iconTile.urgent">
        <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
    </Style>
    <Style Selector="Border.iconTile.urgent > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Negative}" />
    </Style>
    <Style Selector="Border.iconTile.calm">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
    </Style>
    <Style Selector="Border.iconTile.calm > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="Border.tile">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource HoverFill}" />
    </Style>
    <Style Selector="Border.pill > TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="Border.pill.brand">
        <Setter Property="Background" Value="{DynamicResource BrandSoft}" />
    </Style>
    <Style Selector="Border.pill.brand > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrandText}" />
    </Style>

    <!-- ── Text ───────────────────────────────────────────────────────────── -->

    <Style Selector="TextBlock.pageTitle">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="-0.4" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.value">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="-0.4" />
    </Style>
    <Style Selector="TextBlock.heroValue">
        <Setter Property="FontSize" Value="52" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="-1.2" />
    </Style>
    <Style Selector="TextBlock.positive">
        <Setter Property="Foreground" Value="{DynamicResource Positive}" />
    </Style>
    <Style Selector="TextBlock.negative">
        <Setter Property="Foreground" Value="{DynamicResource Negative}" />
    </Style>
    <Style Selector="TextBlock.warning">
        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
    </Style>
    <!-- A finished task. -->
    <Style Selector="TextBlock.done">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{DynamicResource Negative}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="TextBlock.columnHeader">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <!-- Column titles that sort their list when clicked -->
    <Style Selector="Button.sortHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.sortHeader:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.sortHeader:pointerover TextBlock.columnHeader">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.sortHeader:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ── Overview week strip ─────────────────────────────────────────────── -->
    <Style Selector="Border.weekDay">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
    </Style>
    <Style Selector="Border.weekDay.today">
        <Setter Property="Background" Value="{DynamicResource BrandSoft}" />
    </Style>
    <Style Selector="Ellipse.weekDot">
        <Setter Property="Fill" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Ellipse.weekDot.money">
        <Setter Property="Fill" Value="{DynamicResource Brand}" />
    </Style>
    <Style Selector="Ellipse.weekDot.appointment">
        <Setter Property="Fill" Value="#3B82F6" />
    </Style>
    <Style Selector="Ellipse.weekDot.task">
        <Setter Property="Fill" Value="#8B5CF6" />
    </Style>
    <Style Selector="Ellipse.weekDot.deadline">
        <Setter Property="Fill" Value="{DynamicResource Warning}" />
    </Style>
    <Style Selector="Ellipse.weekDot.health">
        <Setter Property="Fill" Value="{DynamicResource Negative}" />
    </Style>

    <!-- ── Sidebar navigation ─────────────────────────────────────────────── -->

    <Style Selector="RadioButton.nav">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Background" Background="Transparent" CornerRadius="9" Padding="12,9">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource HoverFill}" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource BrandSoft}" />
    </Style>
    <Style Selector="RadioButton.nav:checked">
        <Setter Property="Foreground" Value="{DynamicResource BrandText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.navHeading">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Margin" Value="12,14,0,4" />
    </Style>
    <Style Selector="RadioButton.nav PathIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
    </Style>

    <!-- Segmented choice (Expense / Income, One-time / Monthly). -->
    <!-- Where a dragged row can be dropped, while it is over it -->
    <Style Selector="RadioButton.nav.dropHover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource BrandSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="RadioButton.segment.dropHover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource BrandSoft}" />
    </Style>
    <Style Selector="Grid.dropHover">
        <Setter Property="Background" Value="{DynamicResource BrandSoft}" />
    </Style>
    <Style Selector="Border.dropHover">
        <Setter Property="Background" Value="{DynamicResource BrandSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brand}" />
    </Style>

    <Style Selector="RadioButton.segment">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Background" Background="Transparent" CornerRadius="7" Padding="10,7">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BoxShadow" Value="0 1 3 0 #22000000" />
    </Style>
    <Style Selector="RadioButton.segment:checked">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.segments">
        <Setter Property="Background" Value="{DynamicResource HoverFill}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <!-- ── Buttons ────────────────────────────────────────────────────────── -->

    <Style Selector="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource Brand}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandText}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandText}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary PathIcon">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
    </Style>
    <Style Selector="Button.secondary PathIcon">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverFill}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.icon.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource Negative}" />
    </Style>
    <Style Selector="Button.icon PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource BrandText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brand}" />
    </Style>

    <!-- ── Inputs ─────────────────────────────────────────────────────────── -->

    <Style Selector="TextBox, NumericUpDown, ComboBox, CalendarDatePicker">
        <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="ComboBox, CalendarDatePicker">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- ── Table rows ─────────────────────────────────────────────────────── -->

    <Style Selector="ListBox.table">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.table ListBoxItem">
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="ListBox.table ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverFill}" />
    </Style>
    <Style Selector="ListBox.table ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverFill}" />
    </Style>
    <Style Selector="ListBox.table ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverFill}" />
    </Style>

    <!-- ── Search results ─────────────────────────────────────────────────── -->

    <Style Selector="Button.searchResult">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.searchResult:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverFill}" />
    </Style>

    <!-- ── Notes ──────────────────────────────────────────────────────────── -->

    <Style Selector="ListBox.notes">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.notes ListBoxItem">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="ListBox.notes ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverFill}" />
    </Style>
    <Style Selector="ListBox.notes ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandSoft}" />
    </Style>
    <Style Selector="ListBox.notes ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandSoft}" />
    </Style>

    <!-- A text box without a frame, for writing in the note editor. -->
    <Style Selector="TextBox.bare">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.icon.active PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource Brand}" />
    </Style>

    <!-- ── Runway status ──────────────────────────────────────────────────── -->

    <Style Selector="ProgressBar.runway">
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Background" Value="{DynamicResource HoverFill}" />
        <Setter Property="Foreground" Value="{DynamicResource Brand}" />
    </Style>
    <Style Selector="ProgressBar.thin">
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource HoverFill}" />
        <Setter Property="Foreground" Value="{DynamicResource Brand}" />
    </Style>

    <Style Selector="Border.hero.critical Border.pill">
        <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
    </Style>
    <Style Selector="Border.hero.critical Border.pill > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Negative}" />
    </Style>
    <Style Selector="Border.hero.critical TextBlock.heroValue">
        <Setter Property="Foreground" Value="{DynamicResource Negative}" />
    </Style>
    <Style Selector="Border.hero.critical ProgressBar.runway">
        <Setter Property="Foreground" Value="{DynamicResource Negative}" />
    </Style>

    <Style Selector="Border.hero.warning Border.pill">
        <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
    </Style>
    <Style Selector="Border.hero.warning Border.pill > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
    </Style>
    <Style Selector="Border.hero.warning TextBlock.heroValue">
        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
    </Style>
    <Style Selector="Border.hero.warning ProgressBar.runway">
        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
    </Style>

    <Style Selector="Border.hero.healthy Border.pill">
        <Setter Property="Background" Value="{DynamicResource BrandSoft}" />
    </Style>
    <Style Selector="Border.hero.healthy Border.pill > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrandText}" />
    </Style>
    <Style Selector="Border.hero.healthy TextBlock.heroValue">
        <Setter Property="Foreground" Value="{DynamicResource BrandText}" />
    </Style>

    <!-- ── Side panel ─────────────────────────────────────────────────────── -->

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="BoxShadow" Value="-12 0 32 0 #26000000" />
    </Style>
</Styles>

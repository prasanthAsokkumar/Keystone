<Application xmlns:l="using:Keystone.Localization"
        xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Keystone.App"
             Name="Keystone"
             xmlns:local="using:Keystone"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!-- Replaces the default macOS app menu, which would otherwise offer "About Avalonia". -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="{l:T 'About Keystone'}" Click="About_Click" />
        </NativeMenu>
    </NativeMenu.Menu>

    <!-- Design tokens. Views use these through DynamicResource so light and dark mode both work. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackground" Color="#F5F6F8" />
                    <SolidColorBrush x:Key="SidebarBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceSunken" Color="#F7F8FA" />
                    <SolidColorBrush x:Key="Hairline" Color="#E7E9EE" />
                    <SolidColorBrush x:Key="HoverFill" Color="#F2F4F7" />
                    <SolidColorBrush x:Key="TextPrimary" Color="#101828" />
                    <SolidColorBrush x:Key="TextSecondary" Color="#475467" />
                    <SolidColorBrush x:Key="TextMuted" Color="#8A94A6" />
                    <SolidColorBrush x:Key="Brand" Color="#059669" />
                    <SolidColorBrush x:Key="BrandSoft" Color="#E8F7F1" />
                    <SolidColorBrush x:Key="BrandText" Color="#047857" />
                    <SolidColorBrush x:Key="Positive" Color="#079455" />
                    <SolidColorBrush x:Key="Negative" Color="#D92D20" />
                    <SolidColorBrush x:Key="DangerSoft" Color="#FEF0EF" />
                    <SolidColorBrush x:Key="Warning" Color="#DC6803" />
                    <SolidColorBrush x:Key="WarningSoft" Color="#FFF6E8" />
                    <SolidColorBrush x:Key="Backdrop" Color="#5C101828" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackground" Color="#0E1014" />
                    <SolidColorBrush x:Key="SidebarBackground" Color="#121419" />
                    <SolidColorBrush x:Key="Surface" Color="#171A20" />
                    <SolidColorBrush x:Key="SurfaceSunken" Color="#1C2027" />
                    <SolidColorBrush x:Key="Hairline" Color="#262B33" />
                    <SolidColorBrush x:Key="HoverFill" Color="#20242C" />
                    <SolidColorBrush x:Key="TextPrimary" Color="#F2F4F7" />
                    <SolidColorBrush x:Key="TextSecondary" Color="#B4BCC8" />
                    <SolidColorBrush x:Key="TextMuted" Color="#7D8696" />
                    <SolidColorBrush x:Key="Brand" Color="#10B981" />
                    <SolidColorBrush x:Key="BrandSoft" Color="#163A2E" />
                    <SolidColorBrush x:Key="BrandText" Color="#34D399" />
                    <SolidColorBrush x:Key="Positive" Color="#34D399" />
                    <SolidColorBrush x:Key="Negative" Color="#F97066" />
                    <SolidColorBrush x:Key="DangerSoft" Color="#3A1D1B" />
                    <SolidColorBrush x:Key="Warning" Color="#FDB022" />
                    <SolidColorBrush x:Key="WarningSoft" Color="#3A2C14" />
                    <SolidColorBrush x:Key="Backdrop" Color="#99000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

